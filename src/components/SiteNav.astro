---
const normalizePath = (pathname: string) => pathname === '/' ? '/' : pathname.replace(/\/+$/, '');
const currentPath = normalizePath(Astro.url.pathname);
---

<header class="site-nav" transition:persist="site-nav">
  <nav aria-label="Primary navigation">
    <a class="site-nav-brand" href="/" aria-label="Rio Espinosa home">
      <span class="site-nav-time">
        <time data-rio-time>--:--</time>
      </span>
    </a>
    <div class="site-nav-links" data-dock>
      <a data-dock-item data-section-link="home" href="/#home" aria-label="Home" aria-current={currentPath === '/' ? 'location' : undefined}><i class="site-nav-icon ph-bold ph-house" aria-hidden="true"></i></a>
      <a data-dock-item data-section-link="projects" href="/#projects" aria-label="Projects" aria-current={currentPath === '/projects' ? 'page' : undefined}><i class="site-nav-icon ph-bold ph-folder-open" aria-hidden="true"></i></a>
      <a data-dock-item data-section-link="experience" href="/#experience" aria-label="Experience" aria-current={currentPath === '/experience' ? 'page' : undefined}><i class="site-nav-icon ph-bold ph-briefcase" aria-hidden="true"></i></a>
      <a data-dock-item href="/ESPINOSA_RESUME.pdf" target="_blank" rel="noreferrer" aria-label="Resume, opens PDF"><i class="site-nav-icon ph-bold ph-file-text" aria-hidden="true"></i></a>
    </div>
    <div class="site-nav-contact">
      <button class="site-nav-domain" type="button">rioespinosa.com</button>
      <div class="site-nav-contact-popout" aria-label="Email actions">
        <div class="site-nav-contact-panel">
          <button type="button" data-copy-email><i class="ph-bold ph-copy" aria-hidden="true"></i><span>Copy email</span></button>
          <a href="mailto:contact@rioespinosa.com"><i class="ph-bold ph-envelope-simple" aria-hidden="true"></i><span>Email me</span></a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { ScrollToPlugin } from 'gsap/ScrollToPlugin';

  gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

  const rioTime = document.querySelector<HTMLTimeElement>('[data-rio-time]');
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  const dockItems = dock ? Array.from(dock.querySelectorAll<HTMLElement>('[data-dock-item]')) : [];
  const siteNav = document.querySelector<HTMLElement>('.site-nav');
  let navVisibilityTrigger: ScrollTrigger | undefined;
  let navIsVisible = true;

  const setNavigationVisibility = (visible: boolean, immediate = false) => {
    if (!siteNav || (navIsVisible === visible && !immediate)) return;
    navIsVisible = visible;
    const hiddenOffset = window.matchMedia('(max-width: 680px)').matches ? '140%' : '-140%';
    gsap.to(siteNav, {
      '--nav-hide-y': visible ? '0%' : hiddenOffset,
      autoAlpha: visible ? 1 : 0,
      pointerEvents: visible ? 'auto' : 'none',
      duration: immediate ? 0 : 0.28,
      ease: visible ? 'power2.out' : 'power2.in',
      overwrite: true,
    });
  };

  const initializeNavVisibility = () => {
    navVisibilityTrigger?.kill();
    ScrollTrigger.getById('site-nav-visibility')?.kill();
    navVisibilityTrigger = undefined;
    navIsVisible = true;

    if (!siteNav) return;
    gsap.set(siteNav, { clearProps: 'transform' });
    gsap.set(siteNav, { '--nav-hide-y': '0%', autoAlpha: 1, pointerEvents: 'auto' });
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    navVisibilityTrigger = ScrollTrigger.create({
      id: 'site-nav-visibility',
      start: 0,
      end: 'max',
      onUpdate: (self) => setNavigationVisibility(self.scroll() <= 20 || self.direction < 0),
      onLeaveBack: () => setNavigationVisibility(true),
      onRefresh: (self) => {
        if (self.scroll() <= 20) setNavigationVisibility(true, true);
        else setNavigationVisibility(navIsVisible, true);
      },
    });
  };

  const phTimeFormatter = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Asia/Manila',
    hour: 'numeric',
    minute: '2-digit',
    hour12: true,
  });
  const updateTimes = () => {
    const now = new Date();
    const isoTime = now.toISOString();

    if (rioTime) {
      rioTime.textContent = phTimeFormatter.format(now);
      rioTime.dateTime = isoTime;
    }
  };

  updateTimes();
  window.setInterval(updateTimes, 30_000);

  if (dock && dockItems.length) {
    const media = gsap.matchMedia();

    media.add('(min-width: 681px) and (prefers-reduced-motion: no-preference)', () => {
      const reset = () => gsap.to(dockItems, { scale: 1, z: 0, duration: 0.28, ease: 'power3.out', overwrite: 'auto' });
      const updateDock = (event: PointerEvent) => {
        dockItems.forEach((item) => {
          const bounds = item.getBoundingClientRect();
          const distance = Math.abs(event.clientX - (bounds.left + bounds.width / 2));
          const proximity = Math.max(0, 1 - distance / 105);

          gsap.to(item, {
            scale: 1 + proximity * 0.42,
            z: proximity * 48,
            duration: 0.18,
            ease: 'power3.out',
            overwrite: 'auto',
          });
        });
      };

      dock.addEventListener('pointermove', updateDock);
      dock.addEventListener('pointerleave', reset);

      return () => {
        dock.removeEventListener('pointermove', updateDock);
        dock.removeEventListener('pointerleave', reset);
        gsap.set(dockItems, { clearProps: 'transform' });
      };
    });
  }

  const internalLinks = document.querySelectorAll<HTMLAnchorElement>('[data-dock-item][href^="/"]');
  const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-section-link]'));
  let sectionScrollTriggers: ScrollTrigger[] = [];

  const setCurrentSection = (sectionName: string) => {
    sectionLinks.forEach((link) => {
      if (link.dataset.sectionLink === sectionName) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };

  const updateCurrentLink = () => {
    const currentPath = window.location.pathname === '/' ? '/' : window.location.pathname.replace(/\/+$/, '');
    if (currentPath === '/') {
      setCurrentSection(window.location.hash.slice(1) || 'home');
      return;
    }

    setCurrentSection(currentPath.slice(1));
  };

  const initializeSectionNavigation = () => {
    sectionScrollTriggers.forEach((trigger) => trigger.kill());
    sectionScrollTriggers = [];
    updateCurrentLink();

    if (window.location.pathname !== '/') return;

    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-scroll-section]'));
    sections.forEach((section) => {
      const sectionName = section.dataset.scrollSection;
      if (!sectionName) return;

      sectionScrollTriggers.push(ScrollTrigger.create({
        trigger: section,
        start: 'top 55%',
        end: 'bottom 55%',
        onEnter: () => setCurrentSection(sectionName),
        onEnterBack: () => setCurrentSection(sectionName),
      }));
    });

    ScrollTrigger.refresh();
  };

  document.addEventListener('astro:after-swap', initializeSectionNavigation);
  document.addEventListener('astro:page-load', initializeSectionNavigation);
  document.addEventListener('astro:after-swap', initializeNavVisibility);
  document.addEventListener('astro:page-load', initializeNavVisibility);
  initializeSectionNavigation();
  initializeNavVisibility();

  internalLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      if (
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) return;

      if (link.pathname !== window.location.pathname || !link.hash) return;

      const section = document.querySelector<HTMLElement>(link.hash);
      if (!section) return;

      event.preventDefault();
      event.stopPropagation();
      window.history.pushState({}, '', link.hash);
      const sectionStart = window.scrollY + section.getBoundingClientRect().top;
      const targetTop = link.hash === '#home' ? 0 : Math.max(0, sectionStart - 84);
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      gsap.killTweensOf(window);
      if (reducedMotion) {
        gsap.set(window, { scrollTo: { y: targetTop } });
      } else {
        gsap.to(window, { scrollTo: { y: targetTop, autoKill: false }, duration: 0.7, ease: 'power2.inOut' });
      }
      ScrollTrigger.update();
      setCurrentSection(link.dataset.sectionLink ?? link.hash.slice(1));
      setNavigationVisibility(true);
    });
  });
</script>
