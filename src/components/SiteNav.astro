<header class="site-nav" transition:persist="site-nav">
  <nav aria-label="Primary navigation">
    <a class="site-nav-brand" href="/" aria-label="Rio Espinosa home"><span class="site-nav-monogram"><img src="/images/pic.jpg" alt="Rio Espinosa" /></span><span>Rio Espinosa</span><span class="site-nav-photo-popout" aria-hidden="true"><img src="/images/pic.jpg" alt="" /></span></a>
    <div class="site-nav-links" data-dock>
      <a data-dock-item href="/">Home</a>
      <a data-dock-item href="/experience/">Experience</a>
      <a data-dock-item href="/projects/">Projects</a>
      <a data-dock-item href="/stack/">Stack</a>
      <a data-dock-item href="https://www.programmingrio.top/resume.pdf" target="_blank" rel="noreferrer">Resume <i class="ph-duotone ph-arrow-square-out" aria-hidden="true"></i></a>
    </div>
    <div class="site-nav-contact">
      <button class="site-nav-action" type="button" aria-expanded="false">programmingrio@gmail.com</button>
      <div class="site-nav-contact-popout" aria-label="Email actions">
        <div class="site-nav-contact-panel">
          <button type="button" data-copy-email><i class="ph-duotone ph-copy" aria-hidden="true"></i><span>Copy email</span></button>
          <a href="mailto:programmingrio@gmail.com"><i class="ph-duotone ph-envelope-simple" aria-hidden="true"></i><span>Email me</span></a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  import { gsap } from 'gsap';
  import { navigate } from 'astro:transitions/client';

  const dock = document.querySelector<HTMLElement>('[data-dock]');
  const dockItems = dock ? Array.from(dock.querySelectorAll<HTMLElement>('[data-dock-item]')) : [];

  if (dock && dockItems.length) {
    const media = gsap.matchMedia();

    media.add('(min-width: 681px) and (prefers-reduced-motion: no-preference)', () => {
      const reset = () => gsap.to(dockItems, { scale: 1, z: 0, duration: 0.28, ease: 'power3.out', overwrite: 'auto' });
      const updateDock = (event: PointerEvent) => {
        dockItems.forEach((item) => {
          const bounds = item.getBoundingClientRect();
          const distance = Math.abs(event.clientX - (bounds.left + bounds.width / 2));
          const proximity = Math.max(0, 1 - distance / 105);

          gsap.to(item, {
            scale: 1 + proximity * 0.42,
            z: proximity * 48,
            duration: 0.18,
            ease: 'power3.out',
            overwrite: 'auto',
          });
        });
      };

      dock.addEventListener('pointermove', updateDock);
      dock.addEventListener('pointerleave', reset);

      return () => {
        dock.removeEventListener('pointermove', updateDock);
        dock.removeEventListener('pointerleave', reset);
        gsap.set(dockItems, { clearProps: 'transform' });
      };
    });

    media.add('(max-width: 680px) and (prefers-reduced-motion: no-preference)', () => {
      let idleTimer: number | undefined;
      const hideNav = () => {
        window.clearTimeout(idleTimer);
        gsap.to('.site-nav', { y: -76, duration: 0.2, ease: 'power2.out', overwrite: 'auto' });
        idleTimer = window.setTimeout(() => {
          gsap.to('.site-nav', { y: 0, duration: 0.28, ease: 'power3.out', overwrite: 'auto' });
        }, 240);
      };

      window.addEventListener('scroll', hideNav, { passive: true });

      return () => {
        window.clearTimeout(idleTimer);
        window.removeEventListener('scroll', hideNav);
        gsap.set('.site-nav', { clearProps: 'transform' });
      };
    });

    media.add('(min-width: 681px) and (prefers-reduced-motion: no-preference)', () => {
      let idleTimer: number | undefined;
      const hideNav = () => {
        window.clearTimeout(idleTimer);
        gsap.to('.site-nav', { y: -76, duration: 0.2, ease: 'power2.out', overwrite: 'auto' });
        idleTimer = window.setTimeout(() => {
          gsap.to('.site-nav', { y: 0, duration: 0.28, ease: 'power3.out', overwrite: 'auto' });
        }, 240);
      };

      window.addEventListener('scroll', hideNav, { passive: true });

      return () => {
        window.clearTimeout(idleTimer);
        window.removeEventListener('scroll', hideNav);
        gsap.set('.site-nav', { clearProps: 'transform' });
      };
    });
  }

  const brand = document.querySelector<HTMLElement>('.site-nav-brand');
  const photoPopout = document.querySelector<HTMLElement>('.site-nav-photo-popout');

  if (brand && photoPopout) {
    const media = gsap.matchMedia();

    media.add('(min-width: 681px) and (prefers-reduced-motion: no-preference)', () => {
      const popPortrait = () => {
        gsap.killTweensOf(photoPopout);
        gsap.fromTo(photoPopout,
          { autoAlpha: 0, y: -10, scale: 0.78 },
          { autoAlpha: 1, y: 0, scale: 1, duration: 0.32, ease: 'back.out(1.65)', overwrite: 'auto' },
        );
      };
      const resetPortrait = () => gsap.to(photoPopout, { autoAlpha: 0, y: -7, scale: 0.9, duration: 0.18, ease: 'power2.in', overwrite: 'auto' });

      brand.addEventListener('pointerenter', popPortrait);
      brand.addEventListener('pointerleave', resetPortrait);
      brand.addEventListener('focusin', popPortrait);
      brand.addEventListener('focusout', resetPortrait);

      return () => {
        brand.removeEventListener('pointerenter', popPortrait);
        brand.removeEventListener('pointerleave', resetPortrait);
        brand.removeEventListener('focusin', popPortrait);
        brand.removeEventListener('focusout', resetPortrait);
        gsap.set(photoPopout, { clearProps: 'opacity,visibility,transform' });
      };
    });
  }

  const contact = document.querySelector<HTMLElement>('.site-nav-contact');
  const contactTrigger = contact?.querySelector<HTMLButtonElement>('.site-nav-action');
  const contactPopout = contact?.querySelector<HTMLElement>('.site-nav-contact-popout');
  const copyEmail = contact?.querySelector<HTMLButtonElement>('[data-copy-email]');

  if (contact && contactTrigger && contactPopout) {
    const media = gsap.matchMedia();

    media.add('(min-width: 681px) and (prefers-reduced-motion: no-preference)', () => {
      const showContact = () => {
        contactTrigger.setAttribute('aria-expanded', 'true');
        gsap.fromTo(contactPopout,
          { autoAlpha: 0, y: -8, scale: 0.92 },
          { autoAlpha: 1, y: 0, scale: 1, duration: 0.26, ease: 'back.out(1.5)', overwrite: 'auto' },
        );
      };
      const hideContact = () => {
        contactTrigger.setAttribute('aria-expanded', 'false');
        gsap.to(contactPopout, { autoAlpha: 0, y: -6, scale: 0.96, duration: 0.16, ease: 'power2.in', overwrite: 'auto' });
      };

      contact.addEventListener('pointerenter', showContact);
      contact.addEventListener('pointerleave', hideContact);
      contact.addEventListener('focusin', showContact);
      contact.addEventListener('focusout', hideContact);

      return () => {
        contact.removeEventListener('pointerenter', showContact);
        contact.removeEventListener('pointerleave', hideContact);
        contact.removeEventListener('focusin', showContact);
        contact.removeEventListener('focusout', hideContact);
        gsap.set(contactPopout, { clearProps: 'opacity,visibility,transform' });
      };
    });
  }

  copyEmail?.addEventListener('click', async () => {
    const email = 'programmingrio@gmail.com';
    try {
      await navigator.clipboard.writeText(email);
      const label = copyEmail.querySelector('span');
      if (label) label.textContent = 'Copied!';
      window.setTimeout(() => {
        if (label) label.textContent = 'Copy email';
      }, 1500);
    } catch {
      window.location.href = `mailto:${email}`;
    }
  });

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const internalLinks = document.querySelectorAll<HTMLAnchorElement>('[data-dock-item][href^="/"]');
  let isNavigating = false;

  document.addEventListener('astro:after-swap', () => {
    isNavigating = false;
  });

  internalLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      if (
        isNavigating ||
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) return;

      if (link.pathname === window.location.pathname) {
        if (link.pathname === '/') {
          event.preventDefault();
          window.dispatchEvent(new Event('portfolio:home-replay'));
        }
        return;
      }

      event.preventDefault();
      const page = document.querySelector<HTMLElement>('main');
      if (!page || reducedMotion.matches) {
        window.location.assign(link.href);
        return;
      }

      isNavigating = true;
      window.dispatchEvent(new Event('portfolio:navigate'));
      gsap.to(page,
        {
          y: -window.innerHeight,
          autoAlpha: 0,
          duration: 0.72,
          ease: 'power3.inOut',
          overwrite: 'auto',
          onComplete: () => {
            try {
              sessionStorage.setItem('rio-page-panel', 'true');
            } catch {}
            navigate(link.href);
          },
        },
      );
    });
  });
</script>
