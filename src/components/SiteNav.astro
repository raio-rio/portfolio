---
const normalizePath = (pathname: string) => pathname === '/' ? '/' : pathname.replace(/\/+$/, '');
const currentPath = normalizePath(Astro.url.pathname);
---

<header class="site-nav" transition:persist="site-nav">
  <nav aria-label="Primary navigation">
    <a class="site-nav-brand" href="/" aria-label="Rio Espinosa home" aria-describedby="site-nav-time-comparison">
      <span class="site-nav-time"><i class="ph-duotone ph-sun" data-ph-time-icon aria-hidden="true"></i><time data-ph-time>--:-- PHT</time></span>
      <span class="site-nav-time-popout" id="site-nav-time-comparison">
        <span class="site-nav-time-row">
          <i class="site-nav-weather-icon ph-duotone ph-sun" data-local-time-icon aria-hidden="true"></i>
          <span class="site-nav-time-copy">
            <span class="site-nav-time-label">Your local time</span>
            <time class="site-nav-time-value" data-local-time>--:--</time>
          </span>
        </span>
        <span class="site-nav-time-row">
          <i class="site-nav-weather-icon ph-duotone ph-sun" data-rio-time-icon aria-hidden="true"></i>
          <span class="site-nav-time-copy">
            <span class="site-nav-time-label">Rio · PHT</span>
            <time class="site-nav-time-value" data-rio-time>--:--</time>
          </span>
        </span>
        <span class="site-nav-time-difference" data-time-difference>Calculating time difference…</span>
      </span>
    </a>
    <div class="site-nav-links" data-dock>
      <a data-dock-item data-section-link="home" href="/#home" aria-current={currentPath === '/' ? 'location' : undefined}>Home</a>
      <a data-dock-item data-section-link="projects" href="/#projects" aria-current={currentPath === '/projects' ? 'page' : undefined}>Projects</a>
      <a data-dock-item data-section-link="experience" href="/#experience" aria-current={currentPath === '/experience' ? 'page' : undefined}>Experience</a>
      <a data-dock-item data-section-link="stack" href="/#stack" aria-current={currentPath === '/stack' ? 'page' : undefined}>Stack</a>
      <a data-dock-item href="https://www.programmingrio.top/resume.pdf" target="_blank" rel="noreferrer">Resume <i class="ph-duotone ph-arrow-square-out" aria-hidden="true"></i></a>
    </div>
    <div class="site-nav-contact">
      <button class="site-nav-action" type="button" aria-expanded="false">contact@rioespinosa.com</button>
      <div class="site-nav-contact-popout" aria-label="Email actions">
        <div class="site-nav-contact-panel">
          <button type="button" data-copy-email><i class="ph-duotone ph-copy" aria-hidden="true"></i><span>Copy email</span></button>
          <a href="mailto:contact@rioespinosa.com"><i class="ph-duotone ph-envelope-simple" aria-hidden="true"></i><span>Email me</span></a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { ScrollToPlugin } from 'gsap/ScrollToPlugin';

  gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

  const phTime = document.querySelector<HTMLTimeElement>('[data-ph-time]');
  const phTimeIcon = document.querySelector<HTMLElement>('[data-ph-time-icon]');
  const localTime = document.querySelector<HTMLTimeElement>('[data-local-time]');
  const rioTime = document.querySelector<HTMLTimeElement>('[data-rio-time]');
  const localTimeIcon = document.querySelector<HTMLElement>('[data-local-time-icon]');
  const rioTimeIcon = document.querySelector<HTMLElement>('[data-rio-time-icon]');
  const timeDifference = document.querySelector<HTMLElement>('[data-time-difference]');
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  const dockItems = dock ? Array.from(dock.querySelectorAll<HTMLElement>('[data-dock-item]')) : [];
  const siteNav = document.querySelector<HTMLElement>('.site-nav');
  let navVisibilityTrigger: ScrollTrigger | undefined;
  let navIsVisible = true;

  const setNavigationVisibility = (visible: boolean, immediate = false) => {
    if (!siteNav || navIsVisible === visible) return;
    navIsVisible = visible;
    gsap.to(siteNav, {
      '--nav-hide-y': visible ? '0%' : '-140%',
      autoAlpha: visible ? 1 : 0,
      pointerEvents: visible ? 'auto' : 'none',
      duration: immediate ? 0 : 0.28,
      ease: visible ? 'power2.out' : 'power2.in',
      overwrite: true,
    });
  };

  const initializeNavVisibility = () => {
    navVisibilityTrigger?.kill();
    ScrollTrigger.getById('site-nav-visibility')?.kill();
    navVisibilityTrigger = undefined;
    navIsVisible = true;

    if (!siteNav) return;
    gsap.set(siteNav, { clearProps: 'transform' });
    gsap.set(siteNav, { '--nav-hide-y': '0%', autoAlpha: 1, pointerEvents: 'auto' });
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    navVisibilityTrigger = ScrollTrigger.create({
      id: 'site-nav-visibility',
      start: 0,
      end: 'max',
      onUpdate: (self) => setNavigationVisibility(self.scroll() <= 20 || self.direction < 0),
      onLeaveBack: () => setNavigationVisibility(true),
      onRefresh: (self) => {
        if (self.scroll() <= 20) setNavigationVisibility(true, true);
      },
    });
  };

  const localTimeFormatter = new Intl.DateTimeFormat(undefined, {
    hour: 'numeric',
    minute: '2-digit',
    hour12: true,
  });
  const phTimeFormatter = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Asia/Manila',
    hour: 'numeric',
    minute: '2-digit',
    hour12: true,
  });
  const phHourFormatter = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Asia/Manila',
    hour: 'numeric',
    hourCycle: 'h23',
  });
  const setDayPeriodIcon = (icon: HTMLElement | null, isDaytime: boolean) => {
    icon?.classList.toggle('ph-sun', isDaytime);
    icon?.classList.toggle('ph-moon', !isDaytime);
    icon?.classList.toggle('is-daytime', isDaytime);
    icon?.classList.toggle('is-nighttime', !isDaytime);
  };
  const updateTimes = () => {
    const now = new Date();
    const rioHour = Number(phHourFormatter.format(now));
    const isRioDaytime = rioHour >= 6 && rioHour < 18;
    const isLocalDaytime = now.getHours() >= 6 && now.getHours() < 18;
    const isoTime = now.toISOString();

    if (phTime) {
      phTime.textContent = `${phTimeFormatter.format(now)} PHT`;
      phTime.dateTime = isoTime;
    }
    if (localTime) {
      localTime.textContent = localTimeFormatter.format(now);
      localTime.dateTime = isoTime;
    }
    if (rioTime) {
      rioTime.textContent = phTimeFormatter.format(now);
      rioTime.dateTime = isoTime;
    }

    setDayPeriodIcon(phTimeIcon, isRioDaytime);
    setDayPeriodIcon(localTimeIcon, isLocalDaytime);
    setDayPeriodIcon(rioTimeIcon, isRioDaytime);

    if (timeDifference) {
      const rioMinusLocalHours = Math.round((8 + now.getTimezoneOffset() / 60) * 100) / 100;
      const absoluteDifference = Math.abs(rioMinusLocalHours);
      const formattedDifference = new Intl.NumberFormat(undefined, { maximumFractionDigits: 2 }).format(absoluteDifference);
      const unit = absoluteDifference === 1 ? 'hour' : 'hours';

      if (rioMinusLocalHours === 0) timeDifference.textContent = 'Same time · 0-hour difference';
      else timeDifference.textContent = `Rio is ${formattedDifference} ${unit} ${rioMinusLocalHours > 0 ? 'ahead' : 'behind'}`;
    }
  };

  updateTimes();
  window.setInterval(updateTimes, 30_000);

  if (dock && dockItems.length) {
    const media = gsap.matchMedia();

    media.add('(min-width: 681px) and (prefers-reduced-motion: no-preference)', () => {
      const reset = () => gsap.to(dockItems, { scale: 1, z: 0, duration: 0.28, ease: 'power3.out', overwrite: 'auto' });
      const updateDock = (event: PointerEvent) => {
        dockItems.forEach((item) => {
          const bounds = item.getBoundingClientRect();
          const distance = Math.abs(event.clientX - (bounds.left + bounds.width / 2));
          const proximity = Math.max(0, 1 - distance / 105);

          gsap.to(item, {
            scale: 1 + proximity * 0.42,
            z: proximity * 48,
            duration: 0.18,
            ease: 'power3.out',
            overwrite: 'auto',
          });
        });
      };

      dock.addEventListener('pointermove', updateDock);
      dock.addEventListener('pointerleave', reset);

      return () => {
        dock.removeEventListener('pointermove', updateDock);
        dock.removeEventListener('pointerleave', reset);
        gsap.set(dockItems, { clearProps: 'transform' });
      };
    });
  }

  const brand = document.querySelector<HTMLElement>('.site-nav-brand');
  const timePopout = document.querySelector<HTMLElement>('.site-nav-time-popout');

  if (brand && timePopout) {
    const media = gsap.matchMedia();

    media.add('(min-width: 681px)', () => {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const showTimeComparison = () => {
        updateTimes();
        gsap.killTweensOf(timePopout);
        if (reducedMotion) gsap.set(timePopout, { autoAlpha: 1, y: 0, scale: 1 });
        else gsap.fromTo(timePopout,
          { autoAlpha: 0, y: -8, scale: 0.92 },
          { autoAlpha: 1, y: 0, scale: 1, duration: 0.28, ease: 'back.out(1.5)', overwrite: true },
        );
      };
      const hideTimeComparison = () => {
        if (reducedMotion) gsap.set(timePopout, { autoAlpha: 0, y: -6, scale: 0.96 });
        else gsap.to(timePopout, { autoAlpha: 0, y: -6, scale: 0.96, duration: 0.16, ease: 'power2.in', overwrite: true });
      };

      brand.addEventListener('pointerenter', showTimeComparison);
      brand.addEventListener('pointerleave', hideTimeComparison);
      brand.addEventListener('focusin', showTimeComparison);
      brand.addEventListener('focusout', hideTimeComparison);

      return () => {
        brand.removeEventListener('pointerenter', showTimeComparison);
        brand.removeEventListener('pointerleave', hideTimeComparison);
        brand.removeEventListener('focusin', showTimeComparison);
        brand.removeEventListener('focusout', hideTimeComparison);
        gsap.set(timePopout, { clearProps: 'opacity,visibility,transform' });
      };
    });
  }

  const contact = document.querySelector<HTMLElement>('.site-nav-contact');
  const contactTrigger = contact?.querySelector<HTMLButtonElement>('.site-nav-action');
  const contactPopout = contact?.querySelector<HTMLElement>('.site-nav-contact-popout');
  const copyEmail = contact?.querySelector<HTMLButtonElement>('[data-copy-email]');

  if (contact && contactTrigger && contactPopout) {
    const media = gsap.matchMedia();

    media.add('(min-width: 681px) and (prefers-reduced-motion: no-preference)', () => {
      const showContact = () => {
        contactTrigger.setAttribute('aria-expanded', 'true');
        gsap.fromTo(contactPopout,
          { autoAlpha: 0, y: -8, scale: 0.92 },
          { autoAlpha: 1, y: 0, scale: 1, duration: 0.26, ease: 'back.out(1.5)', overwrite: 'auto' },
        );
      };
      const hideContact = () => {
        contactTrigger.setAttribute('aria-expanded', 'false');
        gsap.to(contactPopout, { autoAlpha: 0, y: -6, scale: 0.96, duration: 0.16, ease: 'power2.in', overwrite: 'auto' });
      };

      contact.addEventListener('pointerenter', showContact);
      contact.addEventListener('pointerleave', hideContact);
      contact.addEventListener('focusin', showContact);
      contact.addEventListener('focusout', hideContact);

      return () => {
        contact.removeEventListener('pointerenter', showContact);
        contact.removeEventListener('pointerleave', hideContact);
        contact.removeEventListener('focusin', showContact);
        contact.removeEventListener('focusout', hideContact);
        gsap.set(contactPopout, { clearProps: 'opacity,visibility,transform' });
      };
    });
  }

  copyEmail?.addEventListener('click', async () => {
    const email = 'contact@rioespinosa.com';
    try {
      await navigator.clipboard.writeText(email);
      const label = copyEmail.querySelector('span');
      if (label) label.textContent = 'Copied!';
      window.setTimeout(() => {
        if (label) label.textContent = 'Copy email';
      }, 1500);
    } catch {
      window.location.href = `mailto:${email}`;
    }
  });

  const internalLinks = document.querySelectorAll<HTMLAnchorElement>('[data-dock-item][href^="/"]');
  const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-section-link]'));
  let sectionScrollTriggers: ScrollTrigger[] = [];

  const setCurrentSection = (sectionName: string) => {
    sectionLinks.forEach((link) => {
      if (link.dataset.sectionLink === sectionName) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };

  const updateCurrentLink = () => {
    const currentPath = window.location.pathname === '/' ? '/' : window.location.pathname.replace(/\/+$/, '');
    if (currentPath === '/') {
      setCurrentSection(window.location.hash.slice(1) || 'home');
      return;
    }

    setCurrentSection(currentPath.slice(1));
  };

  const initializeSectionNavigation = () => {
    sectionScrollTriggers.forEach((trigger) => trigger.kill());
    sectionScrollTriggers = [];
    updateCurrentLink();

    if (window.location.pathname !== '/') return;

    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-scroll-section]'));
    sections.forEach((section) => {
      const sectionName = section.dataset.scrollSection;
      if (!sectionName) return;

      sectionScrollTriggers.push(ScrollTrigger.create({
        trigger: section,
        start: 'top 55%',
        end: 'bottom 55%',
        onEnter: () => setCurrentSection(sectionName),
        onEnterBack: () => setCurrentSection(sectionName),
      }));
    });

    ScrollTrigger.refresh();
  };

  document.addEventListener('astro:after-swap', initializeSectionNavigation);
  document.addEventListener('astro:page-load', initializeSectionNavigation);
  document.addEventListener('astro:after-swap', initializeNavVisibility);
  document.addEventListener('astro:page-load', initializeNavVisibility);
  initializeSectionNavigation();
  initializeNavVisibility();

  internalLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      if (
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) return;

      if (link.pathname !== window.location.pathname || !link.hash) return;

      const section = document.querySelector<HTMLElement>(link.hash);
      if (!section) return;

      event.preventDefault();
      event.stopPropagation();
      window.history.pushState({}, '', link.hash);
      const storedTarget = Number(section.dataset.scrollTarget);
      const targetTop = Number.isFinite(storedTarget) ? storedTarget : window.scrollY + section.getBoundingClientRect().top;
      gsap.killTweensOf(window);
      gsap.set(window, { scrollTo: { y: targetTop, autoKill: false } });
      ScrollTrigger.update();
      setCurrentSection(link.dataset.sectionLink ?? link.hash.slice(1));
      setNavigationVisibility(true);
    });
  });
</script>
