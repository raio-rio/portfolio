---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const displayDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).format(new Date(`${post.data.date}T12:00:00Z`));
---

<article class="blog-post">
  <a href={`/blog/${post.id}/`}>
    <span class="blog-post-title">{post.data.title}<span class="blog-post-arrow" aria-hidden="true">↗</span></span>
    <span class="blog-post-description">{post.data.description}</span>
    <span class="blog-post-meta"><time datetime={post.data.date}>{displayDate}</time> · {post.data.readingTime}</span>
  </a>
</article>
