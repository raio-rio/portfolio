<button class="theme-toggle within-toggle" type="button" aria-label="Enable night mode" aria-pressed="false" title="Toggle theme" transition:persist="theme-toggle">
  <svg viewBox="0 0 32 32" aria-hidden="true" fill="currentColor" style="--toggles-within-duration: 500ms">
    <defs>
      <clipPath id="within-toggle-main-clip">
        <path d="M0 0h32v32H0ZM6 16a1 1 0 0 0 20 0 1 1 0 0 0-20 0" />
      </clipPath>
    </defs>
    <g clip-path="url(#within-toggle-main-clip)">
      <path class="within-toggle-rays" d="m30.7 21.3-3.6-5.3 3.7-5.3c.4-.5.1-1.3-.6-1.4l-6.3-1.1-1.1-6.3c-.1-.6-.8-.9-1.4-.6L16 5l-5.4-3.7c-.5-.4-1.3-.1-1.4.6l-1 6.3-6.4 1.1c-.6.1-.9.9-.6 1.3L4.9 16l-3.7 5.3c-.4.5-.1 1.3.6 1.4l6.3 1.1 1.1 6.3c.1.6.8.9 1.4.6l5.3-3.7 5.3 3.7c.5.4 1.3.1 1.4-.6l1.1-6.3 6.3-1.1c.8-.1 1.1-.8.7-1.4ZM16 25.1c-5.1 0-9.1-4.1-9.1-9.1 0-5.1 4.1-9.1 9.1-9.1s9.1 4.1 9.1 9.1c0 5.1-4 9.1-9.1 9.1Z" />
    </g>
    <path class="within-toggle-circle" d="M16 7.7c-4.6 0-8.2 3.7-8.2 8.2s3.6 8.4 8.2 8.4 8.2-3.7 8.2-8.2-3.6-8.4-8.2-8.4Zm0 14.4c-3.4 0-6.1-2.9-6.1-6.2s2.7-6.1 6.1-6.1c3.4 0 6.1 2.9 6.1 6.2s-2.7 6.1-6.1 6.1Z" />
    <path class="within-toggle-inner" d="M16 9.5c-3.6 0-6.4 2.9-6.4 6.4s2.8 6.5 6.4 6.5 6.4-2.9 6.4-6.4-2.8-6.5-6.4-6.5Z" />
  </svg>
  <span class="theme-toggle-label">Night mode</span>
</button>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const root = document.documentElement;

  const updateToggle = () => {
    const isDark = root.classList.contains('theme-dark');
    toggle?.setAttribute('aria-pressed', String(isDark));
    toggle?.setAttribute('aria-label', isDark ? 'Enable light mode' : 'Enable night mode');
    const label = toggle?.querySelector('.theme-toggle-label');
    if (label) label.textContent = isDark ? 'Light mode' : 'Night mode';
  };

  const applySavedTheme = () => {
    try {
      root.classList.toggle('theme-dark', localStorage.getItem('rio-theme') === 'dark');
    } catch {}
    updateToggle();
  };

  applySavedTheme();
  document.addEventListener('astro:after-swap', applySavedTheme);
  document.addEventListener('astro:page-load', applySavedTheme);

  toggle?.addEventListener('click', async () => {
    const isDark = root.classList.contains('theme-dark');
    const applyTheme = () => {
      root.classList.toggle('theme-dark', !isDark);
      localStorage.setItem('rio-theme', isDark ? 'light' : 'dark');
      updateToggle();
    };

    const canAnimate = 'startViewTransition' in document
      && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!canAnimate) {
      applyTheme();
      return;
    }

    const bounds = toggle.getBoundingClientRect();
    const originX = bounds.left + bounds.width / 2;
    const originY = bounds.top + bounds.height / 2;
    const radius = Math.hypot(
      Math.max(originX, window.innerWidth - originX),
      Math.max(originY, window.innerHeight - originY),
    );

    toggle.disabled = true;
    const transition = document.startViewTransition(applyTheme);

    try {
      await transition.ready;
      document.documentElement.animate(
        {
          clipPath: [
            `circle(0px at ${originX}px ${originY}px)`,
            `circle(${radius}px at ${originX}px ${originY}px)`,
          ],
        },
        {
          duration: 560,
          easing: 'cubic-bezier(.76, 0, .24, 1)',
          pseudoElement: '::view-transition-new(root)',
        },
      );
    } finally {
      transition.finished.finally(() => { toggle.disabled = false; });
    }
  });
</script>
