---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteNav from '../components/SiteNav.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description: string;
  path?: string;
  type?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  structuredData?: Record<string, unknown>;
}

const { title, description, path = '/', type = 'website', image: imagePath = '/images/headshot.png', imageAlt = 'Rio Espinosa, Full Stack Developer & AI Engineer', structuredData } = Astro.props;
const site = Astro.site ?? new URL('https://programmingrio.top');
const canonical = new URL(path, site);
const image = new URL(imagePath, site);
const person = {
  '@type': 'Person',
  name: 'Rio Espinosa',
  jobTitle: 'Full Stack Developer & AI Engineer',
  url: site.href,
  email: 'programmingrio@gmail.com',
  image: new URL('/images/headshot.png', site).href,
  address: { '@type': 'PostalAddress', addressLocality: 'Cainta', addressCountry: 'PH' },
  sameAs: ['https://github.com/raio-rio/', 'https://www.linkedin.com/in/rioespinosa02/', 'https://www.instagram.com/_sprio/'],
  knowsAbout: ['Artificial intelligence', 'Machine learning', 'SaaS', 'Full-stack development', 'Blockchain'],
};
const website = {
  '@type': 'WebSite',
  name: 'Rio Espinosa',
  url: site.href,
  inLanguage: 'en',
};
const schema = {
  '@context': 'https://schema.org',
  '@graph': [person, website, ...(structuredData ? [structuredData] : [])],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Rio Espinosa" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#242429" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/jpeg" href="/images/pic.jpg" />
    <link rel="apple-touch-icon" href="/images/pic.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/duotone/style.css" />
    <link rel="stylesheet" href="https://assets.calendly.com/assets/external/widget.css" />
    <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Rio Espinosa" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script is:inline>
      try {
        if (localStorage.getItem('rio-theme') === 'dark') document.documentElement.classList.add('theme-dark');
      } catch {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    <title>{title}</title>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <SiteNav />
    <ThemeToggle />
    <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>
    <slot />
    <script>
  import { gsap } from 'gsap';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const animateEntry = () => {
    const nextPage = document.querySelector<HTMLElement>('main');
    let enterFromBelow = false;
    try {
      enterFromBelow = sessionStorage.getItem('rio-page-panel') === 'true';
      sessionStorage.removeItem('rio-page-panel');
    } catch {}

    if (nextPage && enterFromBelow && !reducedMotion.matches) {
      gsap.fromTo(nextPage,
        { y: window.innerHeight, autoAlpha: 0 },
        { y: 0, autoAlpha: 1, duration: 0.72, ease: 'power3.inOut', clearProps: 'transform,visibility', overwrite: 'auto' },
      );
    }
  };

  animateEntry();
  document.addEventListener('astro:after-swap', animateEntry);

  let scrollProgress = document.querySelector<HTMLElement>('[data-scroll-progress]');
  let progressFrame = 0;
  const updateScrollProgress = () => {
    progressFrame = 0;
    if (!scrollProgress) return;
    const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
    const progress = maxScroll > 0 ? window.scrollY / maxScroll : 0;
    scrollProgress.style.transform = `scaleY(${Math.min(1, Math.max(0, progress))})`;
  };
  const requestProgressUpdate = () => {
    if (!progressFrame) progressFrame = window.requestAnimationFrame(updateScrollProgress);
  };
  const refreshScrollProgress = () => {
    scrollProgress = document.querySelector<HTMLElement>('[data-scroll-progress]');
    requestProgressUpdate();
  };

  window.addEventListener('scroll', requestProgressUpdate, { passive: true });
  window.addEventListener('resize', requestProgressUpdate, { passive: true });
  document.addEventListener('astro:after-swap', refreshScrollProgress);
  document.addEventListener('astro:page-load', refreshScrollProgress);
  requestProgressUpdate();

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const trigger = event.target.closest<HTMLAnchorElement>('[data-calendly-link]');
    if (!trigger) return;

    event.preventDefault();
    const calendly = (window as Window & {
      Calendly?: { initPopupWidget: (options: { url: string }) => void };
    }).Calendly;

    if (calendly) calendly.initPopupWidget({ url: 'https://calendly.com/programmingrio' });
    else window.open(trigger.href, '_blank', 'noopener,noreferrer');
  });
    </script>
  </body>
</html>
