---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import { experience } from '../data/experience';
import Layout from '../layouts/Layout.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featuredProjectIds = new Set(['promorph', 'memorikey', 'juan-scan', 'mazvantage']);
const featuredProjects = projects.filter((project) => featuredProjectIds.has(project.id));
---

<Layout title="Rio Espinosa — Software & AI Engineer" description="Rio Espinosa is a full-stack developer building AI/ML models, SaaS products, full-stack web apps, and blockchain solutions.">
  <main class="page-container">
    <section class="intro slide" aria-labelledby="intro-title">
      <div class="profile-header">
        <img class="portrait portrait-day" src="/images/main.webp" alt="Illustrated portrait of Rio Espinosa" loading="eager" fetchpriority="high" />
        <img class="portrait portrait-night" src="/images/main.webp" alt="" aria-hidden="true" />
        <div class="profile-identity">
          <h1 id="intro-title">Rio Espinosa</h1>
          <p class="profile-role">Software &amp; AI Engineer</p>
          <p class="profile-availability">Based in the Philippines · UTC+8 · <time id="philippines-time" class="local-time" aria-label="Current time in the Philippines">--:--</time></p>
          <p class="profile-email"><button class="copy-email" type="button" data-copy-email aria-label="Copy programmingrio@gmail.com to clipboard">programmingrio@gmail.com<span class="copy-feedback" data-copy-feedback aria-live="polite"></span></button></p>
        </div>
      </div>
      <p>A full-stack developer with experience building AI/ML models, SaaS products, full-stack web apps, and blockchain solutions—from presenting at an international conference to applications that serve thousands of users daily.</p>
      <ul class="about-focus">
        <li><strong>Focus:</strong> product-minded engineering, useful automation, and systems that make work simpler</li>
        <li><strong>Approach:</strong> creative solutions for practical problems</li>
        <li><strong>Interests:</strong> games, cars, and tinkering with tech</li>
      </ul>
      <p class="contact-links">
        <a class="text-link" href="https://www.programmingrio.top/resume.pdf" target="_blank" rel="noreferrer">Resume</a>
        <a class="social-link" href="https://www.linkedin.com/in/rioespinosa02/" target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.4 3A2.4 2.4 0 1 0 5.4 7.8 2.4 2.4 0 0 0 5.4 3ZM3.3 9.6h4.2V21H3.3V9.6Zm6.8 0h4v1.56h.06c.56-1.06 1.92-2.18 3.95-2.18C22.32 8.98 23 11.74 23 15.33V21h-4.2v-5.02c0-1.2-.02-2.75-1.68-2.75-1.69 0-1.95 1.31-1.95 2.66V21h-4.2V9.6Z" /></svg>LinkedIn</a>
        <a class="social-link" href="https://www.instagram.com/_sprio/" target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.2 2h9.6A5.2 5.2 0 0 1 22 7.2v9.6a5.2 5.2 0 0 1-5.2 5.2H7.2A5.2 5.2 0 0 1 2 16.8V7.2A5.2 5.2 0 0 1 7.2 2Zm-.17 2A3.03 3.03 0 0 0 4 7.03v9.94A3.03 3.03 0 0 0 7.03 20h9.94A3.03 3.03 0 0 0 20 16.97V7.03A3.03 3.03 0 0 0 16.97 4H7.03ZM18.5 5.5a1 1 0 1 1 0 2 1 1 0 0 1 0-2ZM12 6.5A5.5 5.5 0 1 1 6.5 12 5.5 5.5 0 0 1 12 6.5Zm0 2A3.5 3.5 0 1 0 15.5 12 3.5 3.5 0 0 0 12 8.5Z" /></svg>Instagram</a>
