      </p>
    </section>

    <div class="highlights slide" aria-label="Career highlights">
      <div><strong>4+</strong><span>Years of experience</span></div>
      <div><strong>87.5%</strong><span>Time savings achieved</span></div>
      <div><strong>20+</strong><span>Features shipped</span></div>
      <div><strong>6</strong><span>Systems reworked</span></div>
    </div>

    <aside class="quick-strip slide" aria-label="Educational attainment">
      <span>Education</span>
      <p>B.S. Computer Science, Cum Laude · University of Santo Tomas Manila</p>
    </aside>
    <aside class="quick-strip slide" aria-label="Languages">
      <span>Languages</span>
      <p>English · Filipino</p>
    </aside>

    <section class="section slide experience-section" aria-labelledby="experience-title">
      <div class="section-heading">
        <h2 id="experience-title">Experience</h2>
      </div>
      <div class="experience-list">
        {experience.map((role) => (
          <details class="experience-item">
            <summary>
              <time>{role.year}</time>
              <strong>{role.role}</strong>
              <span>{role.company}</span>
            </summary>
            <div class="experience-details">
              <p class="experience-detail-meta">{role.period} · {role.location}</p>
              <ul class="experience-detail-stack">
                {role.stack.map((tool) => <li>{tool}</li>)}
              </ul>
              <ul class="experience-detail-highlights">
                {role.highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
            </div>
          </details>
        ))}
      </div>
    </section>

    <section id="work" class="projects slide" aria-label="Selected projects">
      <a class="section-heading projects-heading" href="/projects/">
        <h2 class="projects-title">Projects</h2>
        <span class="see-all">See all <span aria-hidden="true">→</span></span>
      </a>
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </section>

    <section class="section slide stack-section" aria-labelledby="stack-title">
      <a class="section-heading" href="/stack/">
        <h2 id="stack-title">Core stack</h2>
        <span class="see-all">See all <span aria-hidden="true">→</span></span>
      </a>
      <div class="stack-list">
        <p><strong>Frontend:</strong> Next.js, React, TypeScript, Tailwind CSS</p>
        <p><strong>Backend:</strong> NestJS, Express, Prisma, Supabase, Redis</p>
        <p><strong>AI/ML:</strong> Python, PyTorch, TensorFlow, LangChain</p>
      </div>
    </section>

