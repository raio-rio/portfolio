---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import { experience } from '../data/experience';
import { awards } from '../data/awards';
import { stackIcon } from '../lib/stack-icons';
import { buildMembraneShape, MEMBRANE_BOX_PAD } from '../lib/liquid-membrane';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const promorph = projects.find((project) => project.id === 'promorph');
const guise = projects.find((project) => project.id === 'guise');
const jobber = projects.find((project) => project.id === 'jobber');
const featuredProjects = [
  ...(promorph ? [promorph] : []),
  ...(guise ? [guise] : []),
  ...(jobber ? [jobber] : []),
].slice(0, 3);
const research = projects.find((project) => project.id === 'promorph');
const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);
const featurePost = recentPosts.find((post) => post.id === 'dashboard-from-a-drawer-phone') ?? recentPosts[0];
const sidePosts = featurePost ? recentPosts.filter((post) => post.id !== featurePost.id).slice(0, 2) : [];
const homePosts = [...(featurePost ? [featurePost] : []), ...sidePosts];

// The important stacks only — 22 logos, duplicated under the hood for a neat loop.
const featuredStack: string[] = [
  'TypeScript',
  'React',
  'Next.js',
  'JavaScript',
  'Tailwind CSS',
  'Vue.js',
  'Node.js',
  'Python',
  'PostgreSQL',
  'MongoDB',
  'GraphQL',
  'FastAPI',
  'AWS',
  'Docker',
  'Kubernetes',
  'GCP',
  'GitHub Actions',
  'PyTorch',
  'TensorFlow',
  'Jupyter',
  'Claude Code',
  'OpenAI',
];
const awardRows = awards.map((award) => ({
  year: award.meta.split('·').pop()?.trim() ?? '',
  title: award.title,
  name: award.name,
}));
// The membrane is a sampled SVG path; render its resting circle server-side so
// the glass has its full silhouette before the client script runs.
const membraneRest = buildMembraneShape(null, 144);
---

<Layout title="Rio - Full Stack Developer" description="Rio Espinosa builds AI/ML models, SaaS products, full-stack web apps, and blockchain solutions.">
  <div id="smooth-wrapper">
    <main id="smooth-content" class="express-home" aria-label="Rio Espinosa portfolio">
    <div class="home-ambient" aria-hidden="true"></div>
    <section class="express-hero" id="home" data-scroll-section="home">
