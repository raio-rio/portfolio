---
import Layout from '../layouts/Layout.astro';

const philippinesTime = new Intl.DateTimeFormat('en-PH', {
  timeZone: 'Asia/Manila',
  hour: 'numeric',
  minute: '2-digit',
  hour12: true,
}).format(new Date());
---

<Layout title="Rio Espinosa — Full Stack Developer & AI Engineer" description="Rio Espinosa builds AI/ML models, SaaS products, full-stack web apps, and blockchain solutions.">
  <div id="smooth-wrapper">
    <main id="smooth-content" class="express-home" aria-label="Rio Espinosa portfolio">
    <section class="express-hero">
      <div class="express-intro">
        <h1 data-home-headline aria-label="Hi! I’m Rio.">
          <span class="headline-line"><span class="headline-line-content"><span data-typewriter-prefix>Hi! I’m </span><span class="headline-accent headline-pop" data-typewriter-name>Rio.</span><span class="typewriter-cursor" aria-hidden="true">|</span></span></span>
        </h1>
        <p class="express-role">Full Stack Developer &amp; AI Engineer</p>
        <p class="express-summary">Building products, automation, and full-stack systems that solve real problems.</p>
      </div>

      <div class="express-stats" aria-label="Career highlights">
        <div><i class="ph-duotone ph-user" aria-hidden="true"></i><p><strong>4+</strong><span>Years of experience</span></p></div>
        <div><i class="ph-duotone ph-rocket-launch" aria-hidden="true"></i><p><strong>20+</strong><span>Features shipped</span></p></div>
        <div><i class="ph-duotone ph-chart-line-up" aria-hidden="true"></i><p><strong>87.5%</strong><span>Time savings achieved</span></p></div>
        <div><i class="ph-duotone ph-code" aria-hidden="true"></i><p><strong>6</strong><span>Systems reworked</span></p></div>
      </div>
    </section>

    <section class="home-section home-about" aria-labelledby="about-heading">
      <div class="home-about-copy">
        <h2 id="about-heading">Ideas into<br />products that <span>work.</span></h2>
        <p>I build practical software, automation, and AI for real problems.</p>
      </div>
      <a class="home-project-preview" href="/projects/" aria-label="View projects, including ProMorph: Classification Model">
        <img src="/images/projects/promorph/01-cover.png" alt="ProMorph: Classification Model project preview" width="627" height="417" loading="lazy" />
        <span class="home-project-preview-copy">
          <span>Featured project</span>
          <strong>ProMorph: Classification Model</strong>
          <em>View projects ↗</em>
        </span>
      </a>
    </section>

    <section class="home-section home-cta" aria-labelledby="cta-heading">
      <div class="home-cta-main">
        <div class="home-cta-copy">
          <h2 id="cta-heading">Let’s make<br />it <span>work.</span></h2>
          <p>Open to new opportunities and exciting collaborations.</p>
        </div>
        <address class="home-contact-details">
          <a href="mailto:programmingrio@gmail.com"><i class="ph-duotone ph-envelope-simple" aria-hidden="true"></i><span>Email</span><strong>programmingrio@gmail.com</strong></a>
          <a href="https://www.linkedin.com/in/rioespinosa02/" target="_blank" rel="noreferrer"><i class="ph-duotone ph-linkedin-logo" aria-hidden="true"></i><span>LinkedIn</span><strong>Rio Espinosa ↗</strong></a>
          <a href="https://www.instagram.com/_sprio/" target="_blank" rel="noreferrer"><i class="ph-duotone ph-instagram-logo" aria-hidden="true"></i><span>Instagram</span><strong>@_sprio ↗</strong></a>
          <a href="https://wa.me/639338259751?text=Hi%20Rio%2C%20found%20your%20portfolio%20and%20would%20love%20to%20chat!" target="_blank" rel="noreferrer"><i class="ph-duotone ph-whatsapp-logo" aria-hidden="true"></i><span>WhatsApp</span><strong>Message me ↗</strong></a>
          <p><i class="ph-duotone ph-map-pin" aria-hidden="true"></i><span>Philippines</span><strong>Cainta · UTC+8 · <time id="philippines-time" aria-label="Current time in the Philippines">{philippinesTime}</time></strong></p>
        </address>
      </div>
    </section>
    </main>
  </div>

  <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>
  <button class="back-to-top" type="button" data-back-to-top aria-label="Back to top">
    <i class="ph-duotone ph-arrow-up" aria-hidden="true"></i>
    <span>Back to top</span>
  </button>
</Layout>

<script data-astro-rerun>
  import { gsap } from 'gsap';
  import { TextPlugin } from 'gsap/TextPlugin';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { ScrollSmoother } from 'gsap/ScrollSmoother';

  gsap.registerPlugin(TextPlugin, ScrollTrigger, ScrollSmoother);

  const headlineLines = gsap.utils.toArray<HTMLElement>('.headline-line-content');
  const headlineAccents = gsap.utils.toArray<HTMLElement>('.headline-pop');
  const typewriterPrefix = document.querySelector<HTMLElement>('[data-typewriter-prefix]');
  const typewriterName = document.querySelector<HTMLElement>('[data-typewriter-name]');
  const homeIcons = gsap.utils.toArray<HTMLElement>('.express-stats i');
  const aboutReveal = gsap.utils.toArray<HTMLElement>('.home-about-copy, .home-project-preview');
  const contactReveal = gsap.utils.toArray<HTMLElement>('.home-cta-copy, .home-contact-details');
  const progress = document.querySelector<HTMLElement>('[data-scroll-progress]');
  const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
  const localTime = document.querySelector<HTMLTimeElement>('#philippines-time');
  const timeFormatter = new Intl.DateTimeFormat('en-PH', {
    timeZone: 'Asia/Manila',
    hour: 'numeric',
    minute: '2-digit',
    hour12: true,
  });
  const media = gsap.matchMedia();

  const updateLocalTime = () => {
    if (!localTime) return;
    const now = new Date();
    localTime.textContent = timeFormatter.format(now);
    localTime.dateTime = now.toISOString();
  };
  updateLocalTime();
  const localTimeInterval = window.setInterval(updateLocalTime, 1_000);
  const updateBackToTop = () => {
    if (!backToTop) return;
    const smoother = ScrollSmoother.get();
    const scrollPosition = smoother ? smoother.scrollTop() : window.scrollY;
    const maxScroll = ScrollTrigger.maxScroll(window);
    const revealOffset = Math.max(96, window.innerHeight * 0.12);
    backToTop.classList.toggle('is-visible', maxScroll > 0 && scrollPosition >= maxScroll - revealOffset);
  };
  const scrollHomeToTop = () => {
    const smoother = ScrollSmoother.get();
    if (smoother) {
      smoother.scrollTo(0, true);
      return;
    }
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };
  backToTop?.addEventListener('click', scrollHomeToTop);
  window.addEventListener('scroll', updateBackToTop, { passive: true });
  ScrollTrigger.addEventListener('refresh', updateBackToTop);
  updateBackToTop();
  window.addEventListener('portfolio:navigate', () => {
    media.revert();
    window.clearInterval(localTimeInterval);
    backToTop?.removeEventListener('click', scrollHomeToTop);
    window.removeEventListener('scroll', updateBackToTop);
    ScrollTrigger.removeEventListener('refresh', updateBackToTop);
  }, { once: true });

  media.add('(prefers-reduced-motion: no-preference)', () => {
    const headlineIntro = gsap.timeline();
    if (typewriterPrefix && typewriterName) {
      headlineIntro
        .set([typewriterPrefix, typewriterName], { text: '' })
        .from(headlineLines, { autoAlpha: 0, yPercent: 112, duration: 0.7, ease: 'power4.out', stagger: 0.12, overwrite: 'auto' })
        .to(typewriterPrefix, { text: 'Hi! I’m ', duration: 0.54, ease: 'none' })
        .to(typewriterName, { text: 'Rio.', duration: 0.36, ease: 'none' });
    } else {
      headlineIntro.from(headlineLines, { autoAlpha: 0, yPercent: 112, duration: 0.7, ease: 'power4.out', stagger: 0.12, overwrite: 'auto' });
    }
    const iconIntro = gsap.from(homeIcons, { autoAlpha: 0, scale: 0.55, rotation: -12, duration: 0.46, ease: 'back.out(1.7)', stagger: 0.055, delay: 1.15, overwrite: 'auto' });

    return () => {
      headlineIntro.kill();
      iconIntro.kill();
      if (typewriterPrefix) typewriterPrefix.textContent = 'Hi! I’m ';
      if (typewriterName) typewriterName.textContent = 'Rio.';
      gsap.set([...headlineLines, ...headlineAccents, ...homeIcons], { clearProps: 'opacity,visibility,transform' });
    };
  });

  media.add('(prefers-reduced-motion: no-preference)', () => {
    const aboutTween = gsap.from(aboutReveal, {
      autoAlpha: 0,
      y: 34,
      duration: 0.62,
      ease: 'power3.out',
      stagger: 0.1,
      overwrite: 'auto',
      scrollTrigger: {
        trigger: '.home-about',
        start: 'top 78%',
        toggleActions: 'play none none reverse',
      },
    });
    const contactTween = gsap.from(contactReveal, {
      autoAlpha: 0,
      y: 34,
      duration: 0.62,
      ease: 'power3.out',
      stagger: 0.1,
      overwrite: 'auto',
      scrollTrigger: {
        trigger: '.home-cta',
        start: 'top 78%',
        toggleActions: 'play none none reverse',
      },
    });

    return () => {
      aboutTween.scrollTrigger?.kill();
      contactTween.scrollTrigger?.kill();
      aboutTween.kill();
      contactTween.kill();
      gsap.set([...aboutReveal, ...contactReveal], { clearProps: 'opacity,visibility,transform' });
    };
  });

  media.add('(prefers-reduced-motion: no-preference)', () => {
    const setProgress = progress ? gsap.quickSetter(progress, 'scaleY') : undefined;
    const updateProgress = () => {
      if (!setProgress) return;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      setProgress(maxScroll > 0 ? window.scrollY / maxScroll : 0);
    };
    window.addEventListener('scroll', updateProgress, { passive: true });
    ScrollTrigger.addEventListener('refresh', updateProgress);
    updateProgress();

    return () => {
      window.removeEventListener('scroll', updateProgress);
      ScrollTrigger.removeEventListener('refresh', updateProgress);
      progress && gsap.set(progress, { clearProps: 'transform' });
    };
  });

  media.add('(min-width: 769px) and (prefers-reduced-motion: no-preference)', () => {
    const smoother = ScrollSmoother.create({
      wrapper: '#smooth-wrapper',
      content: '#smooth-content',
      smooth: 1.1,
      effects: false,
      normalizeScroll: true,
      ignoreMobileResize: true,
    });
    const backToTopTrigger = ScrollTrigger.create({
      trigger: '#smooth-content',
      start: 'top top',
      end: 'bottom bottom',
      onUpdate: (self) => backToTop?.classList.toggle('is-visible', self.progress >= 0.9),
    });

    return () => {
      backToTopTrigger.kill();
      smoother.kill();
    };
  });
</script>
