        </header>
        <div class="project-grid stack-grid home-section-body" data-stack-grid aria-label="Complete technology stack">
          {stack.map(({ category, icon, tools }) => (
            <article class:list={['project-grid-card', 'stack-grid-card']}>
              <h2><i class:list={['ph-duotone', icon]} aria-hidden="true"></i>{category}</h2>
              <p class="stack-grid-preview">{tools.join(' · ')}</p>
            </article>
          ))}
        </div>
      </section>
    </div>
    </main>
  </div>

</Layout>

<script>
  let cleanupHome: (() => void) | undefined;

  const initializeHome = () => {
    cleanupHome?.();
    cleanupHome = undefined;

    const home = document.querySelector<HTMLElement>('.express-home');
    if (!home) return;

    const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
    const contactOpen = document.querySelector<HTMLAnchorElement>('[data-contact-choice-open]');
    const contactDialog = document.querySelector<HTMLDialogElement>('[data-contact-choice-dialog]');
    const contactDialogClose = contactDialog?.querySelectorAll<HTMLButtonElement>('[data-contact-dialog-close]') ?? [];
    const contactChoiceStep = contactDialog?.querySelector<HTMLElement>('[data-contact-choice-step]');
    const contactMessageStep = contactForm?.querySelector<HTMLElement>('[data-contact-message-step]');
    const contactMessageOpen = contactDialog?.querySelector<HTMLButtonElement>('[data-contact-message-open]');
    const contactCall = contactDialog?.querySelector<HTMLAnchorElement>('[data-contact-call]');
    const contactSubmit = contactForm?.querySelector<HTMLButtonElement>('[data-contact-submit]');
    const contactSubmitLabel = contactForm?.querySelector<HTMLElement>('[data-contact-submit-label]');
    const contactDialogStatus = contactForm?.querySelector<HTMLElement>('[data-contact-dialog-status]');
    const contactFallback = contactForm?.querySelector<HTMLAnchorElement>('[data-contact-fallback]');
    const contactMessage = contactForm?.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
    let contactFormPending = false;

    const clearContactFeedback = () => {
      if (contactDialogStatus) {
        contactDialogStatus.textContent = '';
        contactDialogStatus.dataset.state = '';
      }
      if (contactFallback) contactFallback.hidden = true;
    };

    const showContactStep = (step: 'choice' | 'message') => {
      if (contactChoiceStep) contactChoiceStep.hidden = step !== 'choice';
      if (contactForm) contactForm.hidden = step === 'choice';
      if (contactMessageStep) contactMessageStep.hidden = step !== 'message';
      clearContactFeedback();

      window.requestAnimationFrame(() => {
        if (step === 'message') contactMessage?.focus();
      });
    };

    const handleContactOpen = (event: MouseEvent) => {
      event.preventDefault();
      if (!contactDialog) return;
      showContactStep('choice');
      contactDialog.showModal();
    };

    const handleMessageOpen = () => showContactStep('message');

    const handleMessageInput = () => {
      contactMessage?.setCustomValidity('');
    };

    const handleDialogClose = () => {
      if (!contactFormPending) contactDialog?.close();
    };

    const handleDialogBackdrop = (event: MouseEvent) => {
      if (event.target === contactDialog) handleDialogClose();
    };

    const handleContactCall = () => contactDialog?.close();

    const handleContactSubmit = async (event: SubmitEvent) => {
      event.preventDefault();
      if (!contactForm || !contactSubmit || contactFormPending || !contactForm.reportValidity()) return;

      contactFormPending = true;
      contactSubmit.disabled = true;
      contactSubmit.setAttribute('aria-busy', 'true');
      if (contactSubmitLabel) contactSubmitLabel.textContent = 'Submitting…';
      clearContactFeedback();
      contactForm.querySelectorAll<HTMLElement>('[aria-invalid="true"]').forEach((field) => field.removeAttribute('aria-invalid'));

      const formData = new FormData(contactForm);
      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: formData.get('email'),
            whatsapp: '',
            message: formData.get('message'),
            company: formData.get('company'),
          }),
        });
        const result = await response.json() as { ok?: boolean; message?: string; errors?: Record<string, string> };
        if (!response.ok || !result.ok) {
          if (result.errors) {
            Object.keys(result.errors).forEach((name) => {
              const field = contactForm.elements.namedItem(name);
              if (field instanceof HTMLElement) field.setAttribute('aria-invalid', 'true');
            });
          }
          throw new Error(result.message || 'Your message could not be sent right now.');
        }

        contactForm.reset();
        if (contactDialogStatus) {
          contactDialogStatus.textContent = result.message || 'Message sent — I’ll get back to you soon.';
          contactDialogStatus.dataset.state = 'success';
        }
      } catch (error) {
        if (contactDialogStatus) {
          contactDialogStatus.textContent = error instanceof Error ? error.message : 'Your message could not be sent right now.';
          contactDialogStatus.dataset.state = 'error';
        }
        if (contactFallback) contactFallback.hidden = false;
      } finally {
        contactFormPending = false;
        contactSubmit.disabled = false;
        contactSubmit.removeAttribute('aria-busy');
        if (contactSubmitLabel) contactSubmitLabel.innerHTML = 'Submit <i class="ph-duotone ph-arrow-right" aria-hidden="true"></i>';
      }
    };
    contactOpen?.addEventListener('click', handleContactOpen);
    contactMessageOpen?.addEventListener('click', handleMessageOpen);
    contactCall?.addEventListener('click', handleContactCall);
    contactMessage?.addEventListener('input', handleMessageInput);
    contactDialogClose.forEach((button) => button.addEventListener('click', handleDialogClose));
    contactDialog?.addEventListener('click', handleDialogBackdrop);
    contactForm?.addEventListener('submit', handleContactSubmit);

    const expTriggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-exp-modal-trigger]'));
    const expModals = Array.from(document.querySelectorAll<HTMLDialogElement>('[data-exp-modal]'));

    const handleExpTrigger = (event: Event) => {
      const trigger = event.currentTarget;
      if (!(trigger instanceof HTMLButtonElement)) return;
      const modal = document.getElementById(trigger.getAttribute('aria-controls') ?? '');
      if (modal instanceof HTMLDialogElement) modal.showModal();
    };
    const handleExpModalClose = (event: Event) => {
      const button = event.currentTarget;
      if (!(button instanceof HTMLButtonElement)) return;
      button.closest('dialog')?.close();
    };
    const handleExpModalBackdrop = (event: MouseEvent) => {
      if (event.target instanceof HTMLDialogElement) event.target.close();
    };

    expTriggers.forEach((trigger) => trigger.addEventListener('click', handleExpTrigger));
    expModals.forEach((modal) => {
      modal.querySelectorAll<HTMLButtonElement>('[data-exp-modal-close]').forEach((button) => button.addEventListener('click', handleExpModalClose));
      modal.addEventListener('click', handleExpModalBackdrop);
    });

    const dispose = () => {
      expTriggers.forEach((trigger) => trigger.removeEventListener('click', handleExpTrigger));
      expModals.forEach((modal) => {
        modal.querySelectorAll<HTMLButtonElement>('[data-exp-modal-close]').forEach((button) => button.removeEventListener('click', handleExpModalClose));
        modal.removeEventListener('click', handleExpModalBackdrop);
      });
      contactOpen?.removeEventListener('click', handleContactOpen);
      contactMessageOpen?.removeEventListener('click', handleMessageOpen);
      contactCall?.removeEventListener('click', handleContactCall);
      contactMessage?.removeEventListener('input', handleMessageInput);
      contactDialogClose.forEach((button) => button.removeEventListener('click', handleDialogClose));
      contactDialog?.removeEventListener('click', handleDialogBackdrop);
      contactForm?.removeEventListener('submit', handleContactSubmit);
    };
    cleanupHome = dispose;
  };

  initializeHome();
  document.addEventListener('astro:page-load', initializeHome);
  window.addEventListener('portfolio:home-replay', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
    initializeHome();
  });
</script>

<script is:inline>
  (() => {
    const viewportSelector = '[data-strip-viewport]';
    const trackSelector = '[data-project-strip]';
    const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const state = { index: 0, dragging: false, moved: false, vertical: false, startX: 0, startY: 0, base: 0 };

    const getViewport = () => document.querySelector(viewportSelector);
    const getTrack = (viewport) => (viewport ? viewport.querySelector(trackSelector) : null);
    const getCards = (track) => (track ? Array.from(track.querySelectorAll('.project-strip-card')) : []);
    const getStep = (track) => {
      const cards = getCards(track);
      if (!track || !cards.length) return 0;
      const gap = Number.parseFloat(getComputedStyle(track).columnGap || '0') || 0;
      return cards[0].getBoundingClientRect().width + gap;
    };

    const paint = () => {
      const viewport = getViewport();
      const track = getTrack(viewport);
      const cards = getCards(track);
      if (!viewport || !track || !cards.length) return;
      state.index = Math.max(0, Math.min(cards.length - 1, state.index));
      const counter = viewport.parentElement?.querySelector('[data-strip-index]') ?? document.querySelector('[data-strip-index]');
      if (counter) counter.textContent = String(state.index + 1).padStart(2, '0');
    };

    const render = (animate) => {
      const viewport = getViewport();
      const track = getTrack(viewport);
      const cards = getCards(track);
      if (!viewport || !track || !cards.length) return;
      state.index = Math.max(0, Math.min(cards.length - 1, state.index));
      track.classList.toggle('is-animating', animate && !reduced());
      track.style.transform = `translateX(${-(state.index * getStep(track))}px)`;
      paint();
    };

    document.addEventListener('pointerdown', (event) => {
      const viewport = event.target instanceof Element ? event.target.closest(viewportSelector) : null;
      if (!viewport || event.button !== 0) return;
      const track = getTrack(viewport);
      if (!track) return;
      state.dragging = true;
      state.moved = false;
      state.vertical = false;
      state.startX = event.clientX;
      state.startY = event.clientY;
      state.base = state.index * getStep(track);
      track.classList.remove('is-animating');
    });

    document.addEventListener('pointermove', (event) => {
      if (!state.dragging || state.vertical) return;
      const viewport = getViewport();
      const track = getTrack(viewport);
      if (!viewport || !track) return;
      const dx = event.clientX - state.startX;
      const dy = event.clientY - state.startY;
      if (!state.moved) {
        if (Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 8) {
          state.vertical = true;
          state.dragging = false;
          return;
        }
        if (Math.abs(dx) <= 6) return;
        state.moved = true;
        viewport.classList.add('is-dragging');
      }
      event.preventDefault();
      const cards = getCards(track);
      const max = (cards.length - 1) * getStep(track);
      const offset = Math.max(-60, Math.min(max + 60, state.base - dx));
      track.style.transform = `translateX(${-offset}px)`;
    }, { passive: false });

    const endDrag = () => {
      if (!state.dragging && !state.moved) return;
      const wasMoved = state.moved;
      state.dragging = false;
      state.vertical = false;
      const viewport = getViewport();
      const track = getTrack(viewport);
      if (viewport) viewport.classList.remove('is-dragging');
      if (!track || !wasMoved) {
        state.moved = false;
        return;
      }
      const step = getStep(track);
      const cards = getCards(track);
      const matrix = new DOMMatrixReadOnly(getComputedStyle(track).transform);
      const offset = -matrix.m41;
      state.index = step > 0 ? Math.max(0, Math.min(cards.length - 1, Math.round(offset / step))) : 0;
      render(true);
      window.setTimeout(() => {
        state.moved = false;
      }, 0);
    };
    document.addEventListener('pointerup', endDrag);
    document.addEventListener('pointercancel', endDrag);

    document.addEventListener('click', (event) => {
      if (!state.moved) return;
      state.moved = false;
      event.preventDefault();
      event.stopPropagation();
    }, true);

    document.addEventListener('dragstart', (event) => {
      const target = event.target instanceof Element ? event.target.closest(viewportSelector) : null;
      if (target) event.preventDefault();
    });

    const refresh = () => render(false);
    window.addEventListener('resize', refresh);
    window.addEventListener('load', refresh);
    document.addEventListener('astro:page-load', refresh);
    document.addEventListener('astro:after-swap', refresh);
    if (document.readyState !== 'complete') {
      window.setTimeout(refresh, 300);
    }
    refresh();
  })();
</script>
