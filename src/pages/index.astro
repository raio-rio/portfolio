                        {item.stack.length > 0 && (
                          <>
                            <p class="split-label">Tech stack</p>
                            <ul class="project-stack-chips" aria-label={`${item.role} technology stack`}>
                              {item.stack.map((tool) => <li>{tool}</li>)}
                            </ul>
                          </>
                        )}
                        <p class="split-label">Highlights</p>
                        <ul class="exp-modal-highlights">
                          {item.highlights.map((highlight) => <li>{highlight}</li>)}
                        </ul>
                      </div>
