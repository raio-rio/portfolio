---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import { experience } from '../data/experience';
import { awards } from '../data/awards';
import { stackIcon } from '../lib/stack-icons';
import { buildMembraneShape, MEMBRANE_BOX_PAD } from '../lib/liquid-membrane';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const promorph = projects.find((project) => project.id === 'promorph');
const guise = projects.find((project) => project.id === 'guise');
const jobber = projects.find((project) => project.id === 'jobber');
const featuredProjects = [
  ...(promorph ? [promorph] : []),
  ...(guise ? [guise] : []),
  ...(jobber ? [jobber] : []),
].slice(0, 3);
const research = projects.find((project) => project.id === 'promorph');
const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);
const featurePost = recentPosts.find((post) => post.id === 'dashboard-from-a-drawer-phone') ?? recentPosts[0];
const sidePosts = featurePost ? recentPosts.filter((post) => post.id !== featurePost.id).slice(0, 2) : [];
const homePosts = [...(featurePost ? [featurePost] : []), ...sidePosts];

// The important stacks only — 22 logos, duplicated under the hood for a neat loop.
const featuredStack: string[] = [
  'TypeScript',
  'React',
  'Next.js',
  'JavaScript',
  'Tailwind CSS',
  'Vue.js',
  'Node.js',
  'Python',
  'PostgreSQL',
  'MongoDB',
  'GraphQL',
  'FastAPI',
  'AWS',
  'Docker',
  'Kubernetes',
  'GCP',
  'GitHub Actions',
  'PyTorch',
  'TensorFlow',
  'Jupyter',
  'Claude Code',
  'OpenAI',
];
const awardRows = awards.map((award) => ({
  year: award.meta.split('·').pop()?.trim() ?? '',
  title: award.title,
  name: award.name,
}));
// The membrane is a sampled SVG path; render its resting circle server-side so
// the glass has its full silhouette before the client script runs.
const membraneRest = buildMembraneShape(null, 144);
---

<Layout title="Rio - Full Stack Developer" description="Rio Espinosa builds AI/ML models, SaaS products, full-stack web apps, and blockchain solutions.">
  <div id="smooth-wrapper">
    <main id="smooth-content" class="express-home" aria-label="Rio Espinosa portfolio">
    <section class="express-hero" id="home" data-scroll-section="home">
      <div class="hero-ambient" aria-hidden="true">
        <span class="hero-orb hero-orb-a"></span>
        <span class="hero-orb hero-orb-b"></span>
        <span class="hero-orb hero-orb-c"></span>
      </div>
      <div class="hero-circle" aria-hidden="true">
        <div class="hero-membrane" data-hero-circle-jelly data-hero-membrane style={`--membrane-pad: ${MEMBRANE_BOX_PAD * 100}%`}>
          <div class="hero-circle-jelly">
            <span class="glass-grain" aria-hidden="true"></span>
            <span class="glass-sweep" aria-hidden="true"></span>
          </div>
          <svg class="hero-membrane-rim" viewBox="0 0 1000 1000" aria-hidden="true" focusable="false">
            <defs>
              <clipPath id="hero-membrane-clip" clipPathUnits="objectBoundingBox">
                <path data-hero-membrane-clip d={membraneRest.clip}></path>
              </clipPath>
              <linearGradient id="hero-membrane-rim-gradient" gradientUnits="userSpaceOnUse" x1="140" y1="70" x2="880" y2="930">
                <stop offset="0" stop-color="#ffffff" stop-opacity=".95"></stop>
                <stop offset=".4" stop-color="#ffffff" stop-opacity=".22"></stop>
                <stop offset=".62" stop-color="#ffffff" stop-opacity=".08"></stop>
                <stop offset="1" stop-color="#ffffff" stop-opacity=".4"></stop>
              </linearGradient>
            </defs>
            <path class="hero-membrane-edge" data-hero-membrane-rim d={membraneRest.rim}></path>
            <path class="hero-membrane-gloss" data-hero-membrane-gloss d={membraneRest.rim}></path>
          </svg>
        </div>
      </div>
      <div class="express-hero-surface">
      <div class="hero-center">
        <div class="hero-orbit">
          <div class="hero-core">
            <div class="hero-wordmark" aria-label="Rio Espinosa">
              <p class="hero-kicker">hi! it’s</p>
              <h1 class="hero-ztext"><span class="rio-letters">rio</span></h1>
            </div>
            <p class="hero-tagline">a Full Stack Developer/AI Enthusiast</p>
            <nav class="hero-actions" aria-label="Social links">
              <a href="https://wa.me/639338259751?text=Hi%20Rio%2C%20found%20your%20portfolio%20and%20would%20love%20to%20chat!" target="_blank" rel="noreferrer" aria-label="Message Rio on WhatsApp" data-label="WhatsApp"><i class="ph-bold ph-whatsapp-logo" aria-hidden="true"></i></a>
              <a href="https://www.linkedin.com/in/rioespinosa02/" target="_blank" rel="noreferrer" aria-label="Visit Rio on LinkedIn" data-label="LinkedIn"><i class="ph-bold ph-linkedin-logo" aria-hidden="true"></i></a>
              <a href="https://www.instagram.com/_sprio/" target="_blank" rel="noreferrer" aria-label="Visit Rio on Instagram" data-label="Instagram"><i class="ph-bold ph-instagram-logo" aria-hidden="true"></i></a>
              <a href="https://github.com/raio-rio/" target="_blank" rel="noreferrer" aria-label="Visit Rio on GitHub" data-label="GitHub"><i class="ph-bold ph-github-logo" aria-hidden="true"></i></a>
            </nav>
          </div>
        </div>
      </div>
      <dialog id="contact-choice-dialog" class="contact-email-dialog contact-choice-dialog" data-contact-choice-dialog>
        <div class="contact-email-dialog-panel">
          <button class="contact-email-dialog-close" type="button" data-contact-dialog-close aria-label="Close contact options">
            <i class="ph-bold ph-x" aria-hidden="true"></i>
          </button>

          <div class="contact-dialog-step" data-contact-choice-step>
            <h3>How would you like to connect?</h3>
            <div class="contact-choice-options">
              <a data-contact-call data-calendly-link href="https://calendly.com/programmingrio">
                <i class="ph-bold ph-calendar-check" aria-hidden="true"></i>
                <strong>Book a call</strong>
              </a>
              <button type="button" data-contact-message-open>
                <i class="ph-bold ph-paper-plane-tilt" aria-hidden="true"></i>
                <strong>Send a message</strong>
              </button>
              <a class="contact-choice-linkedin" href="https://www.linkedin.com/in/rioespinosa02/" target="_blank" rel="noreferrer">
                <i class="ph-bold ph-linkedin-logo" aria-hidden="true"></i>
                <strong>LinkedIn</strong>
              </a>
            </div>
            <p class="contact-dialog-sla"><i class="ph-bold ph-clock" aria-hidden="true"></i>Typically replies within 12 hours</p>
          </div>

          <form class="home-contact-form contact-dialog-form" data-contact-form hidden>
            <div class="contact-dialog-step" data-contact-message-step>
              <h3>What would you like to discuss?</h3>
              <div class="contact-form-fields">
                <label>
                  <span>Email</span>
                  <input type="email" name="email" autocomplete="email" inputmode="email" maxlength="254" placeholder="you@example.com" required data-contact-email />
                </label>
                <label class="contact-form-message">
                  <span>Message</span>
                  <textarea name="message" minlength="10" maxlength="5000" rows="4" placeholder="Prefer to write? Write your message here…" required></textarea>
                </label>
              </div>
              <button class="contact-form-trigger contact-form-submit" type="submit" data-contact-submit>
                <i class="ph-bold ph-paper-plane-tilt" aria-hidden="true"></i>
                <strong data-contact-submit-label>Submit <i class="ph-bold ph-arrow-right" aria-hidden="true"></i></strong>
              </button>
            </div>
            <p class="contact-dialog-status" data-contact-dialog-status role="alert" aria-live="assertive"></p>
            <a class="contact-form-fallback" data-contact-fallback href="mailto:contact@rioespinosa.com" hidden>Email me directly</a>

            <label class="contact-form-honeypot" aria-hidden="true">
              <span>Company</span>
              <input type="text" name="company" tabindex="-1" autocomplete="off" />
            </label>
          </form>
        </div>
      </dialog>
      </div>
      <button class="hero-scroll-cue" type="button" data-scroll-cue aria-label="Scroll to projects">
        <span>scroll</span>
        <i aria-hidden="true"></i>
      </button>
      <span class="hero-cue-sentinel" data-hero-top aria-hidden="true"></span>
    </section>

    <div class="home-flow">
      <section class="home-section home-section-projects" id="projects" data-scroll-section="projects" aria-labelledby="projects-title">
        <header class="home-section-head">
          <h2 id="projects-title" class="section-ztext home-section-title">projects</h2>
          <a class="home-section-link" href="/projects/">all projects<i class="ph-bold ph-arrow-right" aria-hidden="true"></i></a>
        </header>
        <div class="project-row" data-project-fan role="region" aria-label="Featured projects">
          {featuredProjects.map((project, index) => (
            <article class="row-card" data-fan-card data-fan-pos={index === 0 ? 'front' : index === 1 ? 'right' : 'left'}>
              <ProjectCard project={project} expanded showTagline showType={false} showImpact={false} />
            </article>
          ))}
        </div>
        <ol class="hero-posts" aria-label="Latest posts">
          {homePosts.map((post) => {
            const displayDate = new Intl.DateTimeFormat('en-US', {
              month: 'short',
              day: 'numeric',
              year: 'numeric',
            }).format(new Date(`${post.data.date}T12:00:00Z`));
            return (
              <li>
                <a class="hero-post-row" href={`/blog/${post.id}/`}>
                  <span class="hero-post-title">{post.data.title}</span>
                  <span class="hero-post-meta"><time datetime={post.data.date}>{displayDate}</time> · {post.data.readingTime}</span>
                </a>
              </li>
            );
          })}
        </ol>
        <div class="home-stack" role="group" aria-label="Core technology stack">
          <div class="stack-marquee">
            <ul class="stack-icons">
              {featuredStack.map((tool) => {
                const glyph = stackIcon(tool);
                return (
                  <li>
                    {glyph
                      ? <span class="stack-icon" role="img" aria-label={tool} data-label={tool}><i class={glyph} aria-hidden="true"></i></span>
                      : <span class="stack-label">{tool}</span>}
                  </li>
                );
              })}
            </ul>
            <ul class="stack-icons" aria-hidden="true">
              {featuredStack.map((tool) => {
                const glyph = stackIcon(tool);
                return (
                  <li>
                    {glyph
                      ? <span class="stack-icon" aria-hidden="true"><i class={glyph} aria-hidden="true"></i></span>
                      : <span class="stack-label" aria-hidden="true">{tool}</span>}
                  </li>
                );
              })}
            </ul>
          </div>
        </div>
      </section>

      <section class="home-section" id="experience" data-scroll-section="experience" aria-labelledby="experience-title">
        <header class="home-section-head">
          <h2 id="experience-title" class="section-ztext home-section-title">experience</h2>
          <a class="home-section-link" href="/ESPINOSA_RESUME.pdf" target="_blank" rel="noreferrer">resume<i class="ph-bold ph-arrow-right" aria-hidden="true"></i></a>
        </header>

        <ol class="exp-list">
          {experience.map((item, index) => (
            <li>
              <button class="exp-row" type="button" data-exp-modal-trigger aria-controls={`exp-modal-${index}`} aria-haspopup="dialog" aria-label={`View details for ${item.role} at ${item.company}`}>
                <span class="exp-row-year">{item.year}</span>
                <span class="exp-row-role">{item.role}</span>
                <span class="exp-row-company">{item.company}</span>
                <span class="exp-row-open" aria-hidden="true"><i class="ph-bold ph-arrow-up-right"></i></span>
              </button>
              <dialog class="project-modal split-modal" id={`exp-modal-${index}`} data-exp-modal aria-labelledby={`exp-modal-${index}-title`}>
                <article class="project-modal-content split-modal-content">
                  <button class="project-modal-close" type="button" data-exp-modal-close aria-label={`Close ${item.role} details`}>×</button>
                  <div class="split-summary">
                    <p class="eyebrow">{item.period} · {item.location}</p>
                    <h2 id={`exp-modal-${index}-title`}>{item.role}</h2>
                    <p class="work-company">{item.company}</p>
                  </div>
                  <div class="split-body">
                    <p class="split-label">Highlights</p>
                    <ul class="exp-modal-highlights">
                      {item.highlights.map((highlight) => <li>{highlight}</li>)}
                    </ul>
                  </div>
                </article>
              </dialog>
            </li>
          ))}
        </ol>

        <div class="exp-extra">
          <p class="exp-extra-label">awards &amp; research</p>
          <ul class="exp-list">
            {awardRows.map((award) => (
              <li class="exp-row exp-row-static">
                <span class="exp-row-year">{award.year}</span>
                <span class="exp-row-role">{award.title}</span>
                <span class="exp-row-company">{award.name}</span>
              </li>
            ))}
            {research && (
              <li class="exp-row exp-row-static">
                <span class="exp-row-year">2024</span>
                <span class="exp-row-role">{research.data.title}</span>
                {research.data.url && (
                  <a class="exp-row-company exp-row-link" href={research.data.url} target="_blank" rel="noreferrer">
                    read paper<i class="ph-bold ph-arrow-up-right" aria-hidden="true"></i>
                  </a>
                )}
              </li>
            )}
          </ul>
        </div>
      </section>

      <section class="home-section home-section-about" id="about" aria-labelledby="about-title">
        <h2 id="about-title" class="about-sr-title">about</h2>
        <div class="about-grid">
          <figure class="about-portrait">
            <img src="/images/portrait.jpg" alt="Rio Espinosa" width="800" height="1000" loading="lazy" decoding="async" />
          </figure>
          <div class="about-copy">
            <div class="about-head">
              <h3 class="about-name">Rio Espinosa</h3>
              <button class="about-email" type="button" data-copy-email aria-label="Copy Rio Espinosa’s email address">
                <i class="ph-bold ph-copy" aria-hidden="true"></i><span>copy email</span>
              </button>
            </div>
            <p>Full-Stack Developer based just outside Manila, Philippines. Into building things on and off the software world, exploring AI and its capabilities and experimenting with new technologies that can turn random ideas into little projects.</p>
            <p>Currently into exploring AI as a medium to better improve workflows not only in my industry but for every other industry as well. One automation at a time.</p>
          </div>
        </div>
      </section>

      <footer class="home-footer">
        <div class="home-footer-main">
          <p class="home-footer-brand">rio espinosa</p>
          <nav class="home-footer-nav" aria-label="Footer">
            <a href="/#projects">projects</a>
            <a href="/#experience">experience</a>
            <a href="/blog/">writing</a>
            <a href="/projects/">all projects</a>
          </nav>
        </div>
      </footer>
    </div>
    </main>
  </div>

  <div class="scroll-rio" data-scroll-rio></div>

</Layout>

<script>
  let cleanupHome: (() => void) | undefined;

  const initializeHome = () => {
    cleanupHome?.();
    cleanupHome = undefined;

    const home = document.querySelector<HTMLElement>('.express-home');
    if (!home) return;

    const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
    const contactOpen = document.querySelector<HTMLAnchorElement>('[data-contact-choice-open]');
    const contactDialog = document.querySelector<HTMLDialogElement>('[data-contact-choice-dialog]');
    const contactDialogClose = contactDialog?.querySelectorAll<HTMLButtonElement>('[data-contact-dialog-close]') ?? [];
    const contactChoiceStep = contactDialog?.querySelector<HTMLElement>('[data-contact-choice-step]');
    const contactMessageStep = contactForm?.querySelector<HTMLElement>('[data-contact-message-step]');
    const contactMessageOpen = contactDialog?.querySelector<HTMLButtonElement>('[data-contact-message-open]');
    const contactCall = contactDialog?.querySelector<HTMLAnchorElement>('[data-contact-call]');
    const contactSubmit = contactForm?.querySelector<HTMLButtonElement>('[data-contact-submit]');
    const contactSubmitLabel = contactForm?.querySelector<HTMLElement>('[data-contact-submit-label]');
    const contactDialogStatus = contactForm?.querySelector<HTMLElement>('[data-contact-dialog-status]');
    const contactFallback = contactForm?.querySelector<HTMLAnchorElement>('[data-contact-fallback]');
    const contactMessage = contactForm?.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
    let contactFormPending = false;

    const clearContactFeedback = () => {
      if (contactDialogStatus) {
        contactDialogStatus.textContent = '';
        contactDialogStatus.dataset.state = '';
      }
      if (contactFallback) contactFallback.hidden = true;
    };

    const showContactStep = (step: 'choice' | 'message') => {
      if (contactChoiceStep) contactChoiceStep.hidden = step !== 'choice';
      if (contactForm) contactForm.hidden = step === 'choice';
      if (contactMessageStep) contactMessageStep.hidden = step !== 'message';
      clearContactFeedback();

      window.requestAnimationFrame(() => {
        if (step === 'message') contactMessage?.focus();
      });
    };

    const handleContactOpen = (event: MouseEvent) => {
      event.preventDefault();
      if (!contactDialog) return;
      showContactStep('choice');
      contactDialog.showModal();
    };

    const handleMessageOpen = () => showContactStep('message');

    const handleMessageInput = () => {
      contactMessage?.setCustomValidity('');
    };

    const handleDialogClose = () => {
      if (!contactFormPending) contactDialog?.close();
    };

    const handleDialogBackdrop = (event: MouseEvent) => {
      if (event.target === contactDialog) handleDialogClose();
    };

    const handleContactCall = () => contactDialog?.close();

    const handleContactSubmit = async (event: SubmitEvent) => {
      event.preventDefault();
      if (!contactForm || !contactSubmit || contactFormPending || !contactForm.reportValidity()) return;

      contactFormPending = true;
      contactSubmit.disabled = true;
      contactSubmit.setAttribute('aria-busy', 'true');
      if (contactSubmitLabel) contactSubmitLabel.textContent = 'Submitting…';
      clearContactFeedback();
      contactForm.querySelectorAll<HTMLElement>('[aria-invalid="true"]').forEach((field) => field.removeAttribute('aria-invalid'));

      const formData = new FormData(contactForm);
      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: formData.get('email'),
            whatsapp: '',
            message: formData.get('message'),
            company: formData.get('company'),
          }),
        });
        const result = await response.json() as { ok?: boolean; message?: string; errors?: Record<string, string> };
        if (!response.ok || !result.ok) {
          if (result.errors) {
            Object.keys(result.errors).forEach((name) => {
              const field = contactForm.elements.namedItem(name);
              if (field instanceof HTMLElement) field.setAttribute('aria-invalid', 'true');
            });
          }
          throw new Error(result.message || 'Your message could not be sent right now.');
        }

        contactForm.reset();
        if (contactDialogStatus) {
          contactDialogStatus.textContent = result.message || 'Message sent — I’ll get back to you soon.';
          contactDialogStatus.dataset.state = 'success';
        }
      } catch (error) {
        if (contactDialogStatus) {
          contactDialogStatus.textContent = error instanceof Error ? error.message : 'Your message could not be sent right now.';
          contactDialogStatus.dataset.state = 'error';
        }
        if (contactFallback) contactFallback.hidden = false;
      } finally {
        contactFormPending = false;
        contactSubmit.disabled = false;
        contactSubmit.removeAttribute('aria-busy');
        if (contactSubmitLabel) contactSubmitLabel.innerHTML = 'Submit <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>';
      }
    };
    contactOpen?.addEventListener('click', handleContactOpen);
    contactMessageOpen?.addEventListener('click', handleMessageOpen);
    contactCall?.addEventListener('click', handleContactCall);
    contactMessage?.addEventListener('input', handleMessageInput);
    contactDialogClose.forEach((button) => button.addEventListener('click', handleDialogClose));
    contactDialog?.addEventListener('click', handleDialogBackdrop);
    contactForm?.addEventListener('submit', handleContactSubmit);

    const heroWordmark = home.querySelector<HTMLElement>('.hero-wordmark');
    const rioFloat = document.querySelector<HTMLElement>('[data-scroll-rio]');
    const handleHeroClick = (event: MouseEvent) => {
      if (!(event.target instanceof Element)) return;
      if (event.target.closest('a, button, dialog')) return;
      if (window.getSelection()?.toString()) return;
      if (!contactDialog || contactDialog.open) return;
      event.preventDefault();
      showContactStep('choice');
      contactDialog.showModal();
    };
    heroWordmark?.addEventListener('click', handleHeroClick);
    const handleRioClick = (event: MouseEvent) => {
      // At the page end the rio becomes a "back to hero" control.
      if (rioFloat?.dataset.mode === 'home') {
        event.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
        return;
      }
      handleHeroClick(event);
    };
    rioFloat?.addEventListener('click', handleRioClick);

    const expTriggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-exp-modal-trigger]'));
    const expModals = Array.from(document.querySelectorAll<HTMLDialogElement>('[data-exp-modal]'));

    const handleExpTrigger = (event: Event) => {
      const trigger = event.currentTarget;
      if (!(trigger instanceof HTMLButtonElement)) return;
      const modal = document.getElementById(trigger.getAttribute('aria-controls') ?? '');
      if (modal instanceof HTMLDialogElement) modal.showModal();
    };
    const handleExpModalClose = (event: Event) => {
      const button = event.currentTarget;
      if (!(button instanceof HTMLButtonElement)) return;
      button.closest('dialog')?.close();
    };
    const handleExpModalBackdrop = (event: MouseEvent) => {
      if (event.target instanceof HTMLDialogElement) event.target.close();
    };

    expTriggers.forEach((trigger) => trigger.addEventListener('click', handleExpTrigger));
    expModals.forEach((modal) => {
      modal.querySelectorAll<HTMLButtonElement>('[data-exp-modal-close]').forEach((button) => button.addEventListener('click', handleExpModalClose));
      modal.addEventListener('click', handleExpModalBackdrop);
    });

    const dispose = () => {
      expTriggers.forEach((trigger) => trigger.removeEventListener('click', handleExpTrigger));
      expModals.forEach((modal) => {
        modal.querySelectorAll<HTMLButtonElement>('[data-exp-modal-close]').forEach((button) => button.removeEventListener('click', handleExpModalClose));
        modal.removeEventListener('click', handleExpModalBackdrop);
      });
      contactOpen?.removeEventListener('click', handleContactOpen);
      contactMessageOpen?.removeEventListener('click', handleMessageOpen);
      contactCall?.removeEventListener('click', handleContactCall);
      contactMessage?.removeEventListener('input', handleMessageInput);
      contactDialogClose.forEach((button) => button.removeEventListener('click', handleDialogClose));
      contactDialog?.removeEventListener('click', handleDialogBackdrop);
      contactForm?.removeEventListener('submit', handleContactSubmit);
      heroWordmark?.removeEventListener('click', handleHeroClick);
      rioFloat?.removeEventListener('click', handleRioClick);
    };
    cleanupHome = dispose;
  };

  initializeHome();
  document.addEventListener('astro:page-load', initializeHome);
  window.addEventListener('portfolio:home-replay', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
    initializeHome();
  });

  // Hero scroll cue: glide to projects, respecting reduced motion.
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const cue = event.target.closest<HTMLElement>('[data-scroll-cue]');
    if (!cue) return;
    event.preventDefault();
    const target = document.querySelector<HTMLElement>('#projects');
    if (!target) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
  });

  // Fade the cue away once the page moves, and bring it back at the top.
  // Geometry-based (IntersectionObserver) rather than scroll math so it stays
  // correct on restore/back-forward and after client-side navigation, with a
  // passive scroll check as a second trigger for browsers that delay the observer.
  let cueObserver: IntersectionObserver | undefined;
  let cueScroll: (() => void) | undefined;
  const initHeroCue = () => {
    cueObserver?.disconnect();
    cueObserver = undefined;
    if (cueScroll) window.removeEventListener('scroll', cueScroll);
    cueScroll = undefined;
    const cue = document.querySelector<HTMLElement>('[data-scroll-cue]');
    const sentinel = document.querySelector<HTMLElement>('[data-hero-top]');
    if (!cue || !sentinel) return;
    const apply = () => {
      const passed = sentinel.getBoundingClientRect().bottom <= 0;
      cue.classList.toggle('is-hidden', passed);
    };
    cue.classList.remove('is-hidden');
    if ('IntersectionObserver' in window) {
      cueObserver = new IntersectionObserver(([entry]) => {
        cue.classList.toggle('is-hidden', !entry.isIntersecting);
      }, { threshold: 0 });
      cueObserver.observe(sentinel);
    }
    cueScroll = apply;
    window.addEventListener('scroll', apply, { passive: true });
    apply();
  };
  document.addEventListener('astro:page-load', initHeroCue);
  initHeroCue();
</script>

<script is:inline>
  (() => {
    const fanSelector = '[data-project-fan]';
    const cardSelector = '[data-fan-card]';
    let front = 0;
    let dragging = false;
    let moved = false;
    let startX = 0;
    let startY = 0;

    const getFan = () => document.querySelector(fanSelector);
    const getCards = (fan) => (fan ? Array.from(fan.querySelectorAll(cardSelector)) : []);
    const posOf = (index, count) => {
      const offset = (((index - front) % count) + count) % count;
      if (offset === 0) return 'front';
      return offset <= Math.floor(count / 2) ? 'right' : 'left';
    };

    const paint = () => {
      const fan = getFan();
      const cards = getCards(fan);
      if (!fan || !cards.length) return;
      front = ((front % cards.length) + cards.length) % cards.length;
      cards.forEach((card, index) => card.setAttribute('data-fan-pos', posOf(index, cards.length)));
    };

    const rotate = (direction) => {
      const cards = getCards(getFan());
      if (!cards.length) return;
      front = (((front + direction) % cards.length) + cards.length) % cards.length;
      paint();
    };

    document.addEventListener('click', (event) => {
      if (moved) {
        moved = false;
        event.preventDefault();
        event.stopPropagation();
        return;
      }
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;
      const card = target.closest(cardSelector);
      if (!card) return;
      const cards = getCards(getFan());
      const index = cards.indexOf(card);
      if (index === -1 || index === front) return;
      event.preventDefault();
      event.stopPropagation();
      front = index;
      paint();
    }, true);

    document.addEventListener('pointerdown', (event) => {
      const fan = event.target instanceof Element ? event.target.closest(fanSelector) : null;
      if (!fan || (event.pointerType === 'mouse' && event.button !== 0)) return;
      dragging = true;
      moved = false;
      startX = event.clientX;
      startY = event.clientY;
    });

    document.addEventListener('pointermove', (event) => {
      if (!dragging || moved) return;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      if (Math.abs(dy) > Math.abs(dx) || Math.abs(dx) <= 10) return;
      moved = true;
      event.preventDefault();
    }, { passive: false });

    const endDrag = (event) => {
      if (!dragging) return;
      dragging = false;
      if (!moved || !(event instanceof PointerEvent)) {
        moved = false;
        return;
      }
      const dx = event.clientX - startX;
      if (Math.abs(dx) > 40) rotate(dx < 0 ? 1 : -1);
      else moved = false;
    };
    document.addEventListener('pointerup', endDrag);
    document.addEventListener('pointercancel', () => {
      dragging = false;
      moved = false;
    });

    document.addEventListener('dragstart', (event) => {
      const target = event.target instanceof Element ? event.target.closest(fanSelector) : null;
      if (target) event.preventDefault();
    });

    paint();
  })();
</script>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import {
    buildMembraneShape,
    measureMembraneContact,
    membraneMotion,
  } from '../lib/liquid-membrane';

  gsap.registerPlugin(ScrollTrigger);

  let scrollRioMedia: ReturnType<typeof gsap.matchMedia> | undefined;
  let circleEntranceTween: gsap.core.Timeline | undefined;
  let circleEntranceTarget: HTMLElement | null = null;

  // The circle arrives like a settling drop of water: a soft squash that
  // overshoots once and relaxes back to a perfect disc.
  const initHeroCircleEntrance = () => {
    const jelly = document.querySelector<HTMLElement>('[data-hero-circle-jelly]');
    if (!jelly || jelly === circleEntranceTarget) return;
    circleEntranceTarget = jelly;
    circleEntranceTween?.kill();
    circleEntranceTween = undefined;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      gsap.set(jelly, { clearProps: 'all' });
      return;
    }

    circleEntranceTween = gsap.timeline()
      .fromTo(jelly,
        { scaleX: 0.92, scaleY: 0.96, autoAlpha: 0.55 },
        { scaleX: 1.015, scaleY: 0.99, autoAlpha: 1, duration: 0.6, ease: 'power2.out' },
      )
      .to(jelly, { scaleX: 0.996, scaleY: 1.004, duration: 0.42, ease: 'sine.inOut' })
      .to(jelly, { scaleX: 1, scaleY: 1, duration: 0.52, ease: 'power2.out' });
  };

  // Adopt the hero's real 3D wordmark into a fixed layer so it can shrink and travel,
  // leaving a ghost box behind that keeps the hero layout exactly as it was.
  const adoptHeroWordmark = () => {
    const layer = document.querySelector<HTMLElement>('[data-scroll-rio]');
    const heroMark = document.querySelector<HTMLElement>('.hero-core > .hero-wordmark');
    if (!layer || !heroMark) return null;

    let shell = layer.querySelector<HTMLElement>('.hero-wordmark');
    if (!shell) {
      shell = document.createElement('div');
      shell.className = 'hero-wordmark scroll-rio-wordmark';
      layer.append(shell);
    }

    const heroH1 = shell.querySelector<HTMLElement>('h1.hero-ztext:not(.scroll-rio-up)') ?? heroMark.querySelector<HTMLElement>('h1.hero-ztext:not(.scroll-rio-up)');
    if (!heroH1) return null;

    let ghost = heroMark.querySelector<HTMLElement>('.hero-wordmark-ghost');
    if (!shell.contains(heroH1)) {
      if (!ghost) {
        ghost = document.createElement('div');
        ghost.className = 'hero-wordmark-ghost';
        ghost.setAttribute('aria-hidden', 'true');
        heroMark.append(ghost);
      }
      shell.append(heroH1);
    }
    if (!ghost) return null;

    // Second 3D wordmark that reads "up." — shown at the page end as the return control.
    let upH1 = shell.querySelector<HTMLElement>('.scroll-rio-up');
    if (!upH1) {
      upH1 = document.createElement('h1');
      upH1.className = 'hero-ztext scroll-rio-up';
      upH1.id = 'rio-up-wordmark';
      upH1.setAttribute('aria-hidden', 'true');
      upH1.innerHTML = '<span class="scroll-rio-arrow"><i class="ph-bold ph-arrow-up"></i></span>';
      shell.append(upH1);
    }
    const Ztextify = (window as Window & {
      Ztextify?: new (selector: string, options: Record<string, string | number | boolean>) => unknown;
    }).Ztextify;
    if (Ztextify && !upH1.querySelector('.z-text')) {
      // Same interactive config as the hero wordmark so the arrow's 3D layers
      // tilt with the pointer too.
      new Ztextify('#rio-up-wordmark.hero-ztext', {
        depth: '.18em',
        direction: 'both',
        event: 'pointer',
        eventRotation: '45deg',
        fade: false,
        layers: 12,
        perspective: '700px',
      });
    }
    // Pin the copy to the travelling origin. This must run after Ztextify, which
    // stamps position:relative inline on its target and would otherwise win.
    upH1.style.position = 'absolute';
    upH1.style.top = '0';
    upH1.style.left = '0';

    const syncGhost = () => {
      ghost.style.width = `${heroH1.offsetWidth}px`;
      ghost.style.height = `${heroH1.offsetHeight}px`;
    };
    syncGhost();

    return { layer, shell, heroH1, upH1, ghost, syncGhost };
  };

  const initScrollRio = () => {
    scrollRioMedia?.revert();
    scrollRioMedia = gsap.matchMedia();

    scrollRioMedia.add('(min-width: 1280px) and (prefers-reduced-motion: no-preference)', () => {
      const adopted = adoptHeroWordmark();
      if (!adopted) return;

      const { layer, shell, heroH1, upH1, ghost, syncGhost } = adopted;
      const heroMark = document.querySelector<HTMLElement>('.hero-core > .hero-wordmark');
      const hero = document.querySelector<HTMLElement>('#home');
      const flow = document.querySelector<HTMLElement>('.home-flow');
      if (!heroMark || !hero) return;

      // Rendered width of the travelling rio, scaled to the window so it reads the same everywhere.
      const targetWidth = () => Math.max(72, Math.min(120, window.innerWidth * 0.065));

      // Everything the guide needs to stay in the gutter beside the content column.
      // The width is capped to the available gutter so it can never sit over the
      // projects (or any other) section on narrower desktop windows.
      const layout = () => {
        const vw = window.innerWidth;
        const flowRect = flow?.getBoundingClientRect();
        const contentLeft = flowRect ? flowRect.left : Math.max(0, (vw - Math.min(vw - 64, 1080)) / 2);
        const gap = Math.max(16, Math.min(28, vw * 0.014));
        const available = Math.max(48, contentLeft - gap * 2);
        return { contentLeft, gap, width: Math.min(targetWidth(), available) };
      };
      const scaleFor = () => Math.min(1, layout().width / (heroH1.offsetWidth || 1));

      const gutterTargets = () => {
        const { contentLeft, gap, width } = layout();
        const height = (heroH1.offsetHeight / (heroH1.offsetWidth || 1)) * width;
        return {
          left: Math.max(gap, contentLeft - width - gap),
          y: (window.innerHeight - height) / 2,
        };
      };

      const setPointer = (enabled: boolean) => {
        layer.style.pointerEvents = enabled ? 'auto' : 'none';
      };

      // The wordmark is interactive at the hero (contact dialog) and again at the
      // very bottom (return to hero), so both phases feed one shared state.
      let atHero = true;
      let atBottom = false;
      const syncPointer = () => {
        setPointer(atHero || atBottom);
        layer.dataset.mode = atBottom ? 'home' : 'guide';
      };

      // The hero stays in normal document flow. The wordmark position is a pure
      // function of scroll (no scrub lag), so exiting and re-entering the
      // circle follow the exact same route. The ripple runs on its own clock.
      const INTRO_SCROLL = 1.3;
      const INTRO_EASE = 'expo.out';
      const INTRO_SCRUB = true;

      const topY = () => Math.max(72, window.innerHeight * 0.09);

      // Measure the ghost relative to the hero rather than in page coordinates.
      // Both boxes move together as the page scrolls, so the anchor stays
      // stable even when a refresh happens mid-transition.
      const heroAnchor = () => {
        const heroRect = hero.getBoundingClientRect();
        const ghostRect = ghost.getBoundingClientRect();
        return { left: ghostRect.left - heroRect.left, top: ghostRect.top - heroRect.top };
      };

      gsap.set([heroH1, upH1], { transformOrigin: 'left top' });
      gsap.set([heroH1, upH1], { x: () => heroAnchor().left, y: () => heroAnchor().top, scale: 1 });
      gsap.set(shell, { x: 0, y: 0 });
      gsap.set(upH1, { autoAlpha: 0 });
      syncPointer();

      // Live viewport bounds keep the contact correct as the circle scrolls
      // and the rio travels away from it.
      const circleBounds = () => {
        const circle = hero.querySelector<HTMLElement>('.hero-circle');
        if (!circle) return null;
        const rect = circle.getBoundingClientRect();
        return {
          x: rect.left + rect.width / 2,
          y: rect.top + rect.height / 2,
          radius: rect.width / 2,
        };
      };

      // Measure the visible text itself, not the h1, so its 3D layers do not
      // inflate the contact box.
      const textBox = () => {
        const text = heroH1.querySelector<HTMLElement>('.z-text') ?? heroH1;
        return text.getBoundingClientRect();
      };

      const membrane = hero.querySelector<HTMLElement>('[data-hero-membrane]');
      const membraneClip = membrane?.querySelector<SVGPathElement>('[data-hero-membrane-clip]');
      const membraneRim = membrane?.querySelector<SVGPathElement>('[data-hero-membrane-rim]');
      const membraneGloss = membrane?.querySelector<SVGPathElement>('[data-hero-membrane-gloss]');
      let lastMembraneClip = membraneClip?.getAttribute('d') ?? '';
      let lastMembraneRim = membraneRim?.getAttribute('d') ?? '';

      // Post-release ripples run on their own slow clock so they stay visible
      // after the scroll stops. They are re-armed once the text is back inside.
      const ripple = { amplitude: 0, phase: 0 };
      let rippleTween: gsap.core.Timeline | undefined;
      let ripplePlaying = false;
      let rippleArmed = true;

      const startRipple = () => {
        ripplePlaying = true;
        rippleTween?.kill();
        ripple.amplitude = 0;
        ripple.phase = 0;
        // Slow, time-based settle: the wave keeps travelling for ~4s after the
        // release, so it can be watched after the scroll stops.
        rippleTween = gsap.timeline({
          onUpdate: paintMembrane,
          onComplete: () => {
            ripplePlaying = false;
            ripple.amplitude = 0;
            paintMembrane();
          },
        })
          .to(ripple, { amplitude: 0.62, phase: 2.2, duration: 0.7, ease: 'power2.out' })
          .to(ripple, { amplitude: 0.34, phase: 7.4, duration: 2.7, ease: 'power1.out' })
          .to(ripple, { amplitude: 0, phase: 8.6, duration: 0.9, ease: 'sine.inOut' });
      };

      const stopRipple = () => {
        rippleTween?.kill();
        rippleTween = undefined;
        ripplePlaying = false;
        rippleArmed = true;
        ripple.amplitude = 0;
        ripple.phase = 0;
      };

      // The intro tween covers the first 130% of the hero. Its scroll progress
      // is the same source that moves the wordmark; contact geometry decides
      // exactly when the surface builds and lets go.
      const guideProgress = () => {
        const end = window.innerHeight * INTRO_SCROLL;
        return end > 0 ? gsap.utils.clamp(0, 1, window.scrollY / end) : 0;
      };

      const paintMembrane = () => {
        if (!membrane || !membraneClip || !membraneRim) return;
        const anchor = circleBounds();
        if (!anchor) return;

        const box = textBox();
        const contact = measureMembraneContact(
          {
            left: box.left,
            top: box.top,
            right: box.right,
            bottom: box.bottom,
          },
          { x: anchor.x, y: anchor.y, radius: anchor.radius },
        );

        if (contact.clearance < -0.06) {
          if (ripplePlaying || ripple.amplitude > 0) stopRipple();
          rippleArmed = true;
        } else if (contact.clearance > 0.01 && rippleArmed && !ripplePlaying) {
          rippleArmed = false;
          startRipple();
        }

        const motion = membraneMotion(contact, guideProgress(), ripple);
        const shape = buildMembraneShape(motion, 144);

        if (shape.clip !== lastMembraneClip) {
          lastMembraneClip = shape.clip;
          membraneClip.setAttribute('d', shape.clip);
        }
        if (shape.rim !== lastMembraneRim) {
          lastMembraneRim = shape.rim;
          membraneRim.setAttribute('d', shape.rim);
          membraneGloss?.setAttribute('d', shape.rim);
        }
      };

      const resetMembrane = () => {
        const rest = buildMembraneShape(null, 144);
        membraneClip?.setAttribute('d', rest.clip);
        membraneRim?.setAttribute('d', rest.rim);
        membraneGloss?.setAttribute('d', rest.rim);
        lastMembraneClip = rest.clip;
        lastMembraneRim = rest.rim;
      };

      const bubbleTrigger = ScrollTrigger.create({
        trigger: hero,
        start: 'top top',
        end: () => ScrollTrigger.maxScroll(window),
        invalidateOnRefresh: true,
        onUpdate: paintMembrane,
        onRefresh: () => {
          paintMembrane();
        },
      });

      // 1. Shrink out of the hero and settle into the left gutter. The hero
      //    remains in normal flow; the post-release ripple runs on its own
      //    slow clock below so it can settle after the scroll stops.
      const intro = gsap.fromTo([heroH1, upH1],
        {
          x: () => heroAnchor().left,
          y: () => heroAnchor().top,
          scale: 1,
        },
        {
          x: () => gutterTargets().left,
          y: () => gutterTargets().y,
          scale: scaleFor,
          ease: INTRO_EASE,
          immediateRender: false,
          onUpdate: paintMembrane,
          scrollTrigger: {
            trigger: hero,
            start: 'top top',
            end: () => `+=${window.innerHeight * INTRO_SCROLL}`,
            scrub: INTRO_SCRUB,
            invalidateOnRefresh: true,
            onUpdate: (self) => {
              atHero = self.progress < 0.04;
              syncPointer();
            },
            onLeaveBack: () => {
              atHero = true;
              syncPointer();
            },
            onLeave: () => {
              atHero = false;
              syncPointer();
            },
          },
        },
      );

      // 2. At the very bottom, lift the rio to the top edge as a "back to hero" control.
      //    Runs on the shell so it composes with the hero tween's y instead of fighting it.
      gsap.fromTo(shell,
        { y: 0 },
        {
          y: () => topY() - gutterTargets().y,
          ease: 'power2.inOut',
          immediateRender: false,
          scrollTrigger: {
            start: () => ScrollTrigger.maxScroll(window) - window.innerHeight * 0.18,
            end: () => ScrollTrigger.maxScroll(window),
            scrub: 1.2,
            invalidateOnRefresh: true,
            onUpdate: (self) => {
              const bottom = self.progress > 0.9;
              if (bottom && !atBottom) wipe.play(0);
              else if (!bottom && atBottom) wipe.reverse();
              atBottom = bottom;
              syncPointer();
              paintMembrane();
            },
            onLeave: () => {
              if (!atBottom) wipe.play(0);
              atBottom = true;
              syncPointer();
              paintMembrane();
            },
            onLeaveBack: () => {
              if (atBottom) wipe.reverse();
              atBottom = false;
              syncPointer();
              paintMembrane();
            },
          },
        },
      );

      // 3. Cross fade at the very bottom: rio. fades out while up. fades in on the
      //    same spot. Driven by the lift tween above: crossing into the bottom
      //    plays it, scrolling back reverses it.
      const wipe = gsap.timeline({ paused: true })
        .fromTo(heroH1,
          { autoAlpha: 1 },
          { autoAlpha: 0, duration: 0.32, ease: 'power2.out' },
          0,
        )
        .fromTo(upH1,
          { autoAlpha: 0 },
          { autoAlpha: 1, duration: 0.36, ease: 'power2.in' },
          0.05,
        );

      // Re-measure the hero box before any refresh (resize, orientation, font load),
      // then refresh so the guide's function-based x/y/scale are re-evaluated.
      const invalidateGuide = () => {
        syncGhost();
        intro.invalidate();
      };
      const onRefreshInit = () => {
        invalidateGuide();
      };
      ScrollTrigger.addEventListener('refreshInit', onRefreshInit);
      paintMembrane();

      const onResize = () => {
        invalidateGuide();
        ScrollTrigger.refresh();
      };
      window.addEventListener('resize', onResize);
      window.addEventListener('orientationchange', onResize);

      return () => {
        window.removeEventListener('resize', onResize);
        window.removeEventListener('orientationchange', onResize);
        ScrollTrigger.removeEventListener('refreshInit', onRefreshInit);
        intro.scrollTrigger?.kill();
        bubbleTrigger.kill();
        stopRipple();
        resetMembrane();
        const circleJelly = hero.querySelector<HTMLElement>('[data-hero-circle-jelly]');
        if (circleJelly) {
          gsap.killTweensOf(circleJelly);
          gsap.set(circleJelly, { clearProps: 'all' });
        }
        // Hand the wordmark back to the hero when this layout no longer applies.
        if (layer.contains(heroH1)) {
          gsap.set(heroH1, { clearProps: 'transform' });
          gsap.set(shell, { clearProps: 'transform' });
          gsap.set(upH1, { clearProps: 'transform' });
          gsap.set(upH1, { autoAlpha: 0 });
          ghost.remove();
          heroMark.append(heroH1);
        }
        setPointer(true);
      };
    });
  };

  document.addEventListener('astro:page-load', initScrollRio);
  initScrollRio();
  document.addEventListener('astro:page-load', initHeroCircleEntrance);
  initHeroCircleEntrance();
</script>
