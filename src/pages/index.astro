---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Rio Espinosa — Full Stack Developer & AI Engineer" description="Rio Espinosa builds AI/ML models, SaaS products, full-stack web apps, and blockchain solutions.">
  <main class="express-home" aria-label="Rio Espinosa portfolio">
    <section class="express-hero home-panel">
      <div class="express-intro">
        <h1 data-home-headline>
          <span class="headline-line"><span class="headline-line-content">Hi! I’m <span class="headline-accent headline-pop">Rio.</span></span></span>
        </h1>
        <p class="express-role">Full Stack Developer &amp; AI Engineer</p>
        <p class="express-summary">I build AI-powered products, automation, and full-stack systems that solve practical problems.</p>
      </div>

      <div class="express-stats" aria-label="Career highlights">
        <div><i class="ph-duotone ph-user" aria-hidden="true"></i><p><strong>4+</strong><span>Years of experience</span></p></div>
        <div><i class="ph-duotone ph-rocket-launch" aria-hidden="true"></i><p><strong>20+</strong><span>Features shipped</span></p></div>
        <div><i class="ph-duotone ph-chart-line-up" aria-hidden="true"></i><p><strong>87.5%</strong><span>Time savings achieved</span></p></div>
        <div><i class="ph-duotone ph-code" aria-hidden="true"></i><p><strong>6</strong><span>Systems reworked</span></p></div>
      </div>
    </section>

    <section class="home-section home-about home-panel" aria-labelledby="about-heading">
      <div class="home-about-copy">
        <h2 id="about-heading">Ideas into<br />products that <span>work.</span></h2>
        <p>I build practical software, automation, and AI for real problems.</p>
      </div>
      <a class="home-project-preview" href="/projects/" aria-label="View projects, including ProMorph: Classification Model">
        <img src="/images/projects/promorph/01-cover.png" alt="ProMorph: Classification Model project preview" width="627" height="417" loading="lazy" />
        <span class="home-project-preview-copy">
          <span>Featured project</span>
          <strong>ProMorph: Classification Model</strong>
          <em>View projects ↗</em>
        </span>
      </a>
    </section>

    <section class="home-section home-cta home-panel" aria-labelledby="cta-heading">
      <div class="home-cta-main">
        <div class="home-cta-copy">
          <h2 id="cta-heading">Let’s make<br />it <span>work.</span></h2>
          <p>Open to new opportunities and exciting collaborations.</p>
        </div>
        <address class="home-contact-details">
          <a href="mailto:programmingrio@gmail.com"><i class="ph-duotone ph-envelope-simple" aria-hidden="true"></i><span>Email</span><strong>programmingrio@gmail.com</strong></a>
          <a href="https://www.linkedin.com/in/rioespinosa02/" target="_blank" rel="noreferrer"><i class="ph-duotone ph-linkedin-logo" aria-hidden="true"></i><span>LinkedIn</span><strong>Rio Espinosa ↗</strong></a>
          <a href="https://www.instagram.com/_sprio/" target="_blank" rel="noreferrer"><i class="ph-duotone ph-instagram-logo" aria-hidden="true"></i><span>Instagram</span><strong>@_sprio ↗</strong></a>
          <a href="https://wa.me/639338259751?text=Hi%20Rio%2C%20found%20your%20portfolio%20and%20would%20love%20to%20chat!" target="_blank" rel="noreferrer"><i class="ph-duotone ph-whatsapp-logo" aria-hidden="true"></i><span>WhatsApp</span><strong>Message me ↗</strong></a>
          <p><i class="ph-duotone ph-map-pin" aria-hidden="true"></i><span>Philippines</span><strong>Cainta · UTC+8 · <time id="philippines-time" aria-label="Current time in the Philippines">--:--</time></strong></p>
        </address>
      </div>
    </section>
  </main>

  <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>
</Layout>

<script data-astro-rerun>
  import { gsap } from 'gsap';
  import { Observer } from 'gsap/Observer';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(Observer, ScrollTrigger);

  const headlineLines = gsap.utils.toArray<HTMLElement>('.headline-line-content');
  const headlineAccents = gsap.utils.toArray<HTMLElement>('.headline-pop');
  const homeIcons = gsap.utils.toArray<HTMLElement>('.express-stats i');
  const progress = document.querySelector<HTMLElement>('[data-scroll-progress]');
  const localTime = document.querySelector<HTMLTimeElement>('#philippines-time');
  const timeFormatter = new Intl.DateTimeFormat('en-PH', {
    timeZone: 'Asia/Manila',
    hour: 'numeric',
    minute: '2-digit',
    hour12: true,
  });
  const media = gsap.matchMedia();

  window.addEventListener('portfolio:navigate', () => {
    media.revert();
  }, { once: true });

  const updateLocalTime = () => {
    if (!localTime) return;
    const now = new Date();
    localTime.textContent = timeFormatter.format(now);
    localTime.dateTime = now.toISOString();
  };
  updateLocalTime();
  window.setInterval(updateLocalTime, 30_000);

  media.add('(prefers-reduced-motion: no-preference)', () => {
    const headlineIntro = gsap.timeline()
      .from(headlineLines, { autoAlpha: 0, yPercent: 112, duration: 0.7, ease: 'power4.out', stagger: 0.12, overwrite: 'auto' })
      .from(headlineAccents, { scale: 0.76, duration: 0.32, ease: 'back.out(1.7)', transformOrigin: 'center bottom', overwrite: 'auto' }, '-=0.3');
    const iconIntro = gsap.from(homeIcons, { autoAlpha: 0, scale: 0.55, rotation: -12, duration: 0.46, ease: 'back.out(1.7)', stagger: 0.055, delay: 0.12, overwrite: 'auto' });

    return () => {
      headlineIntro.kill();
      iconIntro.kill();
      gsap.set([...headlineLines, ...headlineAccents, ...homeIcons], { clearProps: 'opacity,visibility,transform' });
    };
  });

  media.add('(prefers-reduced-motion: no-preference)', () => {
    const setProgress = progress ? gsap.quickSetter(progress, 'scaleY') : undefined;
    const updateProgress = () => {
      if (!setProgress) return;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      setProgress(maxScroll > 0 ? window.scrollY / maxScroll : 0);
    };
    window.addEventListener('scroll', updateProgress, { passive: true });
    ScrollTrigger.addEventListener('refresh', updateProgress);
    updateProgress();

    return () => {
      window.removeEventListener('scroll', updateProgress);
      ScrollTrigger.removeEventListener('refresh', updateProgress);
      progress && gsap.set(progress, { clearProps: 'transform' });
    };
  });

  media.add('(min-width: 769px) and (prefers-reduced-motion: no-preference)', () => {
    const panels = gsap.utils.toArray<HTMLElement>('.home-panel');
    if (panels.length < 2) return;

    let activePanel = 0;
    let isTransitioning = false;
    const wrapPanel = gsap.utils.wrap(0, panels.length);
    document.body.classList.add('home-panel-loop-active');

    gsap.set(panels, { autoAlpha: 0, yPercent: 100 });
    gsap.set(panels[activePanel], { autoAlpha: 1, yPercent: 0 });

    const goToPanel = (index: number, direction: 1 | -1) => {
      if (isTransitioning) return;

      const nextPanel = wrapPanel(index);
      const current = panels[activePanel];
      const next = panels[nextPanel];
      if (!current || !next) return;

      isTransitioning = true;
      gsap.set(next, { autoAlpha: 1, yPercent: direction > 0 ? 100 : -100 });
      gsap.timeline({
        defaults: { duration: 0.72, ease: 'power3.inOut', overwrite: 'auto' },
        onComplete: () => {
          gsap.set(current, { autoAlpha: 0 });
          activePanel = nextPanel;
          isTransitioning = false;
        },
      })
        .to(current, { yPercent: direction > 0 ? -100 : 100 }, 0)
        .to(next, { yPercent: 0 }, 0);
    };

    const observer = Observer.create({
      target: window,
      type: 'wheel,touch',
      wheelSpeed: -1,
      tolerance: 12,
      preventDefault: true,
      onDown: () => goToPanel(activePanel - 1, -1),
      onUp: () => goToPanel(activePanel + 1, 1),
    });

    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === 'ArrowDown' || event.key === 'PageDown' || event.key === ' ') {
        event.preventDefault();
        goToPanel(activePanel + 1, 1);
      }
      if (event.key === 'ArrowUp' || event.key === 'PageUp') {
        event.preventDefault();
        goToPanel(activePanel - 1, -1);
      }
    };
    window.addEventListener('keydown', onKeydown);

    return () => {
      observer.kill();
      window.removeEventListener('keydown', onKeydown);
      document.body.classList.remove('home-panel-loop-active');
      gsap.set(panels, { clearProps: 'opacity,visibility,transform' });
    };
  });
</script>
