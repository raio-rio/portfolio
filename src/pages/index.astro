---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import { experience } from '../data/experience';
import { stack } from '../data/stack';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const promorph = projects.find((project) => project.id === 'promorph');
const featuredProjects = [
  ...(promorph ? [promorph] : []),
  ...projects.filter((project) => project.id !== 'promorph').slice(0, 3),
];
const postDateFormatter = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3)
  .map((post) => ({ ...post, displayDate: postDateFormatter.format(new Date(`${post.data.date}T12:00:00Z`)) }));
---

<Layout title="Rio Espinosa — Full Stack Developer & AI Engineer" description="Rio Espinosa builds AI/ML models, SaaS products, full-stack web apps, and blockchain solutions.">
  <div id="smooth-wrapper">
    <main id="smooth-content" class="express-home" aria-label="Rio Espinosa portfolio">
    <section class="express-hero" id="home" data-scroll-section="home">
      <div class="express-hero-surface">
      <div class="hero-center">
        <div class="hero-orbit">
          <div class="hero-core">
            <div class="hero-wordmark" aria-label="Rio Espinosa">
              <p class="hero-kicker">hi! it’s</p>
              <h1 class="hero-ztext">rio<span class="hero-wordmark-dot" aria-hidden="true">.</span></h1>
            </div>
            <p class="hero-tagline">a Full Stack Developer/AI Enthusiast</p>
          </div>
          <div class="hero-metrics" aria-label="Career highlights">
            <div class="hero-metric hero-metric-1"><span class="hero-metric-icon"><i class="ph-duotone ph-user" aria-hidden="true"></i></span><p><strong>5+</strong><span>Years building</span></p></div>
            <div class="hero-metric hero-metric-2"><span class="hero-metric-icon"><i class="ph-duotone ph-rocket-launch" aria-hidden="true"></i></span><p><strong>13+</strong><span>Projects</span></p></div>
            <div class="hero-metric hero-metric-3"><span class="hero-metric-icon"><i class="ph-duotone ph-hand-coins" aria-hidden="true"></i></span><p><strong>$8,000+</strong><span>Generated/saved by my projects</span></p></div>
          </div>
        </div>
        <nav class="hero-actions" aria-label="Contact and social links">
          <a href="https://wa.me/639338259751?text=Hi%20Rio%2C%20found%20your%20portfolio%20and%20would%20love%20to%20chat!" target="_blank" rel="noreferrer" aria-label="Message Rio on WhatsApp" data-label="WhatsApp"><i class="ph-duotone ph-whatsapp-logo" aria-hidden="true"></i></a>
          <a href="https://www.linkedin.com/in/rioespinosa02/" target="_blank" rel="noreferrer" aria-label="Visit Rio on LinkedIn" data-label="LinkedIn"><i class="ph-duotone ph-linkedin-logo" aria-hidden="true"></i></a>
          <a href="https://www.instagram.com/_sprio/" target="_blank" rel="noreferrer" aria-label="Visit Rio on Instagram" data-label="Instagram"><i class="ph-duotone ph-instagram-logo" aria-hidden="true"></i></a>
          <a href="https://github.com/raio-rio/" target="_blank" rel="noreferrer" aria-label="Visit Rio on GitHub" data-label="GitHub"><i class="ph-duotone ph-github-logo" aria-hidden="true"></i></a>
        </nav>
        <a class="hero-contact" data-contact-choice-open href="#contact-choice-dialog"><i class="ph-duotone ph-chats-circle" aria-hidden="true"></i><span>Let’s build something useful</span></a>
      </div>
      <dialog id="contact-choice-dialog" class="contact-email-dialog contact-choice-dialog" data-contact-choice-dialog>
        <div class="contact-email-dialog-panel">
          <button class="contact-email-dialog-close" type="button" data-contact-dialog-close aria-label="Close contact options">
            <i class="ph-duotone ph-x" aria-hidden="true"></i>
          </button>

          <div class="contact-dialog-step" data-contact-choice-step>
            <i class="contact-email-dialog-icon ph-duotone ph-chats-circle" aria-hidden="true"></i>
            <p class="contact-email-dialog-kicker">Let’s talk</p>
            <h3>How would you like to connect?</h3>
            <div class="contact-choice-options">
              <a data-contact-call data-calendly-link href="https://calendly.com/programmingrio">
                <i class="ph-duotone ph-calendar-check" aria-hidden="true"></i>
                <strong>Book a call</strong>
              </a>
              <button type="button" data-contact-message-open>
                <i class="ph-duotone ph-paper-plane-tilt" aria-hidden="true"></i>
                <strong>Send a message</strong>
              </button>
              <a class="contact-choice-linkedin" href="https://www.linkedin.com/in/rioespinosa02/" target="_blank" rel="noreferrer">
                <i class="ph-duotone ph-linkedin-logo" aria-hidden="true"></i>
                <strong>LinkedIn</strong>
              </a>
            </div>
            <p class="contact-dialog-sla"><i class="ph-duotone ph-clock" aria-hidden="true"></i>Typically replies within 12 hours</p>
          </div>

          <form class="home-contact-form contact-dialog-form" data-contact-form hidden>
            <div class="contact-dialog-step" data-contact-message-step>
              <h3>What would you like to discuss?</h3>
              <div class="contact-form-fields">
                <label>
                  <span>Email</span>
                  <input type="email" name="email" autocomplete="email" inputmode="email" maxlength="254" placeholder="you@example.com" required data-contact-email />
                </label>
                <label class="contact-form-message">
                  <span>Message</span>
                  <textarea name="message" minlength="10" maxlength="5000" rows="4" placeholder="Prefer to write? Write your message here…" required></textarea>
                </label>
              </div>
              <button class="contact-form-trigger contact-form-submit" type="submit" data-contact-submit>
                <i class="ph-duotone ph-paper-plane-tilt" aria-hidden="true"></i>
                <strong data-contact-submit-label>Submit <i class="ph-duotone ph-arrow-right" aria-hidden="true"></i></strong>
              </button>
            </div>
            <p class="contact-dialog-status" data-contact-dialog-status role="alert" aria-live="assertive"></p>
            <a class="contact-form-fallback" data-contact-fallback href="mailto:contact@rioespinosa.com" hidden>Email me directly</a>

            <label class="contact-form-honeypot" aria-hidden="true">
              <span>Company</span>
              <input type="text" name="company" tabindex="-1" autocomplete="off" />
            </label>
          </form>
        </div>
      </dialog>
      </div>
    </section>

    <div class="home-flow">
      <section class="home-section" id="blog" data-scroll-section="blog" aria-labelledby="blog-title">
        <header class="home-section-head">
          <h2 id="blog-title" class="section-ztext home-section-title"><a class="home-section-title-link" href="/blog/">Blog<span aria-hidden="true">.</span><i class="ph-duotone ph-arrow-up-right" aria-hidden="true"></i></a></h2>
          <p class="home-section-lead">Notes on builds, technology, and AI.</p>
        </header>
        <div class="home-blog-list home-section-body" aria-label="Recent posts">
          {recentPosts.map((post) => (
            <article class="project-grid-card home-blog-card">
              <a class="home-blog-link" href={`/blog/${post.id}/`}>
                <span class="home-blog-title">{post.data.title}<i class="ph-duotone ph-arrow-up-right" aria-hidden="true"></i></span>
                <span class="home-blog-meta"><time datetime={post.data.date}>{post.displayDate}</time> · {post.data.readingTime}</span>
                <span class="home-blog-description">{post.data.description}</span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <section class="home-section" id="projects" data-scroll-section="projects" aria-labelledby="projects-title">
        <header class="home-section-head">
          <h2 id="projects-title" class="section-ztext home-section-title"><a class="home-section-title-link" href="/projects/">Projects<span aria-hidden="true">.</span><i class="ph-duotone ph-arrow-up-right" aria-hidden="true"></i></a></h2>
          <p class="home-section-lead">A mix of personal/client projects that I’m able to share.</p>
        </header>
        <div class="project-grid home-section-body" aria-label="Featured projects">
          {featuredProjects.map((project) => (
            <article class="project-grid-card">
              <ProjectCard project={project} expanded />
            </article>
          ))}
        </div>
      </section>

      <section class="home-section" id="experience" data-scroll-section="experience" aria-labelledby="experience-title">
        <header class="home-section-head">
          <h2 id="experience-title" class="section-ztext home-section-title"><a class="home-section-title-link" href="/experience/">Experience<span aria-hidden="true">.</span><i class="ph-duotone ph-arrow-up-right" aria-hidden="true"></i></a></h2>
          <p class="home-section-lead">Some of my work experience with my development work.</p>
        </header>
        <ul class="experience-compact home-section-body" aria-label="Professional experience">
          {experience.map((item) => (
            <li class="experience-row">
              <span class="experience-row-year">{item.year}</span>
              <span class="experience-row-main">
                <strong>{item.role}</strong>
                <span class="experience-row-company">{item.company}</span>
              </span>
              <span class="experience-row-brief">{item.highlights[0]}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="home-section" id="stack" data-scroll-section="stack" aria-labelledby="stack-title">
        <header class="home-section-head">
          <h2 id="stack-title" class="section-ztext home-section-title"><a class="home-section-title-link" href="/stack/">Stack<span aria-hidden="true">.</span><i class="ph-duotone ph-arrow-up-right" aria-hidden="true"></i></a></h2>
          <p class="home-section-lead">The tools I use to take my projects to the next level.</p>
        </header>
        <div class="project-grid stack-grid home-section-body" data-stack-grid aria-label="Complete technology stack">
          {stack.map(({ category, icon, tools }) => (
            <article class:list={['project-grid-card', 'stack-grid-card']}>
              <h2><i class:list={['ph-duotone', icon]} aria-hidden="true"></i>{category}</h2>
              <p class="stack-grid-preview">{tools.join(' · ')}</p>
            </article>
          ))}
        </div>
      </section>
    </div>
    </main>
  </div>

</Layout>

<script>
  let cleanupHome: (() => void) | undefined;

  const initializeHome = () => {
    cleanupHome?.();
    cleanupHome = undefined;

    const home = document.querySelector<HTMLElement>('.express-home');
    if (!home) return;

    const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
    const contactOpen = document.querySelector<HTMLAnchorElement>('[data-contact-choice-open]');
    const contactDialog = document.querySelector<HTMLDialogElement>('[data-contact-choice-dialog]');
    const contactDialogClose = contactDialog?.querySelectorAll<HTMLButtonElement>('[data-contact-dialog-close]') ?? [];
    const contactChoiceStep = contactDialog?.querySelector<HTMLElement>('[data-contact-choice-step]');
    const contactMessageStep = contactForm?.querySelector<HTMLElement>('[data-contact-message-step]');
    const contactMessageOpen = contactDialog?.querySelector<HTMLButtonElement>('[data-contact-message-open]');
    const contactCall = contactDialog?.querySelector<HTMLAnchorElement>('[data-contact-call]');
    const contactSubmit = contactForm?.querySelector<HTMLButtonElement>('[data-contact-submit]');
    const contactSubmitLabel = contactForm?.querySelector<HTMLElement>('[data-contact-submit-label]');
    const contactDialogStatus = contactForm?.querySelector<HTMLElement>('[data-contact-dialog-status]');
    const contactFallback = contactForm?.querySelector<HTMLAnchorElement>('[data-contact-fallback]');
    const contactMessage = contactForm?.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
    let contactFormPending = false;

    const clearContactFeedback = () => {
      if (contactDialogStatus) {
        contactDialogStatus.textContent = '';
        contactDialogStatus.dataset.state = '';
      }
      if (contactFallback) contactFallback.hidden = true;
    };

    const showContactStep = (step: 'choice' | 'message') => {
      if (contactChoiceStep) contactChoiceStep.hidden = step !== 'choice';
      if (contactForm) contactForm.hidden = step === 'choice';
      if (contactMessageStep) contactMessageStep.hidden = step !== 'message';
      clearContactFeedback();

      window.requestAnimationFrame(() => {
        if (step === 'message') contactMessage?.focus();
      });
    };

    const handleContactOpen = (event: MouseEvent) => {
      event.preventDefault();
      if (!contactDialog) return;
      showContactStep('choice');
      contactDialog.showModal();
    };

    const handleMessageOpen = () => showContactStep('message');

    const handleMessageInput = () => {
      contactMessage?.setCustomValidity('');
    };

    const handleDialogClose = () => {
      if (!contactFormPending) contactDialog?.close();
    };

    const handleDialogBackdrop = (event: MouseEvent) => {
      if (event.target === contactDialog) handleDialogClose();
    };

    const handleContactCall = () => contactDialog?.close();

    const handleContactSubmit = async (event: SubmitEvent) => {
      event.preventDefault();
      if (!contactForm || !contactSubmit || contactFormPending || !contactForm.reportValidity()) return;

      contactFormPending = true;
      contactSubmit.disabled = true;
      contactSubmit.setAttribute('aria-busy', 'true');
      if (contactSubmitLabel) contactSubmitLabel.textContent = 'Submitting…';
      clearContactFeedback();
      contactForm.querySelectorAll<HTMLElement>('[aria-invalid="true"]').forEach((field) => field.removeAttribute('aria-invalid'));

      const formData = new FormData(contactForm);
      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: formData.get('email'),
            whatsapp: '',
            message: formData.get('message'),
            company: formData.get('company'),
          }),
        });
        const result = await response.json() as { ok?: boolean; message?: string; errors?: Record<string, string> };
        if (!response.ok || !result.ok) {
          if (result.errors) {
            Object.keys(result.errors).forEach((name) => {
              const field = contactForm.elements.namedItem(name);
              if (field instanceof HTMLElement) field.setAttribute('aria-invalid', 'true');
            });
          }
          throw new Error(result.message || 'Your message could not be sent right now.');
        }

        contactForm.reset();
        if (contactDialogStatus) {
          contactDialogStatus.textContent = result.message || 'Message sent — I’ll get back to you soon.';
          contactDialogStatus.dataset.state = 'success';
        }
      } catch (error) {
        if (contactDialogStatus) {
          contactDialogStatus.textContent = error instanceof Error ? error.message : 'Your message could not be sent right now.';
          contactDialogStatus.dataset.state = 'error';
        }
        if (contactFallback) contactFallback.hidden = false;
      } finally {
        contactFormPending = false;
        contactSubmit.disabled = false;
        contactSubmit.removeAttribute('aria-busy');
        if (contactSubmitLabel) contactSubmitLabel.innerHTML = 'Submit <i class="ph-duotone ph-arrow-right" aria-hidden="true"></i>';
      }
    };
    contactOpen?.addEventListener('click', handleContactOpen);
    contactMessageOpen?.addEventListener('click', handleMessageOpen);
    contactCall?.addEventListener('click', handleContactCall);
    contactMessage?.addEventListener('input', handleMessageInput);
    contactDialogClose.forEach((button) => button.addEventListener('click', handleDialogClose));
    contactDialog?.addEventListener('click', handleDialogBackdrop);
    contactForm?.addEventListener('submit', handleContactSubmit);

    const dispose = () => {
      contactOpen?.removeEventListener('click', handleContactOpen);
      contactMessageOpen?.removeEventListener('click', handleMessageOpen);
      contactCall?.removeEventListener('click', handleContactCall);
      contactMessage?.removeEventListener('input', handleMessageInput);
      contactDialogClose.forEach((button) => button.removeEventListener('click', handleDialogClose));
      contactDialog?.removeEventListener('click', handleDialogBackdrop);
      contactForm?.removeEventListener('submit', handleContactSubmit);
    };
    cleanupHome = dispose;
  };

  initializeHome();
  document.addEventListener('astro:page-load', initializeHome);
  window.addEventListener('portfolio:home-replay', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
    initializeHome();
  });
</script>
