---
import Layout from '../layouts/Layout.astro';
import { getProjectImages } from '../lib/project-images';

const philippinesTime = new Intl.DateTimeFormat('en-PH', {
  timeZone: 'Asia/Manila',
  hour: 'numeric',
  minute: '2-digit',
  hour12: true,
}).format(new Date());
const promorphImages = getProjectImages('promorph');
const promorphCover = promorphImages[0] ?? '/images/projects/promorph/01-cover.png';
const promorphAlternate = promorphImages[1];
---

<Layout title="Rio Espinosa — Full Stack Developer & AI Engineer" description="Rio Espinosa builds AI/ML models, SaaS products, full-stack web apps, and blockchain solutions.">
  <div id="smooth-wrapper">
    <main id="smooth-content" class="express-home" aria-label="Rio Espinosa portfolio">
    <section class="express-hero">
      <div class="express-intro">
        <h1 data-home-headline aria-label="Hi! I’m Rio.">
          <span class="headline-line"><span class="headline-line-content"><span class="headline-greeting">Hi! I’m </span><span class="headline-accent headline-pop">Rio</span></span></span>
        </h1>
        <p class="express-role">Full Stack Developer &amp; AI Engineer</p>
        <p class="express-summary">Building products, automation, and full-stack systems that solve real problems.</p>
      </div>

      <div class="express-stats" aria-label="Career highlights">
        <div><span class="metric-icon"><i class="ph-duotone ph-user" aria-hidden="true"></i></span><p><strong>4+</strong><span>Years of experience</span></p></div>
        <div><span class="metric-icon"><i class="ph-duotone ph-rocket-launch" aria-hidden="true"></i></span><p><strong>20+</strong><span>Features shipped</span></p></div>
        <div><span class="metric-icon"><i class="ph-duotone ph-chart-line-up" aria-hidden="true"></i></span><p><strong>87.5%</strong><span>Time savings achieved</span></p></div>
        <div><span class="metric-icon"><i class="ph-duotone ph-code" aria-hidden="true"></i></span><p><strong>6</strong><span>Systems reworked</span></p></div>
      </div>
      <a class="calendly-secondary calendly-hero-link" data-contact-choice-open href="#contact-choice-dialog"><i class="ph-duotone ph-chats-circle" aria-hidden="true"></i><span class="calendly-hero-prompt">Interested to know more?</span><span class="calendly-link-label">Book or Message</span></a>
      <dialog id="contact-choice-dialog" class="contact-email-dialog contact-choice-dialog" data-contact-choice-dialog>
        <div class="contact-email-dialog-panel">
          <button class="contact-email-dialog-close" type="button" data-contact-dialog-close aria-label="Close contact options">
            <i class="ph-duotone ph-x" aria-hidden="true"></i>
          </button>

          <div class="contact-dialog-step" data-contact-choice-step>
            <i class="contact-email-dialog-icon ph-duotone ph-chats-circle" aria-hidden="true"></i>
            <p class="contact-email-dialog-kicker">Let’s talk</p>
            <h3>How would you like to connect?</h3>
            <div class="contact-choice-options">
              <a data-contact-call data-calendly-link href="https://calendly.com/programmingrio">
                <i class="ph-duotone ph-calendar-check" aria-hidden="true"></i>
                <span>Book a call</span>
                <strong>Choose a time</strong>
              </a>
              <button type="button" data-contact-message-open>
                <i class="ph-duotone ph-paper-plane-tilt" aria-hidden="true"></i>
                <span>Send a message</span>
                <strong>Write to me</strong>
              </button>
            </div>
          </div>

          <form class="home-contact-form contact-dialog-form" data-contact-form hidden>
            <div class="contact-dialog-step" data-contact-message-step>
              <button class="contact-dialog-back" type="button" data-contact-back-choice><i class="ph-duotone ph-arrow-left" aria-hidden="true"></i> Back</button>
              <h3>What would you like to discuss?</h3>
              <div class="contact-form-fields">
                <label class="contact-form-message">
                  <span>Message</span>
                  <textarea name="message" minlength="10" maxlength="5000" rows="4" placeholder="Prefer to write? Write your message here…" required></textarea>
                </label>
                <label>
                  <span>Email</span>
                  <input type="email" name="email" autocomplete="email" inputmode="email" maxlength="254" required data-contact-email />
                </label>
              </div>
              <button class="contact-form-trigger contact-form-submit" type="submit" data-contact-submit>
                <i class="ph-duotone ph-paper-plane-tilt" aria-hidden="true"></i>
                <span>Send message</span>
                <strong data-contact-submit-label>Submit <i class="ph-duotone ph-arrow-right" aria-hidden="true"></i></strong>
              </button>
            </div>
            <p class="contact-dialog-status" data-contact-dialog-status role="alert" aria-live="assertive"></p>
            <a class="contact-form-fallback" data-contact-fallback href="mailto:programmingrio@gmail.com" hidden>Email me directly</a>

            <label class="contact-form-honeypot" aria-hidden="true">
              <span>Company</span>
              <input type="text" name="company" tabindex="-1" autocomplete="off" />
            </label>
          </form>
        </div>
      </dialog>
    </section>

    <section class="home-section home-about" aria-labelledby="about-heading">
      <div class="home-about-copy">
        <h2 id="about-heading">Ideas into<br />products that <span>work.</span></h2>
        <p>I build practical software, automation, and AI for real problems.</p>
      </div>
      <a class="home-project-preview" href="/projects/" aria-label="View projects, including ProMorph: Classification Model in ICIAC Japan 2024">
        <span class="home-project-preview-media">
          <img src={promorphCover} alt="ProMorph: Classification Model in ICIAC Japan 2024 project preview" width="627" height="417" loading="lazy" />
          {promorphAlternate && <img class="home-project-preview-alternate" src={promorphAlternate} alt="ProMorph: Classification Model in ICIAC Japan 2024 alternate project preview" width="627" height="417" loading="lazy" />}
        </span>
        <span class="home-project-preview-copy">
          <span>Featured project</span>
          <strong>ProMorph: Classification Model in ICIAC Japan 2024</strong>
          <em>View projects <i class="ph-duotone ph-arrow-square-out" aria-hidden="true"></i></em>
        </span>
      </a>
    </section>

    <section class="home-section home-cta" aria-labelledby="cta-heading">
      <div class="home-cta-main">
        <div class="home-cta-copy">
          <h2 id="cta-heading">Let’s make<br />it <span>work.</span></h2>
          <p>Open to new opportunities and exciting collaborations.</p>
        </div>
        <address class="home-contact-details">
          <a href="mailto:programmingrio@gmail.com"><i class="ph-duotone ph-envelope-simple" aria-hidden="true"></i><span>Email</span><strong>programmingrio@gmail.com</strong></a>
          <a href="https://www.linkedin.com/in/rioespinosa02/" target="_blank" rel="noreferrer"><i class="ph-duotone ph-linkedin-logo" aria-hidden="true"></i><span>LinkedIn</span><strong>Rio Espinosa <i class="ph-duotone ph-arrow-square-out" aria-hidden="true"></i></strong></a>
          <a href="https://www.instagram.com/_sprio/" target="_blank" rel="noreferrer"><i class="ph-duotone ph-instagram-logo" aria-hidden="true"></i><span>Instagram</span><strong>@_sprio <i class="ph-duotone ph-arrow-square-out" aria-hidden="true"></i></strong></a>
          <a href="https://wa.me/639338259751?text=Hi%20Rio%2C%20found%20your%20portfolio%20and%20would%20love%20to%20chat!" target="_blank" rel="noreferrer"><i class="ph-duotone ph-whatsapp-logo" aria-hidden="true"></i><span>WhatsApp</span><strong>Message me <i class="ph-duotone ph-arrow-square-out" aria-hidden="true"></i></strong></a>
          <a data-calendly-link href="https://calendly.com/programmingrio"><i class="ph-duotone ph-calendar-check" aria-hidden="true"></i><span>Book a call</span><strong>Schedule time <i class="ph-duotone ph-arrow-square-out" aria-hidden="true"></i></strong></a>
          <p><i class="ph-duotone ph-map-pin" aria-hidden="true"></i><span>Philippines</span><strong>Cainta · UTC+8 · <time id="philippines-time" aria-label="Current time in the Philippines">{philippinesTime}</time></strong></p>
        </address>
      </div>
    </section>
    </main>
  </div>

</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { ScrollSmoother } from 'gsap/ScrollSmoother';

  gsap.registerPlugin(ScrollTrigger, ScrollSmoother);

  const timeFormatter = new Intl.DateTimeFormat('en-PH', {
    timeZone: 'Asia/Manila',
    hour: 'numeric',
    minute: '2-digit',
    hour12: true,
  });
  let cleanupHome: (() => void) | undefined;

  const initializeHome = () => {
    cleanupHome?.();
    cleanupHome = undefined;

    if (!document.querySelector('.express-home')) return;

    const headlineLines = gsap.utils.toArray<HTMLElement>('.headline-line-content');
    const headlineAccents = gsap.utils.toArray<HTMLElement>('.headline-pop');
    const headlineGreeting = gsap.utils.toArray<HTMLElement>('.headline-greeting');
    const homeIcons = gsap.utils.toArray<HTMLElement>('.express-stats i');
    const aboutReveal = gsap.utils.toArray<HTMLElement>('.home-about-copy, .home-project-preview');
    const contactReveal = gsap.utils.toArray<HTMLElement>('.home-cta-copy, .home-contact-details');
    const alternateProjectPreview = document.querySelector<HTMLElement>('.home-project-preview-alternate');
    const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
    const contactOpen = document.querySelector<HTMLAnchorElement>('[data-contact-choice-open]');
    const contactDialog = document.querySelector<HTMLDialogElement>('[data-contact-choice-dialog]');
    const contactDialogClose = contactDialog?.querySelectorAll<HTMLButtonElement>('[data-contact-dialog-close]') ?? [];
    const contactChoiceStep = contactDialog?.querySelector<HTMLElement>('[data-contact-choice-step]');
    const contactMessageStep = contactForm?.querySelector<HTMLElement>('[data-contact-message-step]');
    const contactMessageOpen = contactDialog?.querySelector<HTMLButtonElement>('[data-contact-message-open]');
    const contactBackChoice = contactForm?.querySelector<HTMLButtonElement>('[data-contact-back-choice]');
    const contactCall = contactDialog?.querySelector<HTMLAnchorElement>('[data-contact-call]');
    const contactSubmit = contactForm?.querySelector<HTMLButtonElement>('[data-contact-submit]');
    const contactSubmitLabel = contactForm?.querySelector<HTMLElement>('[data-contact-submit-label]');
    const contactDialogStatus = contactForm?.querySelector<HTMLElement>('[data-contact-dialog-status]');
    const contactFallback = contactForm?.querySelector<HTMLAnchorElement>('[data-contact-fallback]');
    const contactMessage = contactForm?.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
    const localTime = document.querySelector<HTMLTimeElement>('#philippines-time');
    const media = gsap.matchMedia();
    let contactFormPending = false;

    const updateLocalTime = () => {
      if (!localTime) return;
      const now = new Date();
      localTime.textContent = timeFormatter.format(now);
      localTime.dateTime = now.toISOString();
    };
    updateLocalTime();
    const localTimeInterval = window.setInterval(updateLocalTime, 1_000);

    const clearContactFeedback = () => {
      if (contactDialogStatus) {
        contactDialogStatus.textContent = '';
        contactDialogStatus.dataset.state = '';
      }
      if (contactFallback) contactFallback.hidden = true;
    };

    const showContactStep = (step: 'choice' | 'message') => {
      if (contactChoiceStep) contactChoiceStep.hidden = step !== 'choice';
      if (contactForm) contactForm.hidden = step === 'choice';
      if (contactMessageStep) contactMessageStep.hidden = step !== 'message';
      clearContactFeedback();

      window.requestAnimationFrame(() => {
        if (step === 'message') contactMessage?.focus();
      });
    };

    const handleContactOpen = (event: MouseEvent) => {
      event.preventDefault();
      if (!contactDialog) return;
      showContactStep('choice');
      contactDialog.showModal();
    };

    const handleMessageOpen = () => showContactStep('message');

    const handleMessageInput = () => {
      contactMessage?.setCustomValidity('');
    };

    const handleDialogClose = () => {
      if (!contactFormPending) contactDialog?.close();
    };

    const handleContactCall = () => contactDialog?.close();
    const handleBackChoice = () => showContactStep('choice');

    const handleContactSubmit = async (event: SubmitEvent) => {
      event.preventDefault();
      if (!contactForm || !contactSubmit || contactFormPending || !contactForm.reportValidity()) return;

      contactFormPending = true;
      contactSubmit.disabled = true;
      contactSubmit.setAttribute('aria-busy', 'true');
      if (contactSubmitLabel) contactSubmitLabel.textContent = 'Submitting…';
      clearContactFeedback();
      contactForm.querySelectorAll<HTMLElement>('[aria-invalid="true"]').forEach((field) => field.removeAttribute('aria-invalid'));

      const formData = new FormData(contactForm);
      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: formData.get('email'),
            whatsapp: '',
            message: formData.get('message'),
            company: formData.get('company'),
          }),
        });
        const result = await response.json() as { ok?: boolean; message?: string; errors?: Record<string, string> };
        if (!response.ok || !result.ok) {
          if (result.errors) {
            Object.keys(result.errors).forEach((name) => {
              const field = contactForm.elements.namedItem(name);
              if (field instanceof HTMLElement) field.setAttribute('aria-invalid', 'true');
            });
          }
          throw new Error(result.message || 'Your message could not be sent right now.');
        }

        contactForm.reset();
        if (contactDialogStatus) {
          contactDialogStatus.textContent = result.message || 'Message sent — I’ll get back to you soon.';
          contactDialogStatus.dataset.state = 'success';
        }
      } catch (error) {
        if (contactDialogStatus) {
          contactDialogStatus.textContent = error instanceof Error ? error.message : 'Your message could not be sent right now.';
          contactDialogStatus.dataset.state = 'error';
        }
        if (contactFallback) contactFallback.hidden = false;
      } finally {
        contactFormPending = false;
        contactSubmit.disabled = false;
        contactSubmit.removeAttribute('aria-busy');
        if (contactSubmitLabel) contactSubmitLabel.innerHTML = 'Submit <i class="ph-duotone ph-arrow-right" aria-hidden="true"></i>';
      }
    };
    contactOpen?.addEventListener('click', handleContactOpen);
    contactMessageOpen?.addEventListener('click', handleMessageOpen);
    contactBackChoice?.addEventListener('click', handleBackChoice);
    contactCall?.addEventListener('click', handleContactCall);
    contactMessage?.addEventListener('input', handleMessageInput);
    contactDialogClose.forEach((button) => button.addEventListener('click', handleDialogClose));
    contactForm?.addEventListener('submit', handleContactSubmit);

    media.add('(prefers-reduced-motion: no-preference)', () => {
      const headlineIntro = gsap.timeline()
        .from(headlineLines, { autoAlpha: 0, yPercent: 112, duration: 0.72, ease: 'power4.out', stagger: 0.12, overwrite: 'auto' })
        .from(headlineGreeting, { autoAlpha: 0, yPercent: 34, duration: 0.46, ease: 'power3.out', overwrite: 'auto' }, 0.12)
        .from(headlineAccents, { autoAlpha: 0, yPercent: 28, scale: 0.8, duration: 0.42, ease: 'back.out(1.55)', transformOrigin: 'center bottom', overwrite: 'auto' }, 0.28);
      const iconIntro = gsap.from(homeIcons, { autoAlpha: 0, scale: 0.55, rotation: -12, duration: 0.46, ease: 'back.out(1.7)', stagger: 0.055, delay: 0.78, overwrite: 'auto' });

      return () => {
        headlineIntro.kill();
        iconIntro.kill();
        gsap.set([...headlineLines, ...headlineGreeting, ...headlineAccents, ...homeIcons], { clearProps: 'opacity,visibility,transform' });
      };
    });

    media.add('(prefers-reduced-motion: no-preference)', () => {
      const aboutTween = gsap.from(aboutReveal, {
        autoAlpha: 0,
        y: 34,
        duration: 0.62,
        ease: 'power3.out',
        stagger: 0.1,
        overwrite: 'auto',
        scrollTrigger: { trigger: '.home-about', start: 'top 78%', toggleActions: 'play none none reverse' },
      });
      const contactTween = gsap.from(contactReveal, {
        autoAlpha: 0,
        y: 34,
        duration: 0.62,
        ease: 'power3.out',
        stagger: 0.1,
        overwrite: 'auto',
        scrollTrigger: { trigger: '.home-cta', start: 'top 78%', toggleActions: 'play none none reverse' },
      });
      const projectImageTween = alternateProjectPreview && gsap.to(alternateProjectPreview, {
        autoAlpha: 1,
        duration: 0.38,
        ease: 'power2.out',
        overwrite: 'auto',
        scrollTrigger: { trigger: '.home-cta', start: 'top 78%', toggleActions: 'play none none reverse' },
      });

      return () => {
        aboutTween.scrollTrigger?.kill();
        contactTween.scrollTrigger?.kill();
        projectImageTween?.scrollTrigger?.kill();
        aboutTween.kill();
        contactTween.kill();
        projectImageTween?.kill();
        gsap.set([...aboutReveal, ...contactReveal], { clearProps: 'opacity,visibility,transform' });
        if (alternateProjectPreview) gsap.set(alternateProjectPreview, { clearProps: 'opacity,visibility' });
      };
    });

    media.add('(min-width: 769px) and (prefers-reduced-motion: no-preference)', () => {
      const smoother = ScrollSmoother.create({
        wrapper: '#smooth-wrapper',
        content: '#smooth-content',
        smooth: 1.1,
        effects: false,
        normalizeScroll: true,
        ignoreMobileResize: true,
      });
      return () => {
        smoother.kill();
      };
    });

    const dispose = () => {
      media.revert();
      window.clearInterval(localTimeInterval);
      contactOpen?.removeEventListener('click', handleContactOpen);
      contactMessageOpen?.removeEventListener('click', handleMessageOpen);
      contactBackChoice?.removeEventListener('click', handleBackChoice);
      contactCall?.removeEventListener('click', handleContactCall);
      contactMessage?.removeEventListener('input', handleMessageInput);
      contactDialogClose.forEach((button) => button.removeEventListener('click', handleDialogClose));
      contactForm?.removeEventListener('submit', handleContactSubmit);
      window.removeEventListener('portfolio:navigate', dispose);
    };
    cleanupHome = dispose;
    window.addEventListener('portfolio:navigate', dispose, { once: true });
  };

  initializeHome();
  document.addEventListener('astro:page-load', initializeHome);
  window.addEventListener('portfolio:home-replay', () => {
    const smoother = ScrollSmoother.get();
    if (smoother) smoother.scrollTo(0, true);
    else window.scrollTo({ top: 0, behavior: 'smooth' });
    initializeHome();
  });
</script>
