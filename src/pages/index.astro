              <header class="panel-head">
                <h2 id="research-title">Research</h2>
              </header>

              <div class="research-item">
                <h3>{research.data.title}</h3>
                <p>{research.data.tagline}</p>
                {research.data.url && (
                  <a class="research-link" href={research.data.url} target="_blank" rel="noreferrer">
