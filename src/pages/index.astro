<script>
  let cleanupHome: (() => void) | undefined;

  const initializeHome = () => {
    cleanupHome?.();
    cleanupHome = undefined;

    const home = document.querySelector<HTMLElement>('.express-home');
    if (!home) return;

    const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
    const contactOpen = document.querySelector<HTMLAnchorElement>('[data-contact-choice-open]');
    const contactDialog = document.querySelector<HTMLDialogElement>('[data-contact-choice-dialog]');
    const contactDialogClose = contactDialog?.querySelectorAll<HTMLButtonElement>('[data-contact-dialog-close]') ?? [];
    const contactChoiceStep = contactDialog?.querySelector<HTMLElement>('[data-contact-choice-step]');
    const contactMessageStep = contactForm?.querySelector<HTMLElement>('[data-contact-message-step]');
    const contactMessageOpen = contactDialog?.querySelector<HTMLButtonElement>('[data-contact-message-open]');
    const contactCall = contactDialog?.querySelector<HTMLAnchorElement>('[data-contact-call]');
    const contactSubmit = contactForm?.querySelector<HTMLButtonElement>('[data-contact-submit]');
    const contactSubmitLabel = contactForm?.querySelector<HTMLElement>('[data-contact-submit-label]');
    const contactDialogStatus = contactForm?.querySelector<HTMLElement>('[data-contact-dialog-status]');
    const contactFallback = contactForm?.querySelector<HTMLAnchorElement>('[data-contact-fallback]');
    const contactMessage = contactForm?.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
    let contactFormPending = false;

    const clearContactFeedback = () => {
      if (contactDialogStatus) {
        contactDialogStatus.textContent = '';
        contactDialogStatus.dataset.state = '';
      }
      if (contactFallback) contactFallback.hidden = true;
    };

    const showContactStep = (step: 'choice' | 'message') => {
      if (contactChoiceStep) contactChoiceStep.hidden = step !== 'choice';
      if (contactForm) contactForm.hidden = step === 'choice';
      if (contactMessageStep) contactMessageStep.hidden = step !== 'message';
      clearContactFeedback();

      window.requestAnimationFrame(() => {
        if (step === 'message') contactMessage?.focus();
      });
    };

    const handleContactOpen = (event: MouseEvent) => {
      event.preventDefault();
      if (!contactDialog) return;
      showContactStep('choice');
      contactDialog.showModal();
    };

    const handleMessageOpen = () => showContactStep('message');

    const handleMessageInput = () => {
      contactMessage?.setCustomValidity('');
    };

    const handleDialogClose = () => {
      if (!contactFormPending) contactDialog?.close();
    };

    const handleDialogBackdrop = (event: MouseEvent) => {
      if (event.target === contactDialog) handleDialogClose();
    };

    const handleContactCall = () => contactDialog?.close();

    const handleContactSubmit = async (event: SubmitEvent) => {
      event.preventDefault();
      if (!contactForm || !contactSubmit || contactFormPending || !contactForm.reportValidity()) return;

      contactFormPending = true;
      contactSubmit.disabled = true;
      contactSubmit.setAttribute('aria-busy', 'true');
      if (contactSubmitLabel) contactSubmitLabel.textContent = 'Submitting…';
      clearContactFeedback();
      contactForm.querySelectorAll<HTMLElement>('[aria-invalid="true"]').forEach((field) => field.removeAttribute('aria-invalid'));

      const formData = new FormData(contactForm);
      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: formData.get('email'),
            whatsapp: '',
            message: formData.get('message'),
            company: formData.get('company'),
          }),
        });
        const result = await response.json() as { ok?: boolean; message?: string; errors?: Record<string, string> };
        if (!response.ok || !result.ok) {
          if (result.errors) {
            Object.keys(result.errors).forEach((name) => {
              const field = contactForm.elements.namedItem(name);
              if (field instanceof HTMLElement) field.setAttribute('aria-invalid', 'true');
            });
          }
          throw new Error(result.message || 'Your message could not be sent right now.');
        }

        contactForm.reset();
        if (contactDialogStatus) {
          contactDialogStatus.textContent = result.message || 'Message sent — I’ll get back to you soon.';
          contactDialogStatus.dataset.state = 'success';
        }
      } catch (error) {
        if (contactDialogStatus) {
          contactDialogStatus.textContent = error instanceof Error ? error.message : 'Your message could not be sent right now.';
          contactDialogStatus.dataset.state = 'error';
        }
        if (contactFallback) contactFallback.hidden = false;
      } finally {
        contactFormPending = false;
        contactSubmit.disabled = false;
        contactSubmit.removeAttribute('aria-busy');
        if (contactSubmitLabel) contactSubmitLabel.innerHTML = 'Submit <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>';
      }
    };
    contactOpen?.addEventListener('click', handleContactOpen);
    contactMessageOpen?.addEventListener('click', handleMessageOpen);
    contactCall?.addEventListener('click', handleContactCall);
    contactMessage?.addEventListener('input', handleMessageInput);
    contactDialogClose.forEach((button) => button.addEventListener('click', handleDialogClose));
    contactDialog?.addEventListener('click', handleDialogBackdrop);
    contactForm?.addEventListener('submit', handleContactSubmit);

    const heroWordmark = home.querySelector<HTMLElement>('.hero-wordmark');
    const rioFloat = document.querySelector<HTMLElement>('[data-scroll-rio]');
    const handleHeroClick = (event: MouseEvent) => {
      if (!(event.target instanceof Element)) return;
      if (event.target.closest('a, button, dialog')) return;
      if (window.getSelection()?.toString()) return;
      if (!contactDialog || contactDialog.open) return;
      event.preventDefault();
      showContactStep('choice');
      contactDialog.showModal();
    };
    heroWordmark?.addEventListener('click', handleHeroClick);
    const handleRioClick = (event: MouseEvent) => {
      // At the page end the rio becomes a "back to hero" control.
      if (rioFloat?.dataset.mode === 'home') {
        event.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
        return;
      }
      handleHeroClick(event);
    };
    rioFloat?.addEventListener('click', handleRioClick);

    const expToggles = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-exp-toggle]'));
    const handleExpToggle = (event: Event) => {
      const toggle = event.currentTarget;
      if (!(toggle instanceof HTMLButtonElement)) return;
      const panel = document.getElementById(toggle.getAttribute('aria-controls') ?? '');
      if (!panel) return;
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      panel.setAttribute('aria-hidden', String(open));
    };
    expToggles.forEach((toggle) => toggle.addEventListener('click', handleExpToggle));

    const dispose = () => {
      expToggles.forEach((toggle) => toggle.removeEventListener('click', handleExpToggle));
      contactOpen?.removeEventListener('click', handleContactOpen);
      contactMessageOpen?.removeEventListener('click', handleMessageOpen);
      contactCall?.removeEventListener('click', handleContactCall);
      contactMessage?.removeEventListener('input', handleMessageInput);
      contactDialogClose.forEach((button) => button.removeEventListener('click', handleDialogClose));
      contactDialog?.removeEventListener('click', handleDialogBackdrop);
      contactForm?.removeEventListener('submit', handleContactSubmit);
      heroWordmark?.removeEventListener('click', handleHeroClick);
      rioFloat?.removeEventListener('click', handleRioClick);
    };
    cleanupHome = dispose;
  };

  initializeHome();
  document.addEventListener('astro:page-load', initializeHome);
  window.addEventListener('portfolio:home-replay', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
    initializeHome();
  });

  // Hero scroll cue: glide to projects, respecting reduced motion.
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const cue = event.target.closest<HTMLElement>('[data-scroll-cue]');
    if (!cue) return;
    event.preventDefault();
    const target = document.querySelector<HTMLElement>('#projects');
    if (!target) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
  });

  // Fade the cue away once the page moves, and bring it back at the top.
  // Geometry-based (IntersectionObserver) rather than scroll math so it stays
  // correct on restore/back-forward and after client-side navigation, with a
  // passive scroll check as a second trigger for browsers that delay the observer.
  let cueObserver: IntersectionObserver | undefined;
  let cueScroll: (() => void) | undefined;
  const initHeroCue = () => {
    cueObserver?.disconnect();
    cueObserver = undefined;
    if (cueScroll) window.removeEventListener('scroll', cueScroll);
    cueScroll = undefined;
    const cue = document.querySelector<HTMLElement>('[data-scroll-cue]');
    const sentinel = document.querySelector<HTMLElement>('[data-hero-top]');
    if (!cue || !sentinel) return;
    const apply = () => {
      const passed = sentinel.getBoundingClientRect().bottom <= 0;
      cue.classList.toggle('is-hidden', passed);
    };
    cue.classList.remove('is-hidden');
    if ('IntersectionObserver' in window) {
      cueObserver = new IntersectionObserver(([entry]) => {
        cue.classList.toggle('is-hidden', !entry.isIntersecting);
      }, { threshold: 0 });
      cueObserver.observe(sentinel);
    }
    cueScroll = apply;
    window.addEventListener('scroll', apply, { passive: true });
    apply();
  };
  document.addEventListener('astro:page-load', initHeroCue);
  initHeroCue();
</script>

<script is:inline>
  (() => {
    const fanSelector = '[data-project-fan]';
    const cardSelector = '[data-fan-card]';
    let front = 0;
    let dragging = false;
    let moved = false;
    let startX = 0;
    let startY = 0;

    const getFan = () => document.querySelector(fanSelector);
    const getCards = (fan) => (fan ? Array.from(fan.querySelectorAll(cardSelector)) : []);
    const posOf = (index, count) => {
      const offset = (((index - front) % count) + count) % count;
      if (offset === 0) return 'front';
      return offset <= Math.floor(count / 2) ? 'right' : 'left';
    };

    const paint = () => {
      const fan = getFan();
      const cards = getCards(fan);
      if (!fan || !cards.length) return;
      front = ((front % cards.length) + cards.length) % cards.length;
      cards.forEach((card, index) => card.setAttribute('data-fan-pos', posOf(index, cards.length)));
    };

    const rotate = (direction) => {
      const cards = getCards(getFan());
      if (!cards.length) return;
      front = (((front + direction) % cards.length) + cards.length) % cards.length;
      paint();
    };

    document.addEventListener('click', (event) => {
      if (moved) {
        moved = false;
        event.preventDefault();
        event.stopPropagation();
        return;
      }
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;
      const card = target.closest(cardSelector);
      if (!card) return;
      const cards = getCards(getFan());
      const index = cards.indexOf(card);
      if (index === -1 || index === front) return;
      event.preventDefault();
      event.stopPropagation();
      front = index;
      paint();
    }, true);

    document.addEventListener('pointerdown', (event) => {
      const fan = event.target instanceof Element ? event.target.closest(fanSelector) : null;
      if (!fan || (event.pointerType === 'mouse' && event.button !== 0)) return;
      dragging = true;
      moved = false;
      startX = event.clientX;
      startY = event.clientY;
    });

    document.addEventListener('pointermove', (event) => {
      if (!dragging || moved) return;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      if (Math.abs(dy) > Math.abs(dx) || Math.abs(dx) <= 10) return;
      moved = true;
      event.preventDefault();
    }, { passive: false });

    const endDrag = (event) => {
      if (!dragging) return;
      dragging = false;
      if (!moved || !(event instanceof PointerEvent)) {
        moved = false;
        return;
      }
      const dx = event.clientX - startX;
      if (Math.abs(dx) > 40) rotate(dx < 0 ? 1 : -1);
      else moved = false;
    };
    document.addEventListener('pointerup', endDrag);
    document.addEventListener('pointercancel', () => {
      dragging = false;
      moved = false;
    });

    document.addEventListener('dragstart', (event) => {
      const target = event.target instanceof Element ? event.target.closest(fanSelector) : null;
      if (target) event.preventDefault();
    });

    paint();
  })();
</script>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import {
    buildMembraneShape,
    measureMembraneContact,
    membraneMotion,
  } from '../lib/liquid-membrane';

  gsap.registerPlugin(ScrollTrigger);

  let scrollRioMedia: ReturnType<typeof gsap.matchMedia> | undefined;
  let circleEntranceTween: gsap.core.Timeline | undefined;
  let circleEntranceTarget: HTMLElement | null = null;

  // The circle arrives like a settling drop of water: a soft squash that
  // overshoots once and relaxes back to a perfect disc.
  const initHeroCircleEntrance = () => {
    const jelly = document.querySelector<HTMLElement>('[data-hero-circle-jelly]');
    if (!jelly || jelly === circleEntranceTarget) return;
    circleEntranceTarget = jelly;
    circleEntranceTween?.kill();
    circleEntranceTween = undefined;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      gsap.set(jelly, { clearProps: 'all' });
      return;
    }

    circleEntranceTween = gsap.timeline()
      .fromTo(jelly,
        { scaleX: 0.92, scaleY: 0.96, autoAlpha: 0.55 },
        { scaleX: 1.015, scaleY: 0.99, autoAlpha: 1, duration: 0.6, ease: 'power2.out' },
      )
      .to(jelly, { scaleX: 0.996, scaleY: 1.004, duration: 0.42, ease: 'sine.inOut' })
      .to(jelly, { scaleX: 1, scaleY: 1, duration: 0.52, ease: 'power2.out' });
  };

  // Adopt the hero's real 3D wordmark into a fixed layer so it can shrink and travel,
  // leaving a ghost box behind that keeps the hero layout exactly as it was.
  const adoptHeroWordmark = () => {
    const layer = document.querySelector<HTMLElement>('[data-scroll-rio]');
    const heroMark = document.querySelector<HTMLElement>('.hero-core > .hero-wordmark');
    if (!layer || !heroMark) return null;

    let shell = layer.querySelector<HTMLElement>('.hero-wordmark');
    if (!shell) {
      shell = document.createElement('div');
      shell.className = 'hero-wordmark scroll-rio-wordmark';
      layer.append(shell);
    }

    const heroH1 = shell.querySelector<HTMLElement>('h1.hero-ztext:not(.scroll-rio-up)') ?? heroMark.querySelector<HTMLElement>('h1.hero-ztext:not(.scroll-rio-up)');
    if (!heroH1) return null;

    let ghost = heroMark.querySelector<HTMLElement>('.hero-wordmark-ghost');
    if (!shell.contains(heroH1)) {
      if (!ghost) {
        ghost = document.createElement('div');
        ghost.className = 'hero-wordmark-ghost';
        ghost.setAttribute('aria-hidden', 'true');
        heroMark.append(ghost);
      }
      shell.append(heroH1);
    }
    if (!ghost) return null;

    // Second 3D wordmark that reads "up." — shown at the page end as the return control.
    let upH1 = shell.querySelector<HTMLElement>('.scroll-rio-up');
    if (!upH1) {
      upH1 = document.createElement('h1');
      upH1.className = 'hero-ztext scroll-rio-up';
      upH1.id = 'rio-up-wordmark';
      upH1.setAttribute('aria-hidden', 'true');
      upH1.innerHTML = '<span class="scroll-rio-arrow"><i class="ph-bold ph-arrow-up"></i></span>';
      shell.append(upH1);
    }
    const Ztextify = (window as Window & {
      Ztextify?: new (selector: string, options: Record<string, string | number | boolean>) => unknown;
    }).Ztextify;
    if (Ztextify && !upH1.querySelector('.z-text')) {
      // Same interactive config as the hero wordmark so the arrow's 3D layers
      // tilt with the pointer too.
      new Ztextify('#rio-up-wordmark.hero-ztext', {
        depth: '.18em',
        direction: 'both',
        event: 'pointer',
        eventRotation: '45deg',
        fade: false,
        layers: 12,
        perspective: '700px',
      });
    }
    // Pin the copy to the travelling origin. This must run after Ztextify, which
    // stamps position:relative inline on its target and would otherwise win.
    upH1.style.position = 'absolute';
    upH1.style.top = '0';
    upH1.style.left = '0';

    const syncGhost = () => {
      ghost.style.width = `${heroH1.offsetWidth}px`;
      ghost.style.height = `${heroH1.offsetHeight}px`;
    };
    syncGhost();

    return { layer, shell, heroH1, upH1, ghost, syncGhost };
  };

  // A "decoding" scramble for the bottom control. The sequence is derived from
  // timeline progress (not Math.random) so reversing the scroll retraces the
  // exact same glyphs back into "rio".
  const SCRAMBLE_GLYPHS = Array.from('◇◆◈◉◊○●◍◎◐◑◒◓⌁⌆⌇⍟⟡⟢⟣⟤✦✧✶✷✸✺❖☰☱☲☳☴☵☶☷');
  const SCRAMBLE_STEPS = 6;
  const SCRAMBLE_SHOW_ARROW = 0.76;
  const scrambleHash = (value: number) => {
    const raw = Math.sin(value * 127.1 + 311.7) * 43758.5453;
    return raw - Math.floor(raw);
  };
  const scrambleWord = (step: number) => {
    const pick = Math.floor(scrambleHash(step * 17 + 7) * SCRAMBLE_GLYPHS.length);
    return SCRAMBLE_GLYPHS[pick];
  };

  const initScrollRio = () => {
    scrollRioMedia?.revert();
    scrollRioMedia = gsap.matchMedia();

    scrollRioMedia.add('(min-width: 1280px) and (prefers-reduced-motion: no-preference)', () => {
      const adopted = adoptHeroWordmark();
      if (!adopted) return;

      const { layer, shell, heroH1, upH1, ghost, syncGhost } = adopted;
      const heroMark = document.querySelector<HTMLElement>('.hero-core > .hero-wordmark');
      const hero = document.querySelector<HTMLElement>('#home');
      const flow = document.querySelector<HTMLElement>('.home-flow');
      const page = document.querySelector<HTMLElement>('.express-home');
      if (!heroMark || !hero || !page) return;

      // Rendered width of the travelling rio, scaled to the window so it reads the same everywhere.
      const targetWidth = () => Math.max(72, Math.min(120, window.innerWidth * 0.065));

      // Everything the guide needs to stay in the gutter beside the content column.
      // The width is capped to the available gutter so it can never sit over the
      // projects (or any other) section on narrower desktop windows.
      const layout = () => {
        const vw = window.innerWidth;
        const flowRect = flow?.getBoundingClientRect();
        const contentLeft = flowRect ? flowRect.left : Math.max(0, (vw - Math.min(vw - 64, 1080)) / 2);
        const gap = Math.max(16, Math.min(28, vw * 0.014));
        const available = Math.max(48, contentLeft - gap * 2);
        return { contentLeft, gap, width: Math.min(targetWidth(), available) };
      };
      const scaleFor = () => Math.min(1, layout().width / (heroH1.offsetWidth || 1));

      const gutterTargets = () => {
        const { contentLeft, gap, width } = layout();
        const height = (heroH1.offsetHeight / (heroH1.offsetWidth || 1)) * width;
        return {
          left: Math.max(gap, contentLeft - width - gap),
          y: (window.innerHeight - height) / 2,
        };
      };

      const setPointer = (enabled: boolean) => {
        layer.style.pointerEvents = enabled ? 'auto' : 'none';
      };

      // The wordmark is interactive at the hero (contact dialog) and again at the
      // very bottom (return to hero), so both phases feed one shared state.
      let atHero = true;
      let atBottom = false;
      const syncPointer = () => {
        setPointer(atHero || atBottom);
        layer.dataset.mode = atBottom ? 'home' : 'guide';
      };

      // The hero holds for a short beat while the wordmark crosses the rim,
      // then returns to normal document flow. A short scrub keeps the glide
      // smooth without lagging the wordmark far enough to take a different
      // route back into the circle.
      const INTRO_SCROLL = 1.3;
      const INTRO_EASE = 'expo.out';
      const INTRO_SCRUB = 1.2;
      const HERO_HOLD = 0.35;

      const topY = () => Math.max(72, window.innerHeight * 0.09);

      // Measure the ghost relative to the hero rather than in page coordinates.
      // Both boxes move together as the page scrolls, so the anchor stays
      // stable even when a refresh happens mid-transition.
      const heroAnchor = () => {
        const heroRect = hero.getBoundingClientRect();
        const ghostRect = ghost.getBoundingClientRect();
        return { left: ghostRect.left - heroRect.left, top: ghostRect.top - heroRect.top };
      };

      gsap.set([heroH1, upH1], { transformOrigin: 'left top' });
      gsap.set([heroH1, upH1], { x: () => heroAnchor().left, y: () => heroAnchor().top, scale: 1 });
      gsap.set(shell, { x: 0, y: 0 });
      gsap.set(upH1, { autoAlpha: 0 });
      syncPointer();

      // Live viewport bounds keep the contact correct as the circle scrolls
      // and the rio travels away from it.
      const circleBounds = () => {
        const circle = hero.querySelector<HTMLElement>('.hero-circle');
        if (!circle) return null;
        const rect = circle.getBoundingClientRect();
        return {
          x: rect.left + rect.width / 2,
          y: rect.top + rect.height / 2,
          radius: rect.width / 2,
        };
      };

      // Measure the visible text itself, not the h1, so its 3D layers do not
      // inflate the contact box.
      const textBox = () => {
        const text = heroH1.querySelector<HTMLElement>('.z-text') ?? heroH1;
        return text.getBoundingClientRect();
      };

      const membrane = hero.querySelector<HTMLElement>('[data-hero-membrane]');
      const membraneClip = membrane?.querySelector<SVGPathElement>('[data-hero-membrane-clip]');
      let lastMembraneClip = membraneClip?.getAttribute('d') ?? '';

      // Each rim crossing starts a slow ripple anchored at that crossing.
      const ripple = { amplitude: 0, phase: 0, angle: 0 };
      let rippleTween: gsap.core.Timeline | undefined;
      let wasOutside = false;
      let hasMeasured = false;

      const startRipple = (angle: number) => {
        rippleTween?.kill();
        ripple.amplitude = 0;
        ripple.phase = 0;
        ripple.angle = angle;
        // One complete wave in ~1.2s, so it finishes while the glass is still
        // on screen. The short hero hold gives it a stage.
        rippleTween = gsap.timeline({
          onUpdate: paintMembrane,
          onComplete: () => {
            ripple.amplitude = 0;
            paintMembrane();
          },
        })
          .to(ripple, { amplitude: 0.64, phase: 2.4, duration: 0.25, ease: 'power2.out' })
          .to(ripple, { amplitude: 0.36, phase: 5.4, duration: 0.65, ease: 'power1.out' })
          .to(ripple, { amplitude: 0, phase: 6.4, duration: 0.3, ease: 'sine.inOut' });
      };

      const stopRipple = () => {
        rippleTween?.kill();
        rippleTween = undefined;
        ripple.amplitude = 0;
        ripple.phase = 0;
        ripple.angle = 0;
      };

      // The intro tween covers the first 130% of the hero. Its scroll progress
      // is the same source that moves the wordmark; contact geometry decides
      // exactly when the surface builds and lets go.
      const guideProgress = () => {
        const end = window.innerHeight * INTRO_SCROLL;
        return end > 0 ? gsap.utils.clamp(0, 1, window.scrollY / end) : 0;
      };

      const paintMembrane = () => {
        if (!membrane || !membraneClip) return;
        const anchor = circleBounds();
        if (!anchor) return;

        const box = textBox();
        const contact = measureMembraneContact(
          {
            left: box.left,
            top: box.top,
            right: box.right,
            bottom: box.bottom,
          },
          { x: anchor.x, y: anchor.y, radius: anchor.radius },
        );

        const outside = contact.clearance > 0.02;
        if (!hasMeasured) {
          hasMeasured = true;
          wasOutside = outside;
        }
        if (outside && !wasOutside) {
          wasOutside = true;
          startRipple(contact.angle);
        } else if (!outside && contact.clearance < -0.02 && wasOutside) {
          wasOutside = false;
          startRipple(contact.angle);
        }

        const motion = membraneMotion(contact, guideProgress(), ripple);
        const shape = buildMembraneShape(motion, 144);

        if (shape.clip !== lastMembraneClip) {
          lastMembraneClip = shape.clip;
          membraneClip.setAttribute('d', shape.clip);
        }
      };

      const resetMembrane = () => {
        const rest = buildMembraneShape(null, 144);
        membraneClip?.setAttribute('d', rest.clip);
        lastMembraneClip = rest.clip;
      };

      const bubbleTrigger = ScrollTrigger.create({
        trigger: hero,
        start: 'top top',
        end: () => ScrollTrigger.maxScroll(window),
        invalidateOnRefresh: true,
        onUpdate: paintMembrane,
        onRefresh: () => {
          paintMembrane();
        },
      });

      // A short beat, not the old 1.5-screen pin: keep the glass on screen just
      // long enough for the crossing and the first ripple to read.
      const heroHoldTrigger = ScrollTrigger.create({
        trigger: hero,
        start: 'top top',
        end: () => `+=${window.innerHeight * HERO_HOLD}`,
        pin: true,
        pinSpacing: true,
        anticipatePin: 1,
        invalidateOnRefresh: true,
      });

      // 1. Shrink out of the hero and settle into the left gutter. The hero
      //    flows normally after the short hold; the post-release ripple runs
      //    on its own clock below.
      const intro = gsap.fromTo([heroH1, upH1],
        {
          x: () => heroAnchor().left,
          y: () => heroAnchor().top,
          scale: 1,
        },
        {
          x: () => gutterTargets().left,
          y: () => gutterTargets().y,
          scale: scaleFor,
          ease: INTRO_EASE,
          immediateRender: true,
          onUpdate: paintMembrane,
          scrollTrigger: {
            trigger: page,
            start: 'top top',
            end: () => `+=${window.innerHeight * INTRO_SCROLL}`,
            scrub: INTRO_SCRUB,
            invalidateOnRefresh: true,
            onUpdate: (self) => {
              atHero = self.progress < 0.04;
              syncPointer();
            },
            onLeaveBack: () => {
              atHero = true;
              syncPointer();
            },
            onLeave: () => {
              atHero = false;
              syncPointer();
            },
          },
        },
      );

      // 2. At the very bottom, lift the rio to the top edge as a "back to hero" control.
      //    Runs on the shell so it composes with the hero tween's y instead of fighting it.
      gsap.fromTo(shell,
        { y: 0 },
        {
          y: () => topY() - gutterTargets().y,
          ease: 'power2.inOut',
          immediateRender: false,
          scrollTrigger: {
            start: () => ScrollTrigger.maxScroll(window) - window.innerHeight * 0.18,
            end: () => ScrollTrigger.maxScroll(window),
            scrub: 1.2,
            invalidateOnRefresh: true,
            onUpdate: (self) => {
              const bottom = self.progress > 0.9;
              if (bottom && !atBottom) wipe.play(0);
              else if (!bottom && atBottom) wipe.reverse();
              atBottom = bottom;
              syncPointer();
              paintMembrane();
            },
            onLeave: () => {
              if (!atBottom) wipe.play(0);
              atBottom = true;
              syncPointer();
              paintMembrane();
            },
            onLeaveBack: () => {
              if (atBottom) wipe.reverse();
              atBottom = false;
              syncPointer();
              paintMembrane();
            },
          },
        },
      );

      // 3. Hieroglyphic scramble at the very bottom: the 3D rio decodes through
      //    random symbols, then hard-cuts to the 3D up arrow. Playing the
      //    timeline in reverse retraces the same glyphs back into "rio".
      const RIO_WORD = 'rio';
      let rioLayers: HTMLElement[] = [];
      let rioTemplate = '';
      let scrambleActive = false;
      let arrowShown = false;
      let lastScrambleStep = -1;
      const scrambleState = { progress: 0 };

      const ensureRioLayers = () => {
        if (rioLayers.length) return rioLayers;
        rioLayers = Array.from(heroH1.querySelectorAll<HTMLElement>('.z-layer'));
        rioTemplate = rioLayers[0]?.innerHTML ?? '';
        return rioLayers;
      };

      const setRioGlyphs = (word: string) => {
        const layers = ensureRioLayers();
        if (layers.length) {
          const markup = `<span class="rio-letters scramble-glyphs">${word}</span>`;
          layers.forEach((layer) => {
            layer.innerHTML = markup;
          });
          return;
        }
        const span = heroH1.querySelector<HTMLElement>('.rio-letters');
        if (span) span.textContent = word;
      };

      const restoreRioContent = () => {
        const layers = ensureRioLayers();
        if (layers.length && rioTemplate) {
          layers.forEach((layer) => {
            layer.innerHTML = rioTemplate;
          });
          return;
        }
        const span = heroH1.querySelector<HTMLElement>('.rio-letters');
        if (span) span.textContent = RIO_WORD;
      };

      const restoreRio = () => {
        restoreRioContent();
        scrambleActive = false;
        arrowShown = false;
        lastScrambleStep = -1;
        heroH1.removeAttribute('aria-hidden');
        gsap.set(upH1, { autoAlpha: 0 });
        gsap.set(heroH1, { autoAlpha: 1 });
      };

      const showArrow = () => {
        if (arrowShown) return;
        arrowShown = true;
        gsap.set(heroH1, { autoAlpha: 0 });
        gsap.set(upH1, { autoAlpha: 1 });
      };

      const showRio = () => {
        if (!arrowShown) return;
        arrowShown = false;
        gsap.set(upH1, { autoAlpha: 0 });
        gsap.set(heroH1, { autoAlpha: 1 });
      };

      const applyScramble = () => {
        const progress = scrambleState.progress;
        if (progress <= 0) {
          if (scrambleActive || arrowShown) restoreRio();
          return;
        }

        if (!scrambleActive) {
          scrambleActive = true;
          heroH1.setAttribute('aria-hidden', 'true');
        }

        if (progress >= SCRAMBLE_SHOW_ARROW) {
          showArrow();
          return;
        }

        showRio();
        const step = Math.floor(progress * SCRAMBLE_STEPS) + 1;
        if (step !== lastScrambleStep) {
          lastScrambleStep = step;
          setRioGlyphs(scrambleWord(step));
        }
      };

      const wipe = gsap.timeline({ paused: true, onUpdate: applyScramble })
        .to(scrambleState, { progress: 1, duration: 0.2, ease: 'none' });

      // Re-measure the hero box before any refresh (resize, orientation, font load),
      // then refresh so the guide's function-based x/y/scale are re-evaluated.
      const invalidateGuide = () => {
        syncGhost();
        intro.invalidate();
      };
      const onRefreshInit = () => {
        invalidateGuide();
      };
      ScrollTrigger.addEventListener('refreshInit', onRefreshInit);
      paintMembrane();

      const onResize = () => {
        invalidateGuide();
        ScrollTrigger.refresh();
      };
      window.addEventListener('resize', onResize);
      window.addEventListener('orientationchange', onResize);

      // The wordmark font can arrive after the first measurement. Re-sync the ghost
      // hero box and guide anchors once fonts are ready so nothing shifts.
      const refreshForFonts = () => {
        document.fonts?.ready.then(() => {
          if (!layer.contains(heroH1)) return;
          syncGhost();
          intro.invalidate();
          ScrollTrigger.refresh();
        });
      };
      refreshForFonts();

      return () => {
        window.removeEventListener('resize', onResize);
        window.removeEventListener('orientationchange', onResize);
        ScrollTrigger.removeEventListener('refreshInit', onRefreshInit);
        intro.scrollTrigger?.kill();
        bubbleTrigger.kill();
        heroHoldTrigger.kill();
        wipe.kill();
        restoreRio();
        stopRipple();
        resetMembrane();
        const circleJelly = hero.querySelector<HTMLElement>('[data-hero-circle-jelly]');
        if (circleJelly) {
          gsap.killTweensOf(circleJelly);
          gsap.set(circleJelly, { clearProps: 'all' });
        }
        // Hand the wordmark back to the hero when this layout no longer applies.
        if (layer.contains(heroH1)) {
          gsap.set(heroH1, { clearProps: 'transform' });
          gsap.set(shell, { clearProps: 'transform' });
          gsap.set(upH1, { clearProps: 'transform' });
          gsap.set(upH1, { autoAlpha: 0 });
          ghost.remove();
          heroMark.append(heroH1);
        }
        setPointer(true);
      };
    });
  };

  document.addEventListener('astro:page-load', initScrollRio);
  initScrollRio();
  document.addEventListener('astro:page-load', initHeroCircleEntrance);
  initHeroCircleEntrance();
</script>
