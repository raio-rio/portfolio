        <span class="hero-orb hero-orb-a"></span>
        <span class="hero-orb hero-orb-c"></span>
      </div>
      <div class="hero-circle" aria-hidden="true">
        <div class="hero-membrane" data-hero-circle-jelly data-hero-membrane style={`--membrane-pad: ${MEMBRANE_BOX_PAD * 100}%`}>
          <div class="hero-circle-jelly">
            <span class="glass-grain" aria-hidden="true"></span>
            <span class="glass-sweep" aria-hidden="true"></span>
          </div>
          <svg class="hero-membrane-rim" viewBox="0 0 1000 1000" aria-hidden="true" focusable="false">
            <defs>
              <clipPath id="hero-membrane-clip" clipPathUnits="objectBoundingBox">
                <path data-hero-membrane-clip d={membraneRest.clip}></path>
              </clipPath>
            </defs>
          </svg>
        </div>
      </div>
      <div class="express-hero-surface">
      <div class="hero-center">
        <div class="hero-orbit">
          <div class="hero-core">
            <div class="hero-wordmark" aria-label="Rio Espinosa">
