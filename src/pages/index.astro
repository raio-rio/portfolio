          <a class="home-section-link" href="/ESPINOSA_RESUME.pdf" target="_blank" rel="noreferrer">resume<i class="ph-bold ph-arrow-right" aria-hidden="true"></i></a>
        </header>

        <ol class="exp-list">
          {experience.map((item, index) => (
            <li>
              <button class="exp-row" type="button" data-exp-modal-trigger aria-controls={`exp-modal-${index}`} aria-haspopup="dialog" aria-label={`View details for ${item.role} at ${item.company}`}>
                <span class="exp-row-year">{item.year}</span>
                <span class="exp-row-role">{item.role}</span>
                <span class="exp-row-company">{item.company}</span>
                <span class="exp-row-open" aria-hidden="true"><i class="ph-bold ph-arrow-up-right"></i></span>
              </button>
              <dialog class="project-modal split-modal" id={`exp-modal-${index}`} data-exp-modal aria-labelledby={`exp-modal-${index}-title`}>
                <article class="project-modal-content split-modal-content">
                  <button class="project-modal-close" type="button" data-exp-modal-close aria-label={`Close ${item.role} details`}>×</button>
