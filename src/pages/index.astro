---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import { experience } from '../data/experience';
import { awards } from '../data/awards';
import { stackIcon } from '../lib/stack-icons';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const promorph = projects.find((project) => project.id === 'promorph');
const featuredProjects = [
  ...(promorph ? [promorph] : []),
  ...projects.filter((project) => project.id !== 'promorph').slice(0, 2),
];
const research = projects.find((project) => project.id === 'promorph');
const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);
const featurePost = recentPosts.find((post) => post.id === 'dashboard-from-a-drawer-phone') ?? recentPosts[0];
const sidePosts = featurePost ? recentPosts.filter((post) => post.id !== featurePost.id).slice(0, 2) : [];
const homePosts = [...(featurePost ? [featurePost] : []), ...sidePosts];

// The important stacks only — 22 logos, duplicated under the hood for a neat loop.
const featuredStack: string[] = [
  'TypeScript',
  'React',
  'Next.js',
  'JavaScript',
  'Tailwind CSS',
  'Vue.js',
  'Node.js',
  'Python',
  'PostgreSQL',
  'MongoDB',
  'GraphQL',
  'FastAPI',
  'AWS',
  'Docker',
  'Kubernetes',
  'GCP',
  'GitHub Actions',
  'PyTorch',
  'TensorFlow',
  'Jupyter',
  'Claude Code',
  'OpenAI',
];
const awardRows = awards.map((award) => ({
  year: award.meta.split('·').pop()?.trim() ?? '',
  title: award.title,
  name: award.name,
}));
---

<Layout title="Rio - Full Stack Developer" description="Rio Espinosa builds AI/ML models, SaaS products, full-stack web apps, and blockchain solutions.">
  <div id="smooth-wrapper">
    <main id="smooth-content" class="express-home" aria-label="Rio Espinosa portfolio">
    <section class="express-hero" id="home" data-scroll-section="home">
      <div class="express-hero-surface">
      <div class="hero-center">
        <div class="hero-orbit">
          <div class="hero-core">
            <div class="hero-wordmark" aria-label="Rio Espinosa">
              <p class="hero-kicker">hi! it’s</p>
              <h1 class="hero-ztext"><span class="rio-letters">rio</span><span class="hero-wordmark-dot" aria-hidden="true">.</span></h1>
            </div>
            <p class="hero-tagline">a Full Stack Developer/AI Enthusiast</p>
            <nav class="hero-actions" aria-label="Social links">
              <a href="https://wa.me/639338259751?text=Hi%20Rio%2C%20found%20your%20portfolio%20and%20would%20love%20to%20chat!" target="_blank" rel="noreferrer" aria-label="Message Rio on WhatsApp" data-label="WhatsApp"><i class="ph-bold ph-whatsapp-logo" aria-hidden="true"></i></a>
              <a href="https://www.linkedin.com/in/rioespinosa02/" target="_blank" rel="noreferrer" aria-label="Visit Rio on LinkedIn" data-label="LinkedIn"><i class="ph-bold ph-linkedin-logo" aria-hidden="true"></i></a>
              <a href="https://www.instagram.com/_sprio/" target="_blank" rel="noreferrer" aria-label="Visit Rio on Instagram" data-label="Instagram"><i class="ph-bold ph-instagram-logo" aria-hidden="true"></i></a>
              <a href="https://github.com/raio-rio/" target="_blank" rel="noreferrer" aria-label="Visit Rio on GitHub" data-label="GitHub"><i class="ph-bold ph-github-logo" aria-hidden="true"></i></a>
            </nav>
          </div>
        </div>
      </div>
      <dialog id="contact-choice-dialog" class="contact-email-dialog contact-choice-dialog" data-contact-choice-dialog>
        <div class="contact-email-dialog-panel">
          <button class="contact-email-dialog-close" type="button" data-contact-dialog-close aria-label="Close contact options">
            <i class="ph-bold ph-x" aria-hidden="true"></i>
          </button>

          <div class="contact-dialog-step" data-contact-choice-step>
            <h3>How would you like to connect?</h3>
            <div class="contact-choice-options">
              <a data-contact-call data-calendly-link href="https://calendly.com/programmingrio">
                <i class="ph-bold ph-calendar-check" aria-hidden="true"></i>
                <strong>Book a call</strong>
              </a>
              <button type="button" data-contact-message-open>
                <i class="ph-bold ph-paper-plane-tilt" aria-hidden="true"></i>
                <strong>Send a message</strong>
              </button>
              <a class="contact-choice-linkedin" href="https://www.linkedin.com/in/rioespinosa02/" target="_blank" rel="noreferrer">
                <i class="ph-bold ph-linkedin-logo" aria-hidden="true"></i>
                <strong>LinkedIn</strong>
              </a>
            </div>
            <p class="contact-dialog-sla"><i class="ph-bold ph-clock" aria-hidden="true"></i>Typically replies within 12 hours</p>
          </div>

          <form class="home-contact-form contact-dialog-form" data-contact-form hidden>
            <div class="contact-dialog-step" data-contact-message-step>
              <h3>What would you like to discuss?</h3>
              <div class="contact-form-fields">
                <label>
                  <span>Email</span>
                  <input type="email" name="email" autocomplete="email" inputmode="email" maxlength="254" placeholder="you@example.com" required data-contact-email />
                </label>
                <label class="contact-form-message">
                  <span>Message</span>
                  <textarea name="message" minlength="10" maxlength="5000" rows="4" placeholder="Prefer to write? Write your message here…" required></textarea>
                </label>
              </div>
              <button class="contact-form-trigger contact-form-submit" type="submit" data-contact-submit>
                <i class="ph-bold ph-paper-plane-tilt" aria-hidden="true"></i>
                <strong data-contact-submit-label>Submit <i class="ph-bold ph-arrow-right" aria-hidden="true"></i></strong>
              </button>
            </div>
            <p class="contact-dialog-status" data-contact-dialog-status role="alert" aria-live="assertive"></p>
            <a class="contact-form-fallback" data-contact-fallback href="mailto:contact@rioespinosa.com" hidden>Email me directly</a>

            <label class="contact-form-honeypot" aria-hidden="true">
              <span>Company</span>
              <input type="text" name="company" tabindex="-1" autocomplete="off" />
            </label>
          </form>
        </div>
      </dialog>
      </div>
    </section>

    <div class="home-flow">
      <section class="home-section home-section-projects" id="projects" data-scroll-section="projects" aria-labelledby="projects-title">
        <header class="home-section-head">
          <h2 id="projects-title" class="section-ztext home-section-title">projects</h2>
          <a class="home-section-link" href="/projects/">all projects<i class="ph-bold ph-arrow-right" aria-hidden="true"></i></a>
        </header>
        <div class="project-row" data-project-fan role="region" aria-label="Featured projects">
          {featuredProjects.map((project, index) => (
            <article class="row-card" data-fan-card data-fan-pos={index === 0 ? 'front' : index === 1 ? 'right' : 'left'}>
              <ProjectCard project={project} expanded showTagline={false} showType={false} hideStack />
            </article>
          ))}
        </div>
        <ol class="hero-posts" aria-label="Latest posts">
          {homePosts.map((post) => {
            const displayDate = new Intl.DateTimeFormat('en-US', {
              month: 'short',
              day: 'numeric',
              year: 'numeric',
            }).format(new Date(`${post.data.date}T12:00:00Z`));
            return (
              <li>
                <a class="hero-post-row" href={`/blog/${post.id}/`}>
                  <span class="hero-post-title">{post.data.title}</span>
                  <span class="hero-post-meta"><time datetime={post.data.date}>{displayDate}</time> · {post.data.readingTime}</span>
                </a>
              </li>
            );
          })}
        </ol>
        <div class="home-stack" role="group" aria-label="Core technology stack">
          <div class="stack-marquee">
            <ul class="stack-icons">
              {featuredStack.map((tool) => {
                const glyph = stackIcon(tool);
                return (
                  <li>
                    {glyph
                      ? <span class="stack-icon" role="img" aria-label={tool} data-label={tool}><i class={glyph} aria-hidden="true"></i></span>
                      : <span class="stack-label">{tool}</span>}
                  </li>
                );
              })}
