            <ul class="stack-icons" aria-hidden="true">
              {featuredStack.map((tool) => {
                const glyph = stackIcon(tool);
                return (
                  <li>
                    {glyph
                      ? <span class="stack-icon" aria-hidden="true"><i class={glyph} aria-hidden="true"></i></span>
                      : <span class="stack-label" aria-hidden="true">{tool}</span>}
