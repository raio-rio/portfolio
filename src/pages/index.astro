<script>
  const localTime = document.querySelector<HTMLTimeElement>('#philippines-time');
  const timeFormatter = new Intl.DateTimeFormat('en-PH', {
    timeZone: 'Asia/Manila',
    hour: 'numeric',
    minute: '2-digit',
    hour12: true,
  });

  const updateLocalTime = () => {
    if (!localTime) return;
    const now = new Date();
    localTime.textContent = timeFormatter.format(now);
    localTime.dateTime = now.toISOString();
  };

  updateLocalTime();
  window.setInterval(updateLocalTime, 30_000);

  const copyEmail = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const copyFeedback = document.querySelector<HTMLElement>('[data-copy-feedback]');
  copyEmail?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('programmingrio@gmail.com');
      if (copyFeedback) copyFeedback.textContent = 'Copied';
      window.setTimeout(() => { if (copyFeedback) copyFeedback.textContent = ''; }, 1_600);
    } catch {
      if (copyFeedback) copyFeedback.textContent = 'Copy failed';
      window.setTimeout(() => { if (copyFeedback) copyFeedback.textContent = ''; }, 1_600);
    }
  });
</script>
