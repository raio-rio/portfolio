---
import { getCollection } from 'astro:content';
import BlogPost from '../../components/BlogPost.astro';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<Layout title="Blog — Rio Espinosa" description="Writing by Rio Espinosa on technology, coding, and AI." path="/blog/">
  <main class="page-container subpage">
    <a class="back-link" href="/#blog">← Back home</a>
    <header class="subpage-intro">
      <p class="eyebrow">Writing</p>
      <h1>Blog</h1>
      <p class="stack-intro">Notes on technology, coding, and AI.</p>
    </header>
    <section class="blog-list section" aria-label="All posts">
      {posts.map((post) => <BlogPost post={post} />)}
    </section>
  </main>
</Layout>
