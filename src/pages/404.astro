---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found — Rio Espinosa"
  description="The page you're looking for doesn't exist. Head back home to see Rio Espinosa's projects, writing, and experience."
  path="/404/"
>
  <main class="project-grid-page subpage not-found">
    <p class="eyebrow">404</p>
    <h1 class="section-ztext">Lost? Let's get you back.</h1>
    <p class="case-tagline">The page you're looking for doesn't exist or moved. Here's where to go next.</p>
    <nav class="not-found-links" aria-label="Not found navigation">
      <a class="split-primary" href="/#home">Back home <i class="ph-duotone ph-arrow-right" aria-hidden="true"></i></a>
      <a class="text-link" href="/projects/">Browse projects</a>
      <a class="text-link" href="/blog/">Read the blog</a>
    </nav>
  </main>
</Layout>
