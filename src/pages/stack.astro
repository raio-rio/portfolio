---
import Layout from '../layouts/Layout.astro';
import { stack } from '../data/stack';
---

<Layout title="Tech stack — Rio Espinosa" description="Tools, frameworks, and platforms Rio Espinosa uses across frontend, backend, cloud, and AI work." path="/stack/">
  <main class="project-grid-page stack-grid-page">
    <header class="project-grid-intro">
      <h1>Stack<span>.</span></h1>
      <p>Languages, frameworks, platforms, and tools I use to take products from idea to production.</p>
    </header>
    <section class="project-grid stack-grid section" data-stack-grid aria-label="Complete technology stack">
      {stack.map(({ category, icon, tools }) => (
        <article
          class:list={['project-grid-card', 'stack-grid-card']}
        >
          <h2><i class:list={['ph-duotone', icon]} aria-hidden="true"></i>{category}</h2>
          <p class="stack-grid-preview">{tools.join(' · ')}</p>
        </article>
      ))}
    </section>
  </main>
</Layout>
