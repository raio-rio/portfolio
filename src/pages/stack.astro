---
import Layout from '../layouts/Layout.astro';

const stack = [
  { category: 'Frontend', tools: ['JavaScript', 'TypeScript', 'React', 'Next.js', 'Vue.js', 'Tailwind CSS', 'SCSS', 'Styled Components', 'Vite', 'Webpack', 'ESLint', 'Prettier'] },
  { category: 'Backend', tools: ['Node.js', 'Python', 'Java', 'PHP', 'Express.js', 'NestJS', 'FastAPI', 'Spring Boot', 'Laravel', 'PostgreSQL', 'MySQL', 'MongoDB', 'DynamoDB', 'OAuth', 'JWT', 'LDAP', 'REST', 'GraphQL', 'gRPC', 'AWS Lambda'] },
  { category: 'DevOps & Cloud', tools: ['AWS', 'GCP', 'Azure', 'GitHub Actions', 'Jenkins', 'GitLab CI', 'Terraform', 'AWS CloudFormation', 'Docker', 'Kubernetes', 'Prometheus', 'Grafana', 'Datadog'] },
  { category: 'AI & Machine Learning', tools: ['TensorFlow', 'PyTorch', 'LangChain', 'Transformers', 'OpenAI', 'Anthropic', 'Mistral', 'Hugging Face', 'LlamaIndex', 'AutoGPT', 'Claude Code', 'Codex'] },
  { category: 'Security & Identity', tools: ['AWS IAM', 'Azure AD', 'Okta', 'SAP CDC', 'Auth0', 'Cognito', 'AES', 'RSA', 'SHA', 'GDPR', 'SOC 2', 'ISO 27001'] },
  { category: 'CMS & No-Code', tools: ['WordPress', 'Strapi', 'Bubble', 'Webflow', 'Microsoft Power Platform', 'n8n'] },
  { category: 'Developer Tools', tools: ['Git', 'GitHub', 'GitLab', 'Bitbucket', 'VS Code', 'JetBrains', 'IntelliJ', 'PyCharm', 'Slack', 'Discord', 'Teams', 'JIRA', 'Trello', 'ClickUp'] },
];
---

<Layout title="Tech stack — Rio Espinosa" description="Tools, frameworks, and platforms Rio Espinosa uses across frontend, backend, cloud, and AI work." path="/stack/">
  <main class="listing">
    <a class="back-link" href="/#work">← Back home</a>
    <header class="listing-header">
      <p class="eyebrow">Tools and technologies</p>
      <h1>Tech stack</h1>
      <p class="stack-intro">The tools, frameworks, and platforms I use across the front end, back end, infrastructure, and AI.</p>
    </header>
    <section class="stack-catalog" aria-label="Complete tech stack">
      {stack.map(({ category, tools }) => (
        <article class="stack-group">
          <h2>{category}</h2>
          <ul class="stack-tools">
            {tools.map((tool) => <li>{tool}</li>)}
          </ul>
        </article>
      ))}
    </section>
  </main>
</Layout>
