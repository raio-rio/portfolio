---
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import Layout from '../../layouts/Layout.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Projects — Rio Espinosa" description="Selected software, AI, and full-stack projects by Rio Espinosa." path="/projects/">
  <main class="project-grid-page">
    <header class="project-grid-intro">
      <h1>Projects<span>.</span></h1>
      <p>A concise selection of AI, product, and full-stack work.</p>
    </header>
    <section class="project-grid section" aria-label="All projects">
      {projects.map((project) => (
        <article class="project-grid-card">
          <ProjectCard project={project} expanded />
        </article>
      ))}
    </section>
  </main>
</Layout>
